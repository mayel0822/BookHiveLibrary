@model BookHiveLibrary.Models.ApplicationUser
@{
    ViewData["Title"] = "Computer Vacancy";
    Layout = "~/Views/Shared/_UserHeaderLayout.cshtml";
    var computers      = (List<BookHiveLibrary.Models.ComputerUnit>)(ViewBag.Computers ?? new List<BookHiveLibrary.Models.ComputerUnit>());
    var availableCount   = (int)(ViewBag.AvailableCount   ?? 0);
    var inUseCount       = (int)(ViewBag.InUseCount       ?? 0);
    var unavailableCount = (int)(ViewBag.UnavailableCount ?? 0);
}

@section Scripts {
<style>
    @@keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.6;transform:scale(1.3)} }
    .pulse { animation: pulse-dot 1.8s ease-in-out infinite; }
</style>
}

<!-- Fills the page's available height exactly (no outer page scroll) — the
     card below takes all of it, so only the card's own scrollbar handles
     overflow, not the page. -->
<div class="flex flex-col" style="height:100%;">

<div class="bg-white rounded-2xl p-4 sm:p-6 shadow-sm flex-1 min-h-0 flex flex-col" style="overflow:hidden;">

    <div class="flex items-center justify-between mb-6 flex-wrap gap-2 flex-shrink-0">
        <h2 class="text-lg font-bold text-gray-900">Lab Overview</h2>
        <div class="flex items-center gap-4 text-sm flex-wrap">
            <span class="flex items-center gap-1.5 text-emerald-600 font-semibold">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                @availableCount Available
            </span>
            <span class="flex items-center gap-1.5 text-blue-600 font-semibold">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-500 pulse inline-block"></span>
                @inUseCount In Use
            </span>
            <span class="flex items-center gap-1.5 text-orange-500 font-semibold">
                <span class="w-2.5 h-2.5 rounded-full bg-orange-400 inline-block"></span>
                @unavailableCount Unavailable
            </span>
        </div>
    </div>

    <div class="flex-1 min-h-0 overflow-y-scroll">
    @if (computers.Any())
    {
        <div style="min-height:100%;">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            @foreach (var pc in computers)
            {
                bool pcInUse       = pc.Sessions.Any(s => s.IsActive);
                bool pcUnavailable = !pc.IsAvailable && !pcInUse;
                var dotColor = pcInUse ? "bg-blue-400"   : (pcUnavailable ? "bg-orange-400"  : "bg-emerald-400");
                var pulseCls = pcInUse ? "pulse"         : "";
                var badge    = pcInUse ? "bg-blue-500 text-white" : (pcUnavailable ? "bg-orange-400 text-white" : "bg-emerald-500 text-white");
                var label    = pcInUse ? "In Use"        : (pcUnavailable ? "Unavailable"    : "Available");
                <div class="bg-[#000147] rounded-2xl p-5 relative hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 cursor-default flex items-center gap-4">
                    <span class="absolute top-4 right-4 w-3 h-3 rounded-full @dotColor @pulseCls block"></span>
                    <svg class="w-16 h-16 text-white/90 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M21 2H3a2 2 0 00-2 2v12a2 2 0 002 2h7l-2 3v1h8v-1l-2-3h7a2 2 0 002-2V4a2 2 0 00-2-2zm0 14H3V4h18v12z"/></svg>
                    <div class="min-w-0">
                        <p class="text-2xl font-extrabold text-white mb-2 tracking-tight truncate">@pc.ComputerNumber</p>
                        <span class="inline-block @badge text-[10px] font-semibold px-2 py-0.5 rounded-full">@label</span>
                    </div>
                </div>
            }
        </div>
        </div>
    }
    else
    {
        <div class="text-center py-16 text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="currentColor" viewBox="0 0 24 24"><path d="M21 2H3a2 2 0 00-2 2v12a2 2 0 002 2h7l-2 3v1h8v-1l-2-3h7a2 2 0 002-2V4a2 2 0 00-2-2zm0 14H3V4h18v12z"/></svg>
            <p class="text-sm font-medium">No computers registered yet.</p>
        </div>
    }
    </div>

</div>
</div>

