@model BookHiveLibrary.Models.ApplicationUser
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_UserHeaderLayout.cshtml";
    var availableComputers = (int)(ViewBag.AvailableComputers ?? 0);
    var borrowedBooks      = (int)(ViewBag.BorrowedBooks ?? 0);
    var recentBooks        = (List<BookHiveLibrary.Models.Book>)(ViewBag.RecentBooks ?? new List<BookHiveLibrary.Models.Book>());
    var myReservations     = (List<BookHiveLibrary.Models.BookReservation>)(ViewBag.MyReservations ?? new List<BookHiveLibrary.Models.BookReservation>());
    var booksToReturn      = (List<BookHiveLibrary.Models.BookReservation>)(ViewBag.BooksToReturn ?? new List<BookHiveLibrary.Models.BookReservation>());
    var borrowedBooksList  = (List<BookHiveLibrary.Models.BookReservation>)(ViewBag.BorrowedBooksList ?? new List<BookHiveLibrary.Models.BookReservation>());
}

<!-- Book Info Modal — opened by clicking a card in the Library Book Catalog
     instead of navigating to a separate page. Filled from the data-book JSON
     attribute Razor renders on each card, so no extra request is needed. -->
<div id="bookInfoModal" class="fixed inset-0 z-[10030] hidden flex items-center justify-center bg-black/50" onclick="closeBookModal(event)">
    <div class="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-3xl mx-4 relative" onclick="event.stopPropagation()">
        <button onclick="closeBookModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <div class="flex flex-col md:flex-row gap-6">
            <!-- Cover -->
            <div class="w-full md:w-56 flex-shrink-0 bg-[#000147]/10 rounded-xl flex items-center justify-center overflow-hidden" style="aspect-ratio:3/4;">
                <img id="bookModalCover" src="" alt="cover" class="w-full h-full object-cover hidden" />
                <span id="bookModalNoCover" class="text-gray-400 text-sm">Book Photo</span>
            </div>
            <!-- Info -->
            <div class="flex-1 min-w-0 border border-gray-200 rounded-xl p-5">
                <div class="flex items-start justify-between gap-3 mb-1">
                    <h2 id="bookModalTitle" class="text-xl font-bold text-gray-900"></h2>
                    <span id="bookModalBadge" class="flex-shrink-0 text-xs px-3 py-1 rounded-full font-semibold"></span>
                </div>
                <p class="text-sm text-gray-500 mb-4">by <span id="bookModalAuthor"></span></p>
                <div class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
                    <div id="bookModalCategoryWrap">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Category</p>
                        <p id="bookModalCategory" class="text-gray-800 font-medium"></p>
                    </div>
                    <div id="bookModalCallNumberWrap">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Call Number</p>
                        <p id="bookModalCallNumber" class="text-gray-800 font-medium"></p>
                    </div>
                    <div id="bookModalYearWrap">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Published Year</p>
                        <p id="bookModalYear" class="text-gray-800 font-medium"></p>
                    </div>
                    <div id="bookModalGradeWrap">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Grade Level</p>
                        <p id="bookModalGrade" class="text-gray-800 font-medium"></p>
                    </div>
                    <div id="bookModalAisleWrap">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Aisle Location</p>
                        <p id="bookModalAisle" class="text-gray-800 font-medium"></p>
                    </div>
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Copies Available</p>
                        <p id="bookModalCopies" class="text-gray-800 font-medium"></p>
                    </div>
                    <div id="bookModalIsbnWrap" class="col-span-2">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">ISBN</p>
                        <p id="bookModalIsbn" class="text-gray-800 font-medium"></p>
                    </div>
                </div>
                <div id="bookModalDescWrap" class="mt-4">
                    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Description</p>
                    <p id="bookModalDesc" class="text-sm text-gray-700 leading-relaxed"></p>
                </div>
            </div>
        </div>
        <div class="mt-5 flex justify-end">
            <form id="bookModalReserveForm" method="post" asp-action="Reserve" asp-controller="Student">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" id="bookModalReserveId" value="" />
                <input type="hidden" name="returnToDetail" value="false" />
                <button id="bookModalReserveBtn" type="submit" class="bg-[#000147] hover:bg-[#000147]/80 text-white px-8 py-3 rounded-xl font-medium text-sm transition">
                    Reserve
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Fills the page's available height exactly (no outer page scroll) — the
     banners and stat cards are fixed-height and the catalog/right-panel grid
     below takes whatever's left, so only each panel's own scrollbar handles
     overflow, not the page. -->
<div class="flex flex-col" style="height:100%;">

@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-100 border border-green-300 text-green-700 px-4 py-2 rounded-xl text-sm flex-shrink-0">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-100 border border-red-300 text-red-700 px-4 py-2 rounded-xl text-sm flex-shrink-0">@TempData["Error"]</div>
}
@if (string.IsNullOrEmpty(Model?.PhoneNumber))
{
    <div class="mb-4 bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-xl text-sm flex items-center gap-2 flex-shrink-0">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        <span>You need to add a phone number to your profile before you can reserve books.
            <a href="@Url.Action("Profile","Student")" class="font-semibold underline ml-1">Update Profile â†’</a>
        </span>
    </div>
}

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 flex-shrink-0">
        <a href="@Url.Action("ComputerVacancy","Student")"
           class="bg-[#000147] rounded-2xl p-5 text-center shadow-sm hover:shadow-lg hover:opacity-90 transition cursor-pointer block">
            <div class="text-sm font-semibold uppercase tracking-wide text-blue-200 mb-2">Computer Available</div>
            <div class="text-4xl font-bold text-white">@availableComputers</div>
        </a>
        <div onclick="openBorrowedPanel()"
             class="bg-[#000147] rounded-2xl p-5 text-center shadow-sm hover:shadow-lg hover:opacity-90 transition cursor-pointer">
            <div class="text-sm font-semibold uppercase tracking-wide text-blue-200 mb-2">Total Book Borrowed</div>
            <div class="text-4xl font-bold text-white">@borrowedBooks <span class="text-xl font-medium text-blue-300">/ 3</span></div>
        </div>
    </div>

    <!-- Borrowed Books Slide Panel -->
    <div id="borrowedPanel" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/40" onclick="closeBorrowedPanel(event)">
        <div id="borrowedPanelInner" class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 flex flex-col overflow-hidden" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between px-6 py-4 flex-shrink-0" style="background:#000147;">
                <h2 class="text-base font-semibold text-white">Borrowed Books</h2>
                <button onclick="closeBorrowedPanel(null)" class="text-white/70 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <!-- Sized to comfortably show 3 books before scrolling — each row is
                 roughly h-20 (80px) cover + p-4 padding + gap-4, so 3 rows land
                 around 28rem. -->
            <div class="overflow-y-auto px-6 py-4 space-y-4" style="max-height:28rem;">
                @if (!borrowedBooksList.Any())
                {
                    <div class="flex items-center justify-center py-8">
                        <p class="text-sm text-gray-400">No borrowed books at the moment.</p>
                    </div>
                }
                else
                {
                    @foreach (var b in borrowedBooksList)
                    {
                        <div class="bg-gray-50 rounded-xl p-4 flex gap-4 items-start border border-gray-100">
                            @if (!string.IsNullOrEmpty(b.Book?.CoverImageUrl))
                            {
                                <img src="@b.Book.CoverImageUrl" class="w-14 h-20 object-cover rounded-lg flex-shrink-0 shadow" />
                            }
                            else
                            {
                                <div class="w-14 h-20 rounded-lg flex-shrink-0 flex items-center justify-center text-white text-xs font-bold" style="background:#000147;">N/A</div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-bold text-gray-800 truncate">@b.Book?.Title</p>
                                <p class="text-xs text-gray-500 truncate">@b.Book?.Author</p>
                                <p class="text-xs text-gray-400 mt-1">Picked up: @PhTime.FromUtc(b.CreatedAt).ToString("MMM dd, yyyy")</p>
                                @if (b.DueDate.HasValue)
                                {
                                    var overdue = b.DueDate.Value < DateTime.UtcNow;
                                    <p class="text-xs mt-0.5 font-medium @(overdue ? "text-red-500" : "text-emerald-600")">
                                        Due: @PhTime.FromUtc(b.DueDate.Value).ToString("MMM dd, yyyy") @(overdue ? "âš  Overdue" : "")
                                    </p>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Catalog + Right Panel -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 flex-1 min-h-0" id="dashboardGridArea">

        <!-- Library Catalog -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm flex flex-col flex-1 min-h-0" style="overflow:hidden;" id="catalogCard">
                <h2 class="flex-shrink-0 px-6 pt-6 pb-4">
                    <a href="@Url.Action("BookViewing","Student")" class="text-lg font-bold text-gray-900 hover:text-[#000147] hover:underline">Library Book Catalog</a>
                </h2>
                <div class="flex-1 min-h-0 overflow-y-scroll px-6 pb-6">
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                    @foreach (var book in recentBooks.Take(6))
                    {
                        var isAvail = book.AvailableQuantity > 0;
                        var bookJson = System.Text.Json.JsonSerializer.Serialize(new {
                            id = book.Id,
                            title = book.Title,
                            author = book.Author,
                            cover = book.CoverImageUrl,
                            category = book.Category,
                            callNumber = book.CallNumber,
                            publishedYear = book.PublishedYear,
                            gradeLevel = book.GradeLevel,
                            aisleLocation = book.AisleLocation,
                            isbn = book.ISBN,
                            description = book.Description,
                            available = book.AvailableQuantity,
                            total = book.TotalQuantity,
                            isAvail = isAvail
                        });
                        <div class="bg-[#b0c4d8] rounded-2xl overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 block cursor-pointer"
                             data-book="@bookJson" onclick="openBookModal(this)">
                            <div class="w-full h-48 bg-[#000147]/10 flex items-center justify-center overflow-hidden">
                                @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                {
                                    <img src="@book.CoverImageUrl" alt="cover" class="w-full h-full object-cover"/>
                                }
                                else
                                {
                                    <svg class="w-10 h-10 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>
                                }
                            </div>
                            <div class="p-4">
                                <h3 class="font-semibold text-gray-900 mb-1 truncate">@book.Title</h3>
                                <p class="text-sm text-gray-500 mb-2 truncate">@book.Author</p>
                                <span class="inline-block @(isAvail ? "bg-emerald-500" : "bg-red-400") text-white text-xs px-3 py-1 rounded-full">@(isAvail ? "Available" : "Not Available")</span>
                            </div>
                        </div>
                    }
                    @if (!recentBooks.Any())
                    {
                        <p class="col-span-2 text-sm text-gray-400 text-center py-8">No books registered yet.</p>
                    }
                </div>
                </div>
            </div>

        <!-- Right panel — height matched to the Book Catalog card via JS
             (syncStudentDashboardHeights), split evenly between the two cards. -->
        <div class="flex flex-col gap-6" id="rightPanelsCol">

            <!-- My Reservation -->
            <div class="bg-white rounded-2xl shadow-sm flex flex-col flex-1 min-h-0" style="overflow:hidden;">
                <h2 class="text-lg font-bold text-gray-900 px-6 pt-6 pb-4 flex-shrink-0">My Reservation</h2>
                <div class="flex-1 min-h-0 overflow-y-scroll px-6 pb-6">
                @if (myReservations.Any())
                {
                    <div class="space-y-4">
                    @for (int i = 0; i < myReservations.Count; i++)
                    {
                        var res = myReservations[i];
                        bool isLast = i == myReservations.Count - 1;
                        <div class="@(isLast ? "" : "pb-4 border-b border-gray-100")">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-gray-900 font-semibold">@res.Book?.Title</p>
                                    <p class="text-sm text-gray-500">@res.Book?.Author</p>
                                </div>
                                <span class="@(res.Status == "Approved" ? "bg-green-500" : "bg-yellow-500") text-white text-xs px-3 py-1 rounded-full whitespace-nowrap">@res.Status</span>
                            </div>
                            <div class="border-t border-gray-100 pt-3 mt-3">
                                <p class="text-sm text-gray-500 mb-1">Pickup before <span class="text-gray-700 font-medium">@PhTime.FromUtc(res.PickupDeadline).ToString("MMM dd, yyyy h:mm tt")</span></p>
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-yellow-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    @* DateTimeKind.Utc is forced explicitly so the "o" format ends in "Z" —
                                       EF Core reads DateTime columns back as Kind=Unspecified, and without
                                       the "Z", the browser's `new Date(...)` below would treat this as the
                                       viewer's OWN local time instead of UTC, throwing the countdown off by
                                       a full 8 hours for anyone in the Philippines. *@
                                    <p class="reservation-countdown text-sm font-semibold text-yellow-600" data-deadline="@DateTime.SpecifyKind(res.PickupDeadline, DateTimeKind.Utc).ToString("o")"></p>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-400 text-center py-4">No active reservations.</p>
                }
                </div>
            </div>

            <!-- Books To Return -->
            <div class="bg-white rounded-2xl shadow-sm flex flex-col flex-1 min-h-0" style="overflow:hidden;">
                <h2 class="text-lg font-bold text-gray-900 px-6 pt-6 pb-4 flex-shrink-0">Books To Return</h2>
                <div class="flex-1 min-h-0 overflow-y-scroll px-6 pb-6 space-y-4">
                    @if (booksToReturn.Any())
                    {
                        @foreach (var item in booksToReturn)
                        {
                            var overdue = item.DueDate.HasValue && item.DueDate.Value < DateTime.UtcNow;
                            <div class="flex justify-between items-start pb-4 border-b border-gray-100 last:border-b-0">
                                <div>
                                    <p class="text-gray-900 font-semibold">@item.Book?.Title</p>
                                    <p class="text-sm text-gray-500">@item.Book?.Author</p>
                                    @if (item.DueDate.HasValue)
                                    {
                                        <p class="text-xs text-gray-400 mt-1">Due Date: @PhTime.FromUtc(item.DueDate.Value).ToString("MM/dd/yy")</p>
                                    }
                                </div>
                                @if (overdue)
                                {
                                    <span class="bg-red-500 text-white text-xs px-3 py-1 rounded-full whitespace-nowrap">Overdue</span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-sm text-gray-400 text-center py-4">No books to return.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
function openBookModal(el) {
    const b = JSON.parse(el.dataset.book);

    document.getElementById('bookModalTitle').textContent = b.title;
    document.getElementById('bookModalAuthor').textContent = b.author;

    const badge = document.getElementById('bookModalBadge');
    badge.textContent = b.isAvail ? 'Available' : 'Not Available';
    badge.className = 'flex-shrink-0 text-xs px-3 py-1 rounded-full font-semibold ' +
        (b.isAvail ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-600');

    const cover = document.getElementById('bookModalCover');
    const noCover = document.getElementById('bookModalNoCover');
    if (b.cover) {
        cover.src = b.cover;
        cover.classList.remove('hidden');
        noCover.classList.add('hidden');
    } else {
        cover.classList.add('hidden');
        noCover.classList.remove('hidden');
    }

    setBookModalField('bookModalCategoryWrap', 'bookModalCategory', b.category);
    setBookModalField('bookModalCallNumberWrap', 'bookModalCallNumber', b.callNumber);
    setBookModalField('bookModalYearWrap', 'bookModalYear', b.publishedYear);
    setBookModalField('bookModalGradeWrap', 'bookModalGrade', b.gradeLevel);
    setBookModalField('bookModalAisleWrap', 'bookModalAisle', b.aisleLocation);
    document.getElementById('bookModalCopies').textContent = b.available + ' / ' + b.total;
    setBookModalField('bookModalIsbnWrap', 'bookModalIsbn', b.isbn);
    setBookModalField('bookModalDescWrap', 'bookModalDesc', b.description);

    document.getElementById('bookModalReserveId').value = b.id;
    const reserveBtn = document.getElementById('bookModalReserveBtn');
    reserveBtn.disabled = !b.isAvail;
    reserveBtn.textContent = b.isAvail ? 'Reserve' : 'Not Available';
    reserveBtn.className = b.isAvail
        ? 'bg-[#000147] hover:bg-[#000147]/80 text-white px-8 py-3 rounded-xl font-medium text-sm transition'
        : 'bg-gray-300 text-gray-500 px-8 py-3 rounded-xl font-medium text-sm cursor-not-allowed';

    document.getElementById('bookInfoModal').classList.remove('hidden');
}

function setBookModalField(wrapId, fieldId, value) {
    const wrap = document.getElementById(wrapId);
    if (value) {
        document.getElementById(fieldId).textContent = value;
        wrap.classList.remove('hidden');
    } else {
        wrap.classList.add('hidden');
    }
}

function closeBookModal(e) {
    if (e && e.target !== e.currentTarget) return;
    document.getElementById('bookInfoModal').classList.add('hidden');
}

// Size the Book Catalog card and the right column (My Reservation + Books To
// Return) explicitly from the grid area's own flex-allocated height, rather
// than relying on CSS Grid's align-items:stretch — Grid only stretches a row
// to the tallest item's auto/content height, so once either column's content
// grows past the available space the row (and the page under it) grows too.
// Setting both columns' height directly from the reliably-bounded flex-1
// parent keeps them capped and lets each panel's own scrollbar take over.
function syncStudentDashboardHeights() {
    const gridArea = document.getElementById('dashboardGridArea');
    const leftCard = document.getElementById('catalogCard');
    const rightCol = document.getElementById('rightPanelsCol');
    if (!gridArea || !leftCard || !rightCol) return;
    if (window.matchMedia('(min-width: 1024px)').matches) {
        const h = gridArea.clientHeight + 'px';
        leftCard.style.height = h;
        rightCol.style.height = h;
    } else {
        leftCard.style.height = '';
        rightCol.style.height = '';
    }
}
window.addEventListener('resize', syncStudentDashboardHeights);
window.addEventListener('load', syncStudentDashboardHeights);
(function() {
    const gridArea = document.getElementById('dashboardGridArea');
    if (gridArea && window.ResizeObserver) {
        new ResizeObserver(syncStudentDashboardHeights).observe(gridArea);
    }
    syncStudentDashboardHeights();
})();

function openBorrowedPanel() {
    document.getElementById('borrowedPanel').classList.remove('hidden');
}
function closeBorrowedPanel(e) {
    if (e && e.target !== e.currentTarget) return;
    document.getElementById('borrowedPanel').classList.add('hidden');
}

// Reservation countdowns — one per reservation now that all of them are
// listed (not just the first, with a "+N more" hint for the rest).
(function() {
    const els = document.querySelectorAll('.reservation-countdown');
    if (!els.length) return;
    function tick() {
        els.forEach(el => {
            const deadline = new Date(el.dataset.deadline);
            const diff = deadline - new Date();
            if (diff <= 0) { el.textContent = 'Pickup window expired'; return; }
            const h = Math.floor(diff / 3600000);
            const m = Math.floor((diff % 3600000) / 60000);
            const s = Math.floor((diff % 60000) / 1000);
            el.textContent = h > 0 ? `${h}h ${m}m ${s}s remaining` : `${m}m ${s}s remaining`;
        });
    }
    tick(); setInterval(tick, 1000);
})();

// Real-time reload when reservation status changes
stuConnection.on('BookTransactionUpdated', function() { location.reload(); });
stuConnection.on('NewReservation', function() {});
</script>
}

