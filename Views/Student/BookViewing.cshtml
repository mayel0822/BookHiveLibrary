@model BookHiveLibrary.Models.ApplicationUser
@{
    ViewData["Title"] = "Book Viewing";
    Layout = "~/Views/Shared/_UserHeaderLayout.cshtml";
    var books      = (List<BookHiveLibrary.Models.Book>)(ViewBag.Books ?? new List<BookHiveLibrary.Models.Book>());
    var categories = (List<string>)(ViewBag.Categories ?? new List<string>());
    var search     = (string)(ViewBag.Search ?? "");
    var catFilter  = (string)(ViewBag.Category ?? "");
}

<!-- Fills the page's available height exactly (no outer page scroll) — the
     banners are fixed-height and the catalog card below takes whatever's
     left, so only the card's own scrollbar handles overflow, not the page. -->
<div class="flex flex-col" style="height:100%;">

@if (TempData["Success"] != null)
{
    <div class="mb-4 bg-green-100 border border-green-300 text-green-700 px-4 py-2 rounded-xl text-sm flex-shrink-0">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-4 bg-red-100 border border-red-300 text-red-700 px-4 py-2 rounded-xl text-sm flex-shrink-0">@TempData["Error"]</div>
}

<div class="bg-white rounded-2xl p-4 sm:p-6 shadow-sm flex-1 min-h-0 flex flex-col" style="overflow:hidden;">

    <div class="flex items-center gap-4 mb-6 flex-wrap flex-shrink-0">
        <h2 class="text-lg font-bold text-gray-900 flex-1">Library Book Catalog</h2>
        <form method="get" asp-action="BookViewing" asp-controller="Student">
            <div class="flex items-center border border-gray-300 rounded-full overflow-hidden bg-white focus-within:ring-2 focus-within:ring-blue-200 shadow-sm">
                <!-- Category dropdown — short -->
                <select name="category" class="text-sm pl-4 pr-2 py-2.5 bg-white outline-none text-gray-600 border-0 border-r border-gray-200 w-36 flex-shrink-0 cursor-pointer">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(catFilter == cat ? "selected" : null)">@cat</option>
                    }
                </select>
                <!-- Search text — much longer -->
                <input type="text" name="search" value="@search" placeholder="Search title or author..."
                       class="flex-1 pl-4 pr-2 py-2.5 text-sm outline-none bg-white min-w-0 w-64 sm:w-96" />
                <!-- Search icon button -->
                <button type="submit" class="flex items-center justify-center w-10 h-10 mr-1 rounded-full hover:bg-gray-100 transition text-gray-500 hover:text-gray-800 flex-shrink-0">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
                </button>
            </div>
        </form>
    </div>

    <div class="flex-1 min-h-0 overflow-y-scroll">
    @if (books.Any())
    {
        <div style="min-height:100%;">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            @foreach (var book in books)
            {
                var isAvail  = book.AvailableQuantity > 0;
                var badgeCls = isAvail ? "bg-emerald-500" : "bg-red-400";
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 overflow-hidden flex flex-col">
                    <div class="flex gap-3 p-4">
                        @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                        {
                            <img src="@book.CoverImageUrl" alt="cover" class="w-20 h-28 object-cover rounded-xl flex-shrink-0"/>
                        }
                        else
                        {
                            <div class="w-20 h-28 flex-shrink-0 rounded-xl bg-gradient-to-br from-[#c5cfe0] to-[#a8b8cc] shadow-inner"></div>
                        }
                        <div class="flex-1 min-w-0">
                            <dl class="space-y-0.5 text-[11px] text-[#2c3e6b]">
                                <div><span class="font-semibold">Book Title:</span> @book.Title</div>
                                <div><span class="font-semibold">Author:</span> @book.Author</div>
                                <div><span class="font-semibold">Published Year:</span> @(string.IsNullOrEmpty(book.PublishedYear) ? "â€”" : book.PublishedYear)</div>
                                <div><span class="font-semibold">Category:</span> @(string.IsNullOrEmpty(book.Category) ? "â€”" : book.Category)</div>
                                <div class="flex items-center gap-1">
                                    <span class="font-semibold">Status:</span>
                                    <span class="inline-block @badgeCls text-white text-[10px] font-semibold px-2 py-0.5 rounded-full">@(isAvail ? "Available" : "Not Available")</span>
                                </div>
                                <div><span class="font-semibold">Qty:</span> @book.AvailableQuantity</div>
                                <div><span class="font-semibold">Loc:</span> @(string.IsNullOrEmpty(book.AisleLocation) ? "â€”" : book.AisleLocation)</div>
                            </dl>
                        </div>
                    </div>
                    <div class="mx-4 border-t border-gray-100"></div>
                    <div class="px-4 py-3 flex-1 flex flex-col">
                        <p class="text-[11px] font-semibold text-[#2c3e6b] mb-1">Book Synopsis:</p>
                        <p class="text-[11px] text-gray-400 flex-1 mb-4 leading-relaxed min-h-[2rem]">@(string.IsNullOrEmpty(book.Description) ? "No synopsis available." : book.Description)</p>
                        <div class="flex justify-end">
                            @if (isAvail)
                            {
                                <form method="post" asp-action="Reserve" asp-controller="Student">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@book.Id"/>
                                    <button type="submit" class="bg-[#000147] hover:bg-[#000147]/80 active:bg-[#0f2540] text-white text-xs font-semibold px-6 py-1.5 rounded-full transition-all duration-150 shadow-sm hover:shadow">
                                        Reserve
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" disabled
                                        class="text-xs font-semibold px-6 py-1.5 rounded-full cursor-not-allowed bg-gray-200 text-gray-400"
                                        title="No copies available. Check back when a book is returned.">
                                    Reserve
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        </div>
    }
    else
    {
        <div class="text-center py-16 text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="currentColor" viewBox="0 0 20 20"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>
            <p class="text-sm font-medium">No books found.</p>
            @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(catFilter))
            {
                <a href="@Url.Action("BookViewing","Student")" class="text-xs text-gray-900 hover:underline mt-1 inline-block">Clear filters</a>
            }
        </div>
    }
    </div>

</div>
</div>

@section Scripts {
<script>
// A book's availability (quantity, borrowed/returned) can change while ANY
// student has this page open — broadcast to everyone browsing, not just the
// one whose own reservation changed. Otherwise a book that just ran out keeps
// showing "Available" here until someone happens to manually refresh.
// The search/category filter survives the reload since this is a plain GET
// form (query string in the URL).
if (typeof stuConnection !== 'undefined') {
    stuConnection.on('BookAvailabilityChanged', function() { location.reload(); });
}
</script>
}

