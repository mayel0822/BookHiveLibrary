@model BookHiveLibrary.Models.Book
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_UserHeaderLayout.cshtml";
    int realAvailable = ViewBag.RealAvailable ?? Model.AvailableQuantity;
    var isAvail = realAvailable > 0;
}

<div class="h-full flex flex-col">
    <a href="@Url.Action("Dashboard","Student")" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-800 mb-4 transition self-start">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Back to Dashboard
    </a>

    <div class="bg-white rounded-2xl shadow-sm overflow-hidden flex flex-col md:flex-row flex-1" style="min-height:0;">

        <!-- Left: Cover (50%) -->
        <div class="w-full md:w-1/2 flex-shrink-0 bg-[#000147]/10 flex items-center justify-center overflow-hidden border-b md:border-b-0 md:border-r border-gray-100 py-8 md:py-0">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" alt="cover" class="w-4/5 h-4/5 object-contain drop-shadow-xl" />
            }
            else
            {
                <svg class="w-20 h-20 text-gray-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>
            }
        </div>

        <!-- Right: Info (50%) -->
        <div class="w-full md:w-1/2 flex flex-col p-8 overflow-y-auto">
            <div class="flex items-start justify-between gap-3 mb-1">
                <h1 class="text-3xl font-bold text-gray-900 leading-tight">@Model.Title</h1>
                <span class="flex-shrink-0 text-xs px-3 py-1 rounded-full font-semibold @(isAvail ? "bg-emerald-100 text-emerald-700" : "bg-red-100 text-red-600")">
                    @(isAvail ? "Available" : "Not Available")
                </span>
            </div>
            <p class="text-base text-gray-500 mb-6">by @Model.Author</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 text-sm mb-6">
                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Category</p>
                        <p class="text-gray-800 font-medium">@Model.Category</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CallNumber))
                {
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Call Number</p>
                        <p class="text-gray-800 font-medium">@Model.CallNumber</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.PublishedYear))
                {
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Published Year</p>
                        <p class="text-gray-800 font-medium">@Model.PublishedYear</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.GradeLevel))
                {
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Grade Level</p>
                        <p class="text-gray-800 font-medium">@Model.GradeLevel</p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.AisleLocation))
                {
                    <div>
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Aisle Location</p>
                        <p class="text-gray-800 font-medium">@Model.AisleLocation</p>
                    </div>
                }
                <div>
                    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Copies Available</p>
                    <p class="text-gray-800 font-medium">@realAvailable / @Model.TotalQuantity</p>
                </div>
                @if (!string.IsNullOrEmpty(Model.ISBN))
                {
                    <div class="col-span-2">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">ISBN</p>
                        <p class="text-gray-800 font-medium">@Model.ISBN</p>
                    </div>
                }
                @if (Model.IsRoomUseOnly)
                {
                    <div class="col-span-2">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Usage</p>
                        <p class="text-orange-600 font-medium">Room Use Only</p>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-8">
                    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2">Description</p>
                    <p class="text-sm text-gray-700 leading-relaxed">@Model.Description</p>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm">
                    @TempData["Error"]
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 rounded-xl text-sm">
                    @TempData["Success"]
                </div>
            }

            <div class="mt-auto flex justify-end">
                @if (isAvail)
                {
                    <form method="post" asp-action="Reserve" asp-controller="Student">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@Model.Id" />
                        <input type="hidden" name="returnToDetail" value="true" />
                        <button type="submit" class="inline-block bg-[#000147] hover:bg-[#000147]/80 text-white px-8 py-3 rounded-xl font-medium text-sm transition">
                            Reserve
                        </button>
                    </form>
                }
                else
                {
                    <button disabled class="inline-block bg-gray-300 text-gray-500 px-8 py-3 rounded-xl font-medium text-sm cursor-not-allowed">
                        Not Available
                    </button>
                }
            </div>
        </div>
    </div>
</div>

