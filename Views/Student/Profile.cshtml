@model BookHiveLibrary.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_UserHeaderLayout.cshtml";
    var userName = (!string.IsNullOrWhiteSpace(Model?.FirstName) || !string.IsNullOrWhiteSpace(Model?.LastName))
        ? $"{Model.FirstName} {Model.LastName}".Trim()
        : Model?.UserName ?? "User";
}

<!-- Photo Preview Modal -->
<div id="photoModal" class="fixed inset-0 z-[10020] hidden flex items-center justify-center bg-black/50">
    <div class="bg-white rounded-2xl shadow-2xl p-8 w-80 flex flex-col items-center gap-4">
        <div id="modalAvatar" class="w-28 h-28 rounded-full overflow-hidden flex items-center justify-center text-white text-4xl font-bold flex-shrink-0" style="background-color:#000147;">
            @(Model?.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "S")
        </div>
        <div class="text-center">
            <p class="text-base font-bold text-gray-900">@userName</p>
            <p class="text-sm text-gray-500 mt-0.5">@(Model?.StudentNumber ?? "-")</p>
        </div>
        <div class="flex gap-3 w-full mt-2">
            <button onclick="cancelPhoto()" class="flex-1 border border-gray-300 text-gray-600 py-2 rounded-xl text-sm font-medium hover:bg-gray-50 transition">Cancel</button>
            <button onclick="submitPhoto()" class="flex-1 text-white py-2 rounded-xl text-sm font-medium hover:opacity-90 transition" style="background-color:#000147;">Save Photo</button>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-5 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm">&#10003; @TempData["Success"]</div>
}

<div class="w-full">

    <div class="mb-6 flex items-center justify-between">
        <h1 class="text-3xl font-bold text-gray-800">My Profile</h1>
        <label class="flex items-center gap-3 cursor-pointer select-none">
            <span class="text-sm font-medium text-gray-600">Dark Mode</span>
            <span class="relative inline-block w-11 h-6">
                <input type="checkbox" id="darkModeToggle" class="peer sr-only" onchange="toggleDarkMode(this.checked)" checked="@(Model?.DarkMode == true ? "checked" : null)" />
                <span class="absolute inset-0 rounded-full bg-gray-300 peer-checked:bg-[#000147] transition-colors"></span>
                <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform peer-checked:translate-x-5"></span>
            </span>
        </label>
    </div>

    <!-- Two-panel landscape layout -->
    <div class="flex flex-col lg:flex-row gap-6">

        <!-- LEFT PANEL — Avatar -->
        <form id="photoForm" method="post" asp-action="Profile" asp-controller="Student" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="file" id="profilePictureInput" name="profilePicture" accept="image/*" class="hidden" onchange="onPhotoChosen(this)" />
        </form>

        <div class="bg-white rounded-2xl shadow p-8 flex flex-col items-center gap-4 lg:w-72 flex-shrink-0">
            <div class="relative cursor-pointer" onclick="document.getElementById('profilePictureInput').click()">
                <div id="avatarPreview"
                     class="w-28 h-28 rounded-full overflow-hidden flex items-center justify-center text-white text-4xl font-bold ring-2 ring-offset-2 ring-transparent hover:ring-blue-400 transition"
                     style="background-color:#000147;">
                    @if (!string.IsNullOrEmpty(Model?.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span>@(Model?.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "S")</span>
                    }
                </div>
                <div class="absolute bottom-0 right-0 w-7 h-7 rounded-full bg-white border border-gray-300 flex items-center justify-center shadow pointer-events-none">
                    <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a4 4 0 01-1.414.94l-3.414 1.138 1.138-3.414a4 4 0 01.94-1.414z"/>
                    </svg>
                </div>
            </div>
            <div class="text-center w-full px-2">
                <p class="text-base font-bold text-gray-800">@userName</p>
                <p class="text-xs text-gray-400 mt-0.5 break-all">@Model?.Email</p>
                <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-semibold mt-2 inline-block">@(Model?.UserType ?? "Student")</span>
            </div>
        </div>

        <!-- RIGHT PANEL — Account details -->
        <div class="bg-white rounded-2xl shadow p-8 flex-1 space-y-5">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-widest">Account Information</h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div>
                    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">First Name</p>
                    <p class="text-sm font-medium text-gray-800">@(Model?.FirstName ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Middle Name</p>
                    <p class="text-sm font-medium text-gray-800">@(Model?.MiddleName ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Last Name</p>
                    <p class="text-sm font-medium text-gray-800">@(Model?.LastName ?? "-")</p>
                </div>
            </div>

            <div class="border-t border-gray-100 pt-4">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Email</p>
                <p class="text-sm font-medium text-gray-800 break-all">@(Model?.Email ?? "-")</p>
            </div>

            <div class="border-t border-gray-100 pt-4">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Phone Number</p>
                <p class="text-sm font-medium text-gray-800">@(Model?.PhoneNumber ?? "-")</p>
            </div>

            <div class="border-t border-gray-100 pt-4 grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Student Number</p>
                    <p class="text-sm font-medium text-gray-800">@(Model?.StudentNumber ?? "-")</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Section</p>
                    <p class="text-sm font-medium text-gray-800">@(Model?.Section ?? "-")</p>
                </div>
            </div>

            <div class="border-t border-gray-100 pt-4">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Member Since</p>
                <p class="text-sm font-medium text-gray-800">@Model?.CreatedAt.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
function onPhotoChosen(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        document.getElementById('modalAvatar').innerHTML =
            `<img src="${e.target.result}" class="w-full h-full object-cover" />`;
        document.getElementById('photoModal').classList.remove('hidden');
    };
    reader.readAsDataURL(input.files[0]);
}
function cancelPhoto() {
    document.getElementById('photoModal').classList.add('hidden');
    document.getElementById('profilePictureInput').value = '';
}
function submitPhoto() {
    document.getElementById('photoModal').classList.add('hidden');
    document.getElementById('photoForm').submit();
}

// Applies instantly for this tab, then persists to the account so it
// follows the user to any device — see Controllers/AccountController.cs'
// shared SetDarkMode action.
async function toggleDarkMode(enabled) {
    document.documentElement.classList.toggle('dark', enabled);
    try {
        const fd = new FormData();
        fd.append('enabled', enabled);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) fd.append('__RequestVerificationToken', token);
        await fetch('/Account/SetDarkMode', { method: 'POST', body: fd });
    } catch {}
}
</script>
}
