@model BookHiveLibrary.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    var userName = (!string.IsNullOrWhiteSpace(Model?.FirstName) || !string.IsNullOrWhiteSpace(Model?.LastName))
        ? $"{Model.FirstName} {Model.LastName}".Trim()
        : Model?.UserName ?? "User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>My Profile – BookHive</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet" />
</head>
<body class="bg-[#dce6f5]">

<!-- Photo Preview Modal -->
<div id="photoModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/50">
    <div class="bg-white rounded-2xl shadow-2xl p-8 w-80 flex flex-col items-center gap-4">
        <div id="modalAvatar" class="w-28 h-28 rounded-full overflow-hidden flex items-center justify-center text-white text-4xl font-bold flex-shrink-0" style="background-color:#000147;">
            @(Model?.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "S")
        </div>
        <div class="text-center">
            <p class="text-base font-bold text-gray-900">@userName</p>
            <p class="text-sm text-gray-500 mt-0.5">@(Model?.StudentNumber ?? "—")</p>
        </div>
        <div class="flex gap-3 w-full mt-2">
            <button onclick="cancelPhoto()" class="flex-1 border border-gray-300 text-gray-600 py-2 rounded-xl text-sm font-medium hover:bg-gray-50 transition">Cancel</button>
            <button onclick="submitPhoto()" class="flex-1 text-white py-2 rounded-xl text-sm font-medium hover:opacity-90 transition" style="background-color:#000147;">Save Photo</button>
        </div>
    </div>
</div>

<!-- Hidden photo-only form -->
<form id="photoForm" method="post" asp-action="Profile" asp-controller="Student" enctype="multipart/form-data" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="firstName" value="@Model?.FirstName" />
    <input type="hidden" name="lastName" value="@Model?.LastName" />
    <input type="hidden" name="middleName" value="@Model?.MiddleName" />
    <input type="hidden" name="phoneNumber" value="@Model?.PhoneNumber" />
    <input type="file" id="profilePictureInput" name="profilePicture" accept="image/*" class="hidden" onchange="onPhotoChosen(this)" />
</form>

<div id="sidebar-backdrop" class="fixed inset-0 bg-black/40 z-40 hidden" onclick="toggleSidebar()"></div>

<div class="flex h-screen bg-[#dce6f5]">

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-56 bg-[#000147] text-white flex flex-col py-8 px-5 flex-shrink-0 shadow-xl -translate-x-full lg:translate-x-0 lg:relative transition-transform duration-300">
        <div class="mb-10 flex items-center justify-between">
            <a href="@Url.Action("Dashboard","Student")" class="flex items-center justify-center w-full">
                <span style="font-family:'Dancing Script',cursive;font-size:2rem;font-weight:800;color:white;line-height:1;display:block;text-align:center;">BookHive</span>
            </a>
            <button onclick="toggleSidebar()" class="lg:hidden text-white/60 hover:text-white transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <nav class="space-y-1 flex-1">
            <a href="@Url.Action("Dashboard","Student")" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-blue-200 hover:bg-white/10 hover:text-white transition-all duration-200">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
                Home
            </a>
            <a href="@Url.Action("BookViewing","Student")" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-blue-200 hover:bg-white/10 hover:text-white transition-all duration-200">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>
                Book Viewing
            </a>
            <a href="@Url.Action("ComputerVacancy","Student")" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-blue-200 hover:bg-white/10 hover:text-white transition-all duration-200">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd"/></svg>
                Computer Vacancy
            </a>
        </nav>
    </aside>

    <!-- Main -->
    <main class="flex-1 overflow-y-auto bg-[#dce6f5]">

        <!-- Header -->
        <header class="bg-white border-b border-gray-200 flex items-center justify-between px-6 py-3 shadow-sm flex-shrink-0">
            <div class="flex items-center gap-3">
                <button onclick="toggleSidebar()" class="lg:hidden text-gray-500 hover:text-gray-700 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div class="mt-1">
                    <h2 class="text-base font-semibold text-gray-800">My Profile</h2>
                    <p class="text-xs text-gray-400 hidden sm:block">Student Portal — STI San Jose Del Monte</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <a href="/Message/Index" class="relative flex items-center text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </a>
                <div class="relative flex items-center text-gray-500">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                </div>
                <div class="relative" id="profile-wrapper">
                    <button onclick="toggleProfileDrop()" class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 focus:outline-none transition">
                        <span class="text-sm font-medium text-gray-700 hidden sm:inline">@(!string.IsNullOrWhiteSpace(Model?.FirstName) ? Model.FirstName : Model?.UserName)</span>
                        <div class="w-7 h-7 rounded-full overflow-hidden flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background-color:#000147;">
                            @if (!string.IsNullOrEmpty(Model?.ProfilePicture))
                            {
                                <img src="@Model.ProfilePicture" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                @(userName.Length > 0 ? userName[0].ToString().ToUpper() : "S")
                            }
                        </div>
                    </button>
                    <div id="profile-drop" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-gray-200 z-50 overflow-hidden">
                        <div class="px-4 py-4 border-b border-gray-100 flex items-center gap-3">
                            <div class="w-12 h-12 rounded-full overflow-hidden flex items-center justify-center text-white text-lg font-bold flex-shrink-0" style="background-color:#000147;">
                                @if (!string.IsNullOrEmpty(Model?.ProfilePicture))
                                {
                                    <img src="@Model.ProfilePicture" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    @(userName.Length > 0 ? userName[0].ToString().ToUpper() : "S")
                                }
                            </div>
                            <div class="min-w-0">
                                <a href="/Student/Profile" class="text-sm font-semibold text-gray-900 hover:underline truncate block">@userName</a>
                                <p class="text-xs text-gray-400 truncate">@Model?.Email</p>
                                <span class="text-[10px] bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-semibold mt-1 inline-block">@(Model?.UserType ?? "Student")</span>
                            </div>
                        </div>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="px-2 py-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 hover:bg-red-50 rounded-lg transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <div class="p-6 sm:p-8">
            @if (TempData["Success"] != null)
            {
                <div class="mb-5 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm max-w-2xl">✓ @TempData["Success"]</div>
            }

            <div class="max-w-2xl space-y-6">

                <!-- Avatar Card -->
                <div class="bg-white rounded-2xl shadow p-8 flex items-center gap-6">
                    <div class="relative flex-shrink-0">
                        <div id="avatarPreview" class="w-24 h-24 rounded-full overflow-hidden flex items-center justify-center text-white text-3xl font-bold" style="background-color:#000147;">
                            @if (!string.IsNullOrEmpty(Model?.ProfilePicture))
                            {
                                <img src="@Model.ProfilePicture" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <span>@(Model?.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "S")</span>
                            }
                        </div>
                        <button type="button" onclick="document.getElementById('profilePictureInput').click()"
                                class="absolute bottom-0 right-0 w-7 h-7 rounded-full bg-white border border-gray-300 flex items-center justify-center hover:bg-gray-50 shadow">
                            <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 112.828 2.828L11.828 15.828a4 4 0 01-1.414.94l-3.414 1.138 1.138-3.414a4 4 0 01.94-1.414z"/>
                            </svg>
                        </button>
                    </div>
                    <div>
                        <p class="text-base font-bold text-gray-800">@userName</p>
                        <p class="text-sm text-gray-400">@Model?.Email</p>
                        <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-semibold mt-1 inline-block">@(Model?.UserType ?? "Student")</span>
                    </div>
                </div>

                <!-- Account Info (read-only document style) -->
                <div class="bg-white rounded-2xl shadow p-8 space-y-6">
                    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Account Information</h2>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div>
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">First Name</p>
                            <p class="text-sm font-semibold text-gray-800">@(string.IsNullOrEmpty(Model?.FirstName) ? "—" : Model.FirstName)</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Middle Name</p>
                            <p class="text-sm font-semibold text-gray-800">@(string.IsNullOrEmpty(Model?.MiddleName) ? "—" : Model.MiddleName)</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Last Name</p>
                            <p class="text-sm font-semibold text-gray-800">@(string.IsNullOrEmpty(Model?.LastName) ? "—" : Model.LastName)</p>
                        </div>
                    </div>

                    <div class="border-t border-gray-100 pt-5">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Email</p>
                        <p class="text-sm font-semibold text-gray-800">@Model?.Email</p>
                    </div>

                    <div class="border-t border-gray-100 pt-5">
                        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Phone Number</p>
                        <p class="text-sm font-semibold text-gray-800">@(string.IsNullOrEmpty(Model?.PhoneNumber) ? "—" : Model.PhoneNumber)</p>
                    </div>

                    <div class="border-t border-gray-100 pt-5 grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Student Number</p>
                            <p class="text-sm font-semibold text-gray-800">@(string.IsNullOrEmpty(Model?.StudentNumber) ? "—" : Model.StudentNumber)</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Section</p>
                            <p class="text-sm font-semibold text-gray-800">@(string.IsNullOrEmpty(Model?.Section) ? "—" : Model.Section)</p>
                        </div>
                    </div>

                    <div class="border-t border-gray-100 pt-5 grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">RFID Card No.</p>
                            <p class="text-sm font-semibold text-gray-800">@(string.IsNullOrEmpty(Model?.RFIDNumber) ? "—" : Model.RFIDNumber)</p>
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-1">Member Since</p>
                            <p class="text-sm font-semibold text-gray-800">@Model?.CreatedAt.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
</div>

<script>
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const isOpen = !sidebar.classList.contains('-translate-x-full');
    if (isOpen) { sidebar.classList.add('-translate-x-full'); backdrop.classList.add('hidden'); }
    else { sidebar.classList.remove('-translate-x-full'); backdrop.classList.remove('hidden'); }
}
function toggleProfileDrop() { document.getElementById('profile-drop').classList.toggle('hidden'); }
document.addEventListener('click', function(e) {
    if (!e.target.closest('#profile-wrapper')) document.getElementById('profile-drop')?.classList.add('hidden');
});

function onPhotoChosen(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        document.getElementById('modalAvatar').innerHTML =
            `<img src="${e.target.result}" class="w-full h-full object-cover" />`;
        document.getElementById('photoModal').classList.remove('hidden');
    };
    reader.readAsDataURL(input.files[0]);
}
function cancelPhoto() {
    document.getElementById('photoModal').classList.add('hidden');
    document.getElementById('profilePictureInput').value = '';
    const av = document.getElementById('modalAvatar');
    av.innerHTML = `@(string.IsNullOrEmpty(Model?.ProfilePicture) ? (Model?.FirstName?.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "S") : $"<img src='{Model.ProfilePicture}' class='w-full h-full object-cover' />")`;
}
function submitPhoto() {
    document.getElementById('photoForm').submit();
}
</script>
</body>
</html>
