@{
    var userType = ViewBag.UserType as string ?? "";
    Layout = userType == "MIS"      ? "~/Views/Shared/_MISLayout.cshtml"
           : userType == "Student" || userType == "Professor" ? "~/Views/Shared/_UserHeaderLayout.cshtml"
           : "~/Views/Shared/_LibrarianLayout.cshtml";
    ViewData["Title"] = "Messages";
    var me = ViewBag.Me as BookHiveLibrary.Models.ApplicationUser;
    var allUsers = ViewBag.AllUsers as List<BookHiveLibrary.Models.ApplicationUser>;
    var withUserId = ViewBag.WithUserId as string;
}

<div class="flex gap-4 h-[calc(100vh-112px)]">

    <!-- â”€â”€ Left sidebar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="w-72 flex-shrink-0 bg-white rounded-xl border border-gray-200 shadow-sm flex flex-col overflow-hidden">

        <!-- Header -->
        <div class="px-4 py-3.5 flex-shrink-0" style="background:#000147;">
            <p class="text-sm font-semibold text-white">Messages</p>
        </div>

        <!-- Search -->
        <div class="p-3 border-b border-gray-100 flex-shrink-0">
            <div class="relative">
                <div class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                    </svg>
                </div>
                <input type="text" id="userSearch" placeholder="Search to start message..." autocomplete="off"
                       class="w-full border border-gray-200 rounded-lg pl-8 pr-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 bg-gray-50"
                       oninput="filterUsers(this.value)" onfocus="showDropdown()" />
                <div id="userDropdown"
                     class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-gray-200 rounded-xl shadow-xl z-50 max-h-52 overflow-y-auto">
                    @if (allUsers != null)
                    {
                        foreach (var u in allUsers.Where(u => u.UserType != "MIS"))
                        {
                            <div class="user-option px-3 py-2.5 text-sm cursor-pointer hover:bg-blue-50 flex items-center gap-3 transition"
                                 data-id="@u.Id"
                                 data-name="@u.FirstName @u.LastName"
                                 data-type="@u.UserType"
                                 onclick="selectUser('@u.Id', '@(u.FirstName) @(u.LastName)', '@u.UserType')">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:#000147;">
                                    @(u.FirstName?.Length > 0 ? u.FirstName[0].ToString().ToUpper() : "?")
                                </div>
                                <div class="min-w-0">
                                    <p class="font-medium text-gray-800 truncate">@u.FirstName @u.LastName</p>
                                    <p class="text-xs text-gray-400">@u.UserType</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Conversation list -->
        <div id="convoList" class="flex-1 overflow-y-auto divide-y divide-gray-100">
            <p class="px-4 py-8 text-center text-xs text-gray-400">Loading…</p>
        </div>
    </div>

    <!-- â”€â”€ Right: active conversation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="flex-1 bg-white rounded-xl border border-gray-200 shadow-sm flex flex-col overflow-hidden">

        <!-- Chat header -->
        <div id="chatHeader" class="px-5 py-3.5 flex items-center gap-3 flex-shrink-0" style="background:#000147;">
            <div id="chatAvatar" class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0 bg-white/20 hidden"></div>
            <div class="flex-1 min-w-0">
                <p id="chatName" class="text-sm font-semibold text-white truncate">Select a conversation</p>
                <p id="chatType" class="text-xs text-blue-300"></p>
            </div>
        </div>

        <!-- Messages -->
        <div id="chatMessages" class="flex-1 overflow-y-auto px-5 py-4 space-y-2 bg-gray-50">
            <div class="flex items-center justify-center h-full">
                <p class="text-sm text-gray-400">Select a conversation to start messaging</p>
            </div>
        </div>

        <!-- Input -->
        <div class="px-4 py-3 border-t border-gray-100 bg-white flex gap-2 flex-shrink-0">
            <form id="msgForm" class="flex gap-2 w-full" onsubmit="sendMessage(event)">
                <div class="hidden">@Html.AntiForgeryToken()</div>
                <input type="hidden" id="currentReceiverId" />
                <input type="text" id="msgInput" placeholder="Type a message" autocomplete="off" disabled
                       class="flex-1 border border-gray-200 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 bg-gray-50 disabled:opacity-60" />
                <button type="submit" id="sendBtn" disabled
                        class="px-5 py-2 text-white rounded-xl text-sm font-medium disabled:opacity-40 transition hover:opacity-90 flex-shrink-0" style="background:#000147;">
                    Send
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const myId = '@me?.Id';
let activeUserId = '@withUserId' || null;
let pollTimer = null;

// â”€â”€ Helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function escHtml(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
const token = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

// â”€â”€ Sidebar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function convoRow(c) {
    const isActive = activeUserId === c.userId;
    return `<div class="flex items-center gap-3 px-4 py-3 cursor-pointer transition ${isActive ? 'bg-blue-50 msg-convo-active' : 'hover:bg-gray-50'}"
                 id="convo-${c.userId}"
                 onclick="openConversation('${c.userId}')">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0" style="background:#000147;">
            ${c.name.charAt(0).toUpperCase()}
        </div>
        <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-gray-800 truncate" id="convoname-${c.userId}">${c.name}</p>
                <span class="text-[10px] text-gray-400 ml-2 flex-shrink-0">${c.sentAt}</span>
            </div>
            <p class="text-xs text-gray-500 truncate">${c.lastMsgUnsent ? '<em class="not-italic text-gray-400">Message unsent</em>' : (c.lastMsg || '…')}</p>
        </div>
        <div class="flex items-center gap-1 flex-shrink-0">
            ${c.unread > 0 ? `<span class="w-5 h-5 rounded-full text-white text-[10px] font-bold flex items-center justify-center flex-shrink-0" style="background:#e53e3e;">${c.unread}</span>` : ''}
            <button onclick="event.stopPropagation(); showConvoMenu(event,'${c.userId}')"
                    id="dots-${c.userId}"
                    class="w-6 h-6 flex items-center justify-center rounded hover:bg-gray-200 text-gray-400 hover:text-gray-600 transition flex-shrink-0">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm0 6a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm0 6a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5z"/>
                </svg>
            </button>
        </div>
    </div>`;
}

async function loadConvoList() {
    try {
        const list = await fetch('/Message/GetConversationList').then(r => r.json());
        const el = document.getElementById('convoList');
        if (!list.length) {
            el.innerHTML = '<p class="px-4 py-8 text-center text-xs text-gray-400">No conversations yet.<br>Search above to start one.</p>';
            return;
        }
        el.innerHTML = list.map(c => convoRow(c)).join('');
    } catch {
        document.getElementById('convoList').innerHTML = '<p class="px-4 py-8 text-center text-xs text-red-400">Could not load conversations</p>';
    }
}

// â”€â”€ Convo 3-dot menu â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
let _activeConvoMenu = null;

function _ensureConvoMenuEl() {
    if (document.getElementById('globalConvoMenu')) return;
    const m = document.createElement('div');
    m.id = 'globalConvoMenu';
    m.style.cssText = 'position:fixed;z-index:9999;background:white;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);min-width:180px;overflow:hidden;font-size:13px;display:none;';
    m.innerHTML = `
        <div style="padding:7px 14px 5px;font-size:10px;font-weight:700;letter-spacing:.08em;color:#9ca3af;text-transform:uppercase;border-bottom:1px solid #f3f4f6;">Conversation</div>
        <button id="gcm-important" class="w-full text-left px-4 py-2.5 hover:bg-amber-50 flex items-center gap-3" style="color:#b45309;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/></svg>
            Mark as Important
        </button>
        <div style="height:1px;background:#f3f4f6;margin:2px 0;"></div>
        <button id="gcm-delete" class="w-full text-left px-4 py-2.5 hover:bg-red-50 flex items-center gap-3" style="color:#dc2626;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
            Delete Conversation
        </button>`;
    document.body.appendChild(m);
}

function showConvoMenu(event, userId) {
    _ensureConvoMenuEl();
    const menu = document.getElementById('globalConvoMenu');
    if (_activeConvoMenu === userId && menu.style.display !== 'none') {
        menu.style.display = 'none'; _activeConvoMenu = null; return;
    }
    _activeConvoMenu = userId;
    document.getElementById('gcm-important').onclick = (e) => { e.stopPropagation(); markImportant(userId); menu.style.display='none'; _activeConvoMenu=null; };
    document.getElementById('gcm-delete').onclick    = (e) => { e.stopPropagation(); deleteConversation(userId); menu.style.display='none'; _activeConvoMenu=null; };
    const btn  = event.target.closest('button') || event.currentTarget;
    const rect = btn ? btn.getBoundingClientRect() : { right: event.clientX, bottom: event.clientY };
    menu.style.display = 'block';
    menu.style.left = Math.min(rect.right - 180, window.innerWidth - 190) + 'px';
    menu.style.top  = Math.min(rect.bottom + 4, window.innerHeight - 100) + 'px';
}

function markImportant(userId) {
    const el = document.getElementById('convoname-' + userId);
    if (el && !el.textContent.startsWith('â­')) el.textContent = 'â­ ' + el.textContent;
}

async function deleteConversation(userId) {
    if (!confirm('Delete this entire conversation? This cannot be undone.')) return;
    const fd = new FormData();
    fd.append('otherUserId', userId);
    fd.append('__RequestVerificationToken', token());
    const res = await fetch('/Message/DeleteConversation', { method: 'POST', body: fd });
    if (res.ok) {
        document.getElementById('convo-' + userId)?.remove();
        if (activeUserId === userId) {
            activeUserId = null;
            document.getElementById('chatMessages').innerHTML = '<div class="flex items-center justify-center h-full"><p class="text-sm text-gray-400">Select a conversation to start messaging</p></div>';
            document.getElementById('chatName').textContent = 'Select a conversation';
            document.getElementById('chatType').textContent = '';
            document.getElementById('chatAvatar').classList.add('hidden');
            document.getElementById('msgInput').disabled = true;
            document.getElementById('sendBtn').disabled  = true;
            clearInterval(pollTimer);
        }
    }
}

// â”€â”€ Open conversation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async function openConversation(userId) {
    if (!userId) return;
    activeUserId = userId;
    document.getElementById('currentReceiverId').value = userId;
    document.getElementById('msgInput').disabled  = false;
    document.getElementById('sendBtn').disabled   = false;
    document.getElementById('userSearch').value   = '';
    document.getElementById('userDropdown').classList.add('hidden');
    clearInterval(pollTimer);
    await fetchMessages();
    await loadConvoList();
    document.getElementById('msgInput').focus();
    pollTimer = setInterval(fetchMessages, 5000);
}

// â”€â”€ Fetch & render messages â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const _icoUnsend = `<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>`;
const _icoTrash  = `<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>`;

async function fetchMessages() {
    if (!activeUserId) return;
    try {
        const data = await fetch('/Message/GetConversation?otherUserId=' + activeUserId).then(r => r.json());

        document.getElementById('chatName').textContent = data.otherName;
        document.getElementById('chatType').textContent = data.otherType;
        const av = document.getElementById('chatAvatar');
        av.textContent = data.otherName.charAt(0).toUpperCase();
        av.classList.remove('hidden');

        const box = document.getElementById('chatMessages');
        if (!data.messages.length) {
            box.innerHTML = '<div class="flex items-center justify-center h-full"><p class="text-sm text-gray-400">No messages yet. Say hello!</p></div>';
            return;
        }

        const _menuHdr = `<div style="padding:7px 14px 5px;font-size:10px;font-weight:700;letter-spacing:.08em;color:#9ca3af;text-transform:uppercase;border-bottom:1px solid #f3f4f6;">Message</div>`;
        const _menuDiv = `<div style="height:1px;background:#f3f4f6;margin:2px 0;"></div>`;

        box.innerHTML = data.messages.map(m => {
            const isMe   = m.senderId === myId;
            const unsent = m.isUnsent;

            if (unsent) return `<div class="flex ${isMe?'justify-end':'justify-start'}" id="msg-${m.id}">
                <span class="text-xs italic text-gray-400 px-3 py-1 border border-gray-200 rounded-2xl">Message unsent</span>
            </div>`;

            const menuItems = isMe
                ? `${_menuHdr}
                   <button onclick="unsendMsg(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-red-50 flex items-center gap-3" style="font-size:13px;color:#dc2626;">
                       ${_icoUnsend} Unsend for everyone
                   </button>
                   ${_menuDiv}
                   <button onclick="deleteForMe(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-gray-50 flex items-center gap-3" style="font-size:13px;color:#6b7280;">
                       ${_icoTrash} Delete for me
                   </button>`
                : `${_menuHdr}
                   <button onclick="deleteForMe(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-gray-50 flex items-center gap-3" style="font-size:13px;color:#6b7280;">
                       ${_icoTrash} Delete for me
                   </button>`;

            return `<div class="flex ${isMe?'justify-end':'justify-start'}" id="msg-${m.id}">
                <div class="max-w-[72%] relative">
                    <div class="chat-msg-bubble px-4 py-2 rounded-2xl text-sm cursor-pointer select-none ${isMe?'text-white rounded-br-sm':'bg-white border border-gray-200 text-gray-800 rounded-bl-sm'}"
                         style="${isMe?'background-color:#000147;':''}"
                         oncontextmenu="showMsgMenu(event,'mmenu-${m.id}')"
                         ondblclick="showMsgMenu(event,'mmenu-${m.id}')">
                        ${escHtml(m.content)}
                    </div>
                    <p class="text-[10px] mt-0.5 text-gray-400 ${isMe?'text-right':''}">${m.sentAt}</p>
                    <div id="mmenu-${m.id}" class="msg-menu hidden" style="position:fixed;z-index:10001;background:white;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);min-width:175px;overflow:hidden;">
                        ${menuItems}
                    </div>
                </div>
            </div>`;
        }).join('');

        box.scrollTop = box.scrollHeight;
        updateEnvelopeBadge();
    } catch {}
}

// â”€â”€ Send â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async function sendMessage(e) {
    e.preventDefault();
    const input   = document.getElementById('msgInput');
    const content = input.value.trim();
    const receiver = document.getElementById('currentReceiverId').value;
    if (!content || !receiver) return;
    const fd = new FormData();
    fd.append('receiverId', receiver);
    fd.append('content', content);
    fd.append('__RequestVerificationToken', token());
    input.value = '';
    const res = await fetch('/Message/Send', { method: 'POST', body: fd });
    if (!res.ok) return;
    await fetchMessages();
    await loadConvoList();
}

// â”€â”€ Message context menu â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function showMsgMenu(event, menuId) {
    event.preventDefault();
    document.querySelectorAll('.msg-menu').forEach(m => m.classList.add('hidden'));
    const menu = document.getElementById(menuId); if (!menu) return;
    menu.classList.remove('hidden');
    menu.style.left = Math.min(event.clientX, window.innerWidth - 185) + 'px';
    menu.style.top  = Math.min(event.clientY + 4, window.innerHeight - 110) + 'px';
}

async function unsendMsg(id) {
    document.querySelectorAll('.msg-menu').forEach(m => m.classList.add('hidden'));
    if (!confirm('Unsend this message for everyone?')) return;
    const fd = new FormData();
    fd.append('id', id);
    fd.append('__RequestVerificationToken', token());
    const res = await fetch('/Message/Unsend', { method: 'POST', body: fd });
    if (res.ok) { await fetchMessages(); await loadConvoList(); }
}

async function deleteForMe(id) {
    document.querySelectorAll('.msg-menu').forEach(m => m.classList.add('hidden'));
    const fd = new FormData();
    fd.append('id', id);
    fd.append('__RequestVerificationToken', token());
    const res = await fetch('/Message/DeleteForMe', { method: 'POST', body: fd });
    if (res.ok) document.getElementById('msg-' + id)?.remove();
}

// â”€â”€ Badge sync â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async function updateEnvelopeBadge() {
    try {
        const data  = await fetch('/Message/UnreadCount').then(r => r.json());
        const badge = document.getElementById('msgBadge');
        if (!badge) return;
        if (data.count > 0) { badge.textContent = data.count > 9 ? '9+' : data.count; badge.classList.remove('hidden'); }
        else badge.classList.add('hidden');
    } catch {}
}

// â”€â”€ User search dropdown â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function showDropdown() { document.getElementById('userDropdown').classList.remove('hidden'); }

function filterUsers(query) {
    const q = query.toLowerCase().trim();
    document.getElementById('userDropdown').classList.remove('hidden');
    document.querySelectorAll('.user-option').forEach(el => {
        const name = el.getAttribute('data-name').toLowerCase();
        const type = el.getAttribute('data-type').toLowerCase();
        el.style.display = (name.includes(q) || type.includes(q)) ? '' : 'none';
    });
}

function selectUser(id, name, type) {
    document.getElementById('userSearch').value = '';
    document.getElementById('userDropdown').classList.add('hidden');
    openConversation(id);
}

// â”€â”€ Close menus on outside click â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
document.addEventListener('click', function(e) {
    if (!e.target.closest('.msg-menu') && !e.target.closest('.chat-msg-bubble'))
        document.querySelectorAll('.msg-menu').forEach(m => m.classList.add('hidden'));
    const gcm = document.getElementById('globalConvoMenu');
    if (gcm && !e.target.closest('#globalConvoMenu') && !e.target.closest('[id^="dots-"]')) {
        gcm.style.display = 'none'; _activeConvoMenu = null;
    }
    if (!e.target.closest('#userSearch') && !e.target.closest('#userDropdown'))
        document.getElementById('userDropdown')?.classList.add('hidden');
});

