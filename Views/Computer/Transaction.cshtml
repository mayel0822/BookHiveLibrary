@using BookHiveLibrary.Models
@model IEnumerable<ComputerUnit>
@{
    Layout = "~/Views/Shared/_LibrarianLayout.cshtml";
    ViewData["Title"] = "Transaction Management - Computer";
    var advisers     = ViewBag.SectionAdvisers as Dictionary<string,string> ?? new Dictionary<string,string>();
    var activeSessions = Model.Select(pc => new {
        pc,
        sess = pc.Sessions.FirstOrDefault(s => s.IsActive)
    }).Where(x => x.sess != null).ToList();
}

@if (TempData["Error"] != null)
{
    <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm">@TempData["Error"]</div>
}

<!-- Stats Row -->
<div class="grid grid-cols-5 gap-4 mb-6">
    <div class="rounded-xl p-4 text-white text-center" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Total Computers</p>
        <p class="text-3xl font-bold text-center">@ViewBag.TotalComputers</p>
    </div>
    <div class="rounded-xl p-4 text-white text-center" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Available</p>
        <p class="text-3xl font-bold text-center">@ViewBag.AvailableComputers</p>
    </div>
    <div class="rounded-xl p-4 text-white text-center" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">In Use</p>
        <p class="text-3xl font-bold text-center">@ViewBag.InUseComputers</p>
    </div>
    <div class="rounded-xl p-4 text-white text-center" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Unavailable</p>
        <p class="text-3xl font-bold text-center">@ViewBag.UnavailableComputers</p>
    </div>
    <div class="rounded-xl p-4 text-white text-center" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Archived</p>
        <p class="text-3xl font-bold text-center">@ViewBag.ArchivedComputers</p>
    </div>
</div>

<!-- Main layout: LEFT = Computer Usage + Computer Access | RIGHT = Active Session -->
<div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-5">

    <!-- ── LEFT column ──────────────────────────────────────────────────── -->
    <div class="flex flex-col gap-5 min-w-0" id="computerLeftCol">

        <!-- Computer Usage Grid (shared partial) -->
        @{ ViewData["IsTransaction"] = true; }
        @await Html.PartialAsync("_ComputerGrid", Model)

        <!-- Computer Access / Student Info Panel -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col" style="height:280px;overflow:hidden;">
            <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-2 flex-shrink-0">
                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                <div>
                    <h3 class="font-bold text-gray-900 leading-tight">Computer Access</h3>
                    <p class="text-xs text-gray-400">Student information</p>
                </div>
            </div>
            <div class="flex-1 min-h-0 overflow-x-auto overflow-y-scroll">
                <!-- A plain wrapper div (not the table) gets min-height so leftover
                     space stays blank below the rows instead of stretching them —
                     see the same pattern/reasoning on the Borrowed Books table. -->
                <div style="min-height:100%;">
                <table class="bh-table text-xs w-full">
                    <thead>
                        <tr>
                            <th>PC</th>
                            <th>Name</th>
                            <th>Section</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!activeSessions.Any())
                        {
                            <tr><td colspan="3" class="px-3 py-8 text-center text-gray-400">No active sessions</td></tr>
                        }
                        @foreach (var x in activeSessions)
                        {
                            <tr>
                                <td class="px-3 py-2.5 font-semibold text-gray-700">@x.pc.ComputerNumber</td>
                                <td class="px-3 py-2.5 text-gray-700 max-w-[120px] truncate">@x.sess!.User?.LastName, @x.sess.User?.FirstName</td>
                                <td class="px-3 py-2.5 text-gray-500">@(x.sess.User?.Section ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ── RIGHT column: Active Session panel — height set via JS
         (syncComputerColumnHeights in the Scripts section) to match the left
         column's rendered height. CSS grid's align-items:stretch alone doesn't
         cap this panel's intrinsic size: with enough active sessions the
         un-capped session list would just grow the whole row taller instead of
         scrolling, the same nested-flex-in-grid quirk documented on the Book
         Register form's two columns. -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col" id="activeSessionCard">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
                <h3 class="font-bold text-gray-900">Active Session</h3>
            </div>
            <span class="w-8 h-8 flex items-center justify-center text-sm font-bold text-white rounded-full" style="background:#000147;">@activeSessions.Count</span>
        </div>

        <!-- RFID tap to find & highlight a student's session -->
        <div class="px-4 py-3 border-b border-gray-100 bg-gray-50 flex-shrink-0">
            <div id="sessionRfidWrap" class="flex rounded-lg overflow-hidden border border-gray-300 transition-all duration-200">
                <input id="sessionRfidInput" type="text"
                       placeholder="Student Number will show here"
                       class="flex-1 px-4 py-2.5 text-sm text-gray-600 bg-white focus:outline-none"
                       autocomplete="off" readonly />
                <button id="sessionRfidBtn" type="button" onclick="activateSessionRfid()"
                        class="px-4 py-2.5 text-sm font-semibold text-white flex-shrink-0 transition-colors duration-200"
                        style="background-color:#000147;">
                    Tap RFID Card
                </button>
            </div>
            <p id="sessionRfidError" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>

        <!-- Session list — scrollable, grows to fill panel height -->
        <div class="divide-y divide-gray-100 overflow-y-scroll flex-1 min-h-0">
            @if (!activeSessions.Any())
            {
                <p class="px-5 py-10 text-center text-sm text-gray-400">No active sessions</p>
            }
            @foreach (var x in activeSessions)
            {
                var totalAllowed  = x.sess!.AllowedMinutes + x.sess.ExtendedMinutes;
                var sessSect      = x.sess.User?.Section ?? "";
                var sessAdviser   = (!string.IsNullOrEmpty(sessSect) && advisers.TryGetValue(sessSect, out var sa)) ? sa : "";
                <div class="session-row px-4 py-3 transition-all duration-300"
                     data-student-no="@x.sess.User?.StudentNumber"
                     data-employee-no="@x.sess.User?.EmployeeNumber">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="px-2 py-0.5 text-xs font-bold rounded" style="background:#000147; color:white;">@x.pc.ComputerNumber</span>
                        <p class="text-sm font-medium text-gray-800 truncate">@x.sess.User?.LastName, @x.sess.User?.FirstName</p>
                    </div>
                    <span class="session-timer text-xl font-bold tabular-nums block mb-2" style="color:#111827;"
                          data-start="@x.sess.StartTime.ToUniversalTime().ToString("o")"
                          data-allowed="@(totalAllowed * 60)"
                          data-sessid="@x.sess.Id">00:00:00</span>
                    <div class="flex items-center gap-1 mb-1.5">
                        <span class="text-xs text-gray-400">Time left</span>
                        <span class="time-left-val flex-1 text-xs font-medium text-gray-800 tabular-nums"
                              data-sessid="@x.sess.Id"
                              data-allowed="@(totalAllowed * 60)"
                              data-start="@x.sess.StartTime.ToUniversalTime().ToString("o")">—</span>
                        <div class="relative">
                            <button onclick="toggleExtendPopup('@x.sess.Id', event)"
                                    class="w-5 h-5 rounded-full border border-gray-300 text-gray-500 hover:border-blue-400 hover:text-blue-600 flex items-center justify-center text-sm font-bold">+</button>
                            <div id="extpop-@x.sess.Id"
                                 class="hidden absolute right-0 bottom-full mb-2 bg-white border border-gray-200 rounded-xl shadow-lg p-3 z-50 whitespace-nowrap">
                                <p class="text-xs text-gray-400 mb-2 font-medium">Extend time by</p>
                                <div class="flex gap-2">
                                    @foreach (var mins in new[] { 15, 30, 60 })
                                    {
                                        <button onclick="extendTime(@x.sess.Id, @mins, this)"
                                                class="px-2.5 py-1 text-xs font-medium rounded-lg border border-gray-200 text-gray-600 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-700">
                                            +@mins min
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="w-full bg-gray-100 rounded-full h-1.5 mb-2">
                        <div class="progress-bar h-1.5 rounded-full transition-all"
                             style="width:0%; background:#000147;"
                             data-start="@x.sess.StartTime.ToUniversalTime().ToString("o")"
                             data-allowed="@(totalAllowed * 60)"></div>
                    </div>
                    <!-- End Session button -->
                    <div class="flex justify-end">
                        <button onclick="endSessionFromPanel(@x.sess.Id, '@x.pc.ComputerNumber', '@(x.sess.User?.LastName)', '@(x.sess.User?.FirstName)', '@(x.sess.User?.MiddleName ?? "")', '@sessSect', '@sessAdviser', '@x.sess.StartTime.ToUniversalTime().ToString("o")')"
                                class="px-3 py-1.5 text-xs font-semibold text-white rounded-lg bg-red-500 hover:bg-red-600 transition">
                            End Session
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<!-- ── End Session Confirm Dialog ─────────────────────────────────────── -->
<div id="endSessionConfirm" class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-2xl shadow-2xl w-80 mx-4 overflow-hidden">
        <!-- Icon + message -->
        <div class="px-6 pt-6 pb-4 text-center">
            <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                </svg>
            </div>
            <h3 class="text-base font-bold text-gray-900 mb-1">End Session?</h3>
            <p class="text-sm text-gray-500">End the session for <span id="confirmStudentName" class="font-semibold text-gray-700"></span> on <span id="confirmPcName" class="font-semibold text-gray-700"></span>?</p>
        </div>
        <input type="hidden" id="slipSessionId" />
        <!-- Buttons -->
        <div class="px-6 pb-5 flex gap-3">
            <button onclick="closeSlipModal()" class="flex-1 px-4 py-2.5 text-sm font-medium border border-gray-300 text-gray-700 rounded-xl hover:bg-gray-50 transition">Cancel</button>
            <button onclick="confirmEndSessionFromSlip()" id="confirmEndBtn"
                    class="flex-1 px-4 py-2.5 text-sm font-semibold text-white rounded-xl bg-red-500 hover:bg-red-600 transition">
                End Session
            </button>
        </div>
    </div>
</div>

<!-- ── Assign Computer / Computer Use Slip Modal ──────────────────────── -->
<div id="assignModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden px-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl overflow-hidden">

        <!-- Header -->
        <div class="px-6 py-4 flex items-center justify-between" style="background-color:#000147;">
            <div>
                <h3 class="text-base font-semibold text-white">Computer Use Slip</h3>
                <p class="text-xs text-white/60 mt-0.5" id="assignPcLabel">—</p>
            </div>
            <button type="button" onclick="closeAssignModal()" class="text-white/60 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <form method="post" action="@Url.Action("StartSession","Computer")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="computerId" id="assignComputerId" />
            <input type="hidden" name="userId"     id="assignUserId" />

            <div class="px-6 pt-5 pb-4">

                <!-- RFID Tap -->
                <div class="mb-5">
                    <p class="text-xs text-gray-400 mb-1.5">RFID Card</p>
                    <div id="assignRfidWrap" class="flex rounded-lg overflow-hidden border border-gray-300 transition-all duration-200">
                        <input id="assignRfidInput" type="text" placeholder=""
                               class="flex-1 px-4 py-2.5 text-sm outline-none bg-white text-gray-700"
                               autocomplete="off" readonly />
                        <button id="assignRfidBtn" type="button" onclick="activateAssignRfid()"
                                class="px-4 py-2.5 text-sm font-semibold text-white flex-shrink-0 transition-colors duration-200"
                                style="background-color:#000147;">
                            Tap RFID Card
                        </button>
                    </div>
                    <p id="assignRfidError" class="text-xs text-red-500 mt-1.5 hidden"></p>
                </div>

                <!-- Dashed divider -->
                <div class="border-t border-dashed border-gray-200 mb-5"></div>

                <!-- Slip fields — 3-column grid -->
                <div class="grid grid-cols-3 gap-x-6 gap-y-4 text-sm">
                    <!-- Row 1: Student No. (full width) -->
                    <div class="col-span-3">
                        <p class="text-xs text-gray-400 mb-0.5">Student / Employee No.</p>
                        <p id="assignStudentNo" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                    </div>
                    <!-- Row 2: Last Name | First Name | M.I. -->
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Last Name</p>
                        <p id="assignLastName" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">First Name</p>
                        <p id="assignFirstName" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">M.I.</p>
                        <p id="assignMI" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                    </div>
                    <!-- Row 3: Section | Adviser (spans 2) -->
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Section</p>
                        <p id="assignSection" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                    </div>
                    <div class="col-span-2">
                        <p class="text-xs text-gray-400 mb-0.5">Adviser</p>
                        <p id="assignAdviser" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                    </div>
                    <!-- Row 4: Date | Time | Time Limit | Session End -->
                    <div class="col-span-3 grid grid-cols-4 gap-x-6">
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Date</p>
                            <p id="assignDate" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Time</p>
                            <p id="assignTime" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Time Limit</p>
                            <p class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1">1 hour</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Session End</p>
                            <p id="assignSessionEnd" class="font-medium text-red-500 min-h-[1.25rem] border-b border-gray-200 pb-1">—</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="px-6 py-4 border-t border-gray-100 flex gap-3">
                <button type="button" onclick="closeAssignModal()" class="btn-secondary flex-1 justify-center">Cancel</button>
                <button type="submit" id="assignSubmitBtn" disabled
                        class="btn-primary flex-1 justify-center opacity-50 cursor-not-allowed">
                    Start Session
                </button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
<script>
// Match the Active Session card's height to the left column (Computer Usage +
// Computer Access) so it has an actual ceiling — CSS grid's align-items:stretch
// alone doesn't cap it, since the row's own auto-height is based on each
// item's uncapped intrinsic size; with enough active sessions the whole card
// would just keep growing instead of the session list scrolling internally.
// Re-runs on resize and whenever the left column's own height changes.
function syncComputerColumnHeights() {
    const leftCol = document.getElementById('computerLeftCol');
    const rightCard = document.getElementById('activeSessionCard');
    if (!leftCol || !rightCard) return;
    if (window.matchMedia('(min-width: 1024px)').matches) {
        rightCard.style.height = leftCol.offsetHeight + 'px';
    } else {
        rightCard.style.height = '';
    }
}
window.addEventListener('resize', syncComputerColumnHeights);
window.addEventListener('load', syncComputerColumnHeights);
(function() {
    const leftCol = document.getElementById('computerLeftCol');
    if (leftCol && window.ResizeObserver) {
        new ResizeObserver(syncComputerColumnHeights).observe(leftCol);
    }
    syncComputerColumnHeights();
})();

// Declare before tickAll() so the let is not in temporal dead zone when tickAll() is called immediately
let slipStartISO = null;

function fmt(startISO) {
    const s = Math.floor((Date.now() - new Date(startISO)) / 1000);
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
    return String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(sec).padStart(2,'0');
}

function tickAll() {
    // Duration badges on PC cards
    document.querySelectorAll('.duration-badge').forEach(el => el.textContent = fmt(el.dataset.start));

    // Slip modal duration
    if (slipStartISO) document.getElementById('slipDuration').textContent = fmt(slipStartISO);

    // Active session timers + progress bars
    document.querySelectorAll('.session-timer').forEach(el => {
        const elapsed   = Math.floor((Date.now() - new Date(el.dataset.start)) / 1000);
        const allowed   = parseInt(el.dataset.allowed);
        const pct       = Math.min(elapsed / allowed * 100, 100);
        const remaining = allowed - elapsed;

        el.textContent = fmt(el.dataset.start);

        // Timer always black
        el.style.color = '#111827';

        if (remaining <= 0 && !el.dataset.autoending) {
            el.dataset.autoending = '1';
            autoEndSession(parseInt(el.dataset.sessid), el.closest('.px-4.py-3'));
        }

        // Progress bar for same session
        const bar = document.querySelector(`.progress-bar[data-start="${el.dataset.start}"]`);
        if (bar) {
            bar.style.width = pct + '%';
            bar.style.background = remaining <= 0 ? '#dc2626' : remaining <= 600 ? '#d97706' : '#000147';
        }

        // Time left label (always black text)
        const tlv = document.querySelector(`.time-left-val[data-start="${el.dataset.start}"]`);
        if (tlv) {
            if (remaining <= 0) {
                tlv.textContent = 'Expired';
            } else {
                const h = Math.floor(remaining / 3600);
                const m = Math.floor((remaining % 3600) / 60);
                const s = remaining % 60;
                if (h > 0) tlv.textContent = h + 'h ' + m + 'm left';
                else if (m > 0) tlv.textContent = m + ' min ' + (s ? s + 's ' : '') + 'left';
                else tlv.textContent = s + ' sec left';
            }
        }
    });
}

setInterval(tickAll, 1000);
tickAll();

// Auto-end expired session
async function autoEndSession(sessionId, rowEl) {
    try {
        const fd = new FormData();
        fd.append('sessionId', sessionId);
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        const res  = await fetch('@Url.Action("EndSessionAjax","Computer")', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
            // Fade out and remove the session row
            if (rowEl) {
                rowEl.style.transition = 'opacity .5s';
                rowEl.style.opacity = '0';
                setTimeout(() => rowEl.remove(), 500);
            }
            // Update the matching PC card to Available
            document.querySelectorAll('.duration-badge').forEach(b => {
                const card = b.closest('[class*="border rounded-xl"]');
                if (!card) return;
                // find matching card by session start — just reload to be safe
            });
            // Reload page after short delay so PC card flips to Available
            setTimeout(() => location.reload(), 1200);
        }
    } catch (e) { /* silent */ }
}

// Extend popup toggle
function toggleExtendPopup(sessId, e) {
    e.stopPropagation();
    const pop = document.getElementById('extpop-' + sessId);
    document.querySelectorAll('[id^="extpop-"]').forEach(p => { if (p !== pop) p.classList.add('hidden'); });
    pop.classList.toggle('hidden');
}
document.addEventListener('click', () => document.querySelectorAll('[id^="extpop-"]').forEach(p => p.classList.add('hidden')));

// Extend time
async function extendTime(sessionId, minutes, btn) {
    btn.disabled = true;
    btn.textContent = '...';
    try {
        const fd = new FormData();
        fd.append('sessionId', sessionId);
        fd.append('minutes', minutes);
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

        const res  = await fetch('@Url.Action("ExtendTime","Computer")', { method:'POST', body: fd });
        const data = await res.json();

        if (data.success) {
            // Update allowed seconds on timer element
            const timer = document.querySelector(`.session-timer[data-sessid="${sessionId}"]`);
            if (timer) timer.dataset.allowed = data.totalMinutes * 60;

            // Update progress bar allowed
            const bars = document.querySelectorAll(`.progress-bar`);
            bars.forEach(b => {
                const t = document.querySelector(`.session-timer[data-start="${b.dataset.start}"]`);
                if (t && t.dataset.sessid == sessionId) b.dataset.allowed = data.totalMinutes * 60;
            });

            // Close popup
            const pop = document.getElementById('extpop-' + sessionId);
            if (pop) pop.classList.add('hidden');

            // Sync time-left-val data-allowed
            const tlv = document.querySelector(`.time-left-val[data-sessid="${sessionId}"]`);
            if (tlv) tlv.dataset.allowed = data.totalMinutes * 60;

            btn.textContent = '+' + minutes + ' min';
            btn.style.background = '#dcfce7';
            btn.style.borderColor = '#86efac';
            btn.style.color = '#166534';
            setTimeout(() => {
                btn.style.background = '';
                btn.style.borderColor = '';
                btn.style.color = '';
                btn.disabled = false;
            }, 2000);
        }
    } catch (e) {
        btn.textContent = '+' + minutes + ' min';
        btn.disabled = false;
    }
}

// slipStartISO kept for the duration badge ticker (no longer used by a slip modal)
function showSlip() { /* replaced by endSessionFromPanel confirm dialog */ }

// ── Assign Computer ───────────────────────────────────────────────────────────
function _setAssignFields(val) {
    ['assignStudentNo','assignLastName','assignFirstName','assignMI','assignSection','assignAdviser'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
    });
}

function fillAssignInfo(data) {
    document.getElementById('assignStudentNo').textContent = data.studentNumber || '—';
    document.getElementById('assignLastName').textContent  = data.lastName      || '—';
    document.getElementById('assignFirstName').textContent = data.firstName     || '—';
    document.getElementById('assignMI').textContent        = data.middleName    ? data.middleName[0] + '.' : '—';
    document.getElementById('assignSection').textContent   = data.section       || '—';
    document.getElementById('assignAdviser').textContent   = data.adviserName   || '—';
    document.getElementById('assignUserId').value          = data.userId;
    // Show student number in RFID field as confirmation
    const rfidEl = document.getElementById('assignRfidInput');
    if (rfidEl) { rfidEl.value = data.studentNumber || ''; deactivateAssignRfid(); }
    // Enable submit
    const btn = document.getElementById('assignSubmitBtn');
    btn.disabled = false;
    btn.classList.remove('opacity-50', 'cursor-not-allowed');
}

function openAssignModal(pcId, pcNo) {
    document.getElementById('assignComputerId').value = pcId;
    document.getElementById('assignPcLabel').textContent = 'PC No. ' + pcNo;
    document.getElementById('assignUserId').value = '';
    // Reset RFID input
    const rfidEl = document.getElementById('assignRfidInput');
    if (rfidEl) { rfidEl.value = ''; deactivateAssignRfid(); }
    document.getElementById('assignRfidError').classList.add('hidden');
    // Reset slip fields
    _setAssignFields('—');
    // Set date/time and session end in PHT (UTC+08:00)
    const PHT = 'Asia/Kuala_Lumpur';
    const now = new Date();
    document.getElementById('assignDate').textContent = new Intl.DateTimeFormat('en-US', {
        timeZone: PHT, month: '2-digit', day: '2-digit', year: 'numeric'
    }).format(now);
    document.getElementById('assignTime').textContent = new Intl.DateTimeFormat('en-US', {
        timeZone: PHT, hour: '2-digit', minute: '2-digit', hour12: true
    }).format(now);
    const sessionEnd = new Date(now.getTime() + 60 * 60 * 1000); // +1 hour
    document.getElementById('assignSessionEnd').textContent = new Intl.DateTimeFormat('en-US', {
        timeZone: PHT, hour: '2-digit', minute: '2-digit', hour12: true
    }).format(sessionEnd);
    // Disable submit until RFID tapped
    const btn = document.getElementById('assignSubmitBtn');
    btn.disabled = true;
    btn.classList.add('opacity-50', 'cursor-not-allowed');
    // Show modal and focus RFID input
    document.getElementById('assignModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('assignRfidInput')?.focus(), 80);
}

function closeAssignModal() {
    document.getElementById('assignModal').classList.add('hidden');
    clearTimeout(_rfidTimer);
    const rfidEl = document.getElementById('assignRfidInput');
    if (rfidEl) rfidEl.value = '';
}


// ── RFID Lookup ───────────────────────────────────────────────────────────────
async function lookupAssignRfid(rfid) {
    const errEl  = document.getElementById('assignRfidError');
    const rfidEl = document.getElementById('assignRfidInput');
    errEl.classList.add('hidden');
    if (rfidEl) rfidEl.placeholder = 'Looking up…';
    try {
        const res  = await fetch('@Url.Action("FindUserByRfid","Computer")?rfid=' + encodeURIComponent(rfid));
        const data = await res.json();
        if (!data.found) {
            errEl.textContent = data.message || 'Card not found.';
            errEl.classList.remove('hidden');
            if (rfidEl) { rfidEl.value = ''; deactivateAssignRfid(); }
        } else {
            fillAssignInfo(data);
        }
    } catch (e) {
        errEl.textContent = 'Server error. Please try again.';
        errEl.classList.remove('hidden');
        if (rfidEl) { rfidEl.value = ''; deactivateAssignRfid(); }
    }
}

// ── RFID tap button ────────────────────────────────────────────────────────────
let _rfidBuf       = '';
let _rfidTimer     = null;
let _rfidListening = false;

function activateAssignRfid() {
    _rfidListening = true;
    const inp  = document.getElementById('assignRfidInput');
    const wrap = document.getElementById('assignRfidWrap');
    const btn  = document.getElementById('assignRfidBtn');
    inp.readOnly = false;
    inp.value = '';
    wrap.style.borderColor = '#3b82f6';
    wrap.style.boxShadow = '0 0 0 2px rgba(59,130,246,.25)';
    btn.style.backgroundColor = '#1d4ed8';
    btn.textContent = 'Scanning...';
    inp.focus();
}

function deactivateAssignRfid() {
    _rfidListening = false;
    const inp  = document.getElementById('assignRfidInput');
    const wrap = document.getElementById('assignRfidWrap');
    const btn  = document.getElementById('assignRfidBtn');
    inp.readOnly = true;
    wrap.style.borderColor = '';
    wrap.style.boxShadow = '';
    btn.style.backgroundColor = '#000147';
    btn.textContent = 'Tap RFID Card';
}

const _assignRfidEl = document.getElementById('assignRfidInput');
if (_assignRfidEl) {
    _assignRfidEl.addEventListener('keydown', function(e) {
        if (!_rfidListening) return;
        if (e.key === 'Enter') {
            e.preventDefault();
            const v = _rfidBuf.trim();
            _rfidBuf = '';
            clearTimeout(_rfidTimer);
            if (v.length >= 2) lookupAssignRfid(v);
        }
    });

    _assignRfidEl.addEventListener('input', function() {
        if (!_rfidListening) return;
        _rfidBuf = this.value;
        clearTimeout(_rfidTimer);
        _rfidTimer = setTimeout(() => {
            const v = _rfidBuf.trim();
            _rfidBuf = '';
            if (v.length >= 4) lookupAssignRfid(v);
        }, 200);
    });
}

// No auto-focus; field is read-only until button clicked
document.addEventListener('click', function(e) {
    const modal = document.getElementById('assignModal');
    if (!modal || modal.classList.contains('hidden')) return;
    if (!e.target.closest('#assignModal')) return;
});

// ── SignalR: desk RFID reader (primary path) ──────────────────────────────────
function _joinTransaction() {
    console.log('[SignalR] Joining transaction group...');
    libraryConnection.invoke('JoinTransaction')
        .then(() => console.log('[SignalR] Joined transaction group OK'))
        .catch(err => console.error('JoinTransaction error:', err));
}

if (typeof libraryConnection !== 'undefined') {
    // Join on initial connect
    (window._libConnected || Promise.resolve()).then(_joinTransaction);

    // Re-join after every reconnect — Azure SignalR drops group memberships on reconnect
    libraryConnection.onreconnected(() => _joinTransaction());

    libraryConnection.on('DeskRfidTap', function(data) {
        const modal = document.getElementById('assignModal');
        if (!modal || modal.classList.contains('hidden')) return;
        clearTimeout(_rfidTimer);
        _rfidListening = true;
        const rfidEl = document.getElementById('assignRfidInput');
        if (rfidEl) rfidEl.readOnly = false;
        lookupAssignRfid(data.rfidNumber);
    });
}

// ── Toggle Availability ───────────────────────────────────────────────────
async function toggleAvailability(computerId, btn) {
    btn.disabled = true;
    try {
        const fd = new FormData();
        fd.append('id', computerId);
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        const res  = await fetch('@Url.Action("ToggleAvailability","Computer")', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
            // Reload so the card fully re-renders with updated state
            location.reload();
        } else {
            alert(data.message || 'Could not toggle availability.');
            btn.disabled = false;
        }
    } catch {
        alert('Server error. Please try again.');
        btn.disabled = false;
    }
}

// ── Real-time: reload page on computer session changes ───────────────────
libraryConnection.on('ComputerSessionUpdated', function() {
    location.reload();
});

// ── Active Session RFID tap ───────────────────────────────────────────────
// Tapping a student's RFID card highlights their session row so the
// librarian can immediately see which PC they are using and end it.

let _sessRfidBuf      = '';
let _sessRfidTimer    = null;
let _sessRfidListening = false;

function activateSessionRfid() {
    _sessRfidListening = true;
    const inp  = document.getElementById('sessionRfidInput');
    const wrap = document.getElementById('sessionRfidWrap');
    const btn  = document.getElementById('sessionRfidBtn');
    inp.readOnly = false;
    inp.value = '';
    inp.placeholder = 'Waiting for RFID tap...';
    document.getElementById('sessionRfidError').classList.add('hidden');
    wrap.style.borderColor = '#3b82f6';
    wrap.style.boxShadow   = '0 0 0 2px rgba(59,130,246,.25)';
    btn.style.backgroundColor = '#1d4ed8';
    btn.textContent = 'Scanning...';
    inp.focus();
}

function deactivateSessionRfid() {
    _sessRfidListening = false;
    const inp  = document.getElementById('sessionRfidInput');
    const wrap = document.getElementById('sessionRfidWrap');
    const btn  = document.getElementById('sessionRfidBtn');
    inp.readOnly = true;
    wrap.style.borderColor = '';
    wrap.style.boxShadow   = '';
    btn.style.backgroundColor = '#000147';
    btn.textContent = 'Tap RFID Card';
}

function clearSessionRfidHighlight() {
    document.querySelectorAll('.session-row').forEach(row => {
        row.style.backgroundColor = '';
        row.style.borderLeft = '';
    });
}

async function lookupSessionRfid(rfid) {
    const errEl = document.getElementById('sessionRfidError');
    const inp   = document.getElementById('sessionRfidInput');
    errEl.classList.add('hidden');
    inp.placeholder = 'Looking up...';

    try {
        const res  = await fetch('@Url.Action("FindUserByRfid","Computer")?rfid=' + encodeURIComponent(rfid));
        const data = await res.json();

        if (!data.found) {
            errEl.textContent = data.message || 'Card not found.';
            errEl.classList.remove('hidden');
            inp.value = '';
            inp.placeholder = 'Student Number will show here';
            deactivateSessionRfid();
            return;
        }

        // Show student/employee number in the field
        inp.value = data.studentNumber || data.employeeNumber || '';
        inp.placeholder = 'Student Number will show here';
        deactivateSessionRfid();

        // Highlight the matching session row
        clearSessionRfidHighlight();
        const studentNo  = data.studentNumber  || '';
        const employeeNo = data.employeeNumber || '';
        let matched = false;

        document.querySelectorAll('.session-row').forEach(row => {
            const sno = row.dataset.studentNo  || '';
            const eno = row.dataset.employeeNo || '';
            const isMatch = (studentNo  && sno === studentNo)
                         || (employeeNo && eno === employeeNo);
            if (isMatch) {
                row.style.backgroundColor = '#eff6ff';
                row.style.borderLeft = '3px solid #3b82f6';
                row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                matched = true;
            }
        });

        if (!matched) {
            errEl.textContent = 'No active session found for this student.';
            errEl.classList.remove('hidden');
        }
    } catch {
        document.getElementById('sessionRfidError').textContent = 'Server error. Please try again.';
        document.getElementById('sessionRfidError').classList.remove('hidden');
        deactivateSessionRfid();
    }
}

const _sessRfidEl = document.getElementById('sessionRfidInput');
if (_sessRfidEl) {
    _sessRfidEl.addEventListener('keydown', function(e) {
        if (!_sessRfidListening) return;
        if (e.key === 'Enter') {
            e.preventDefault();
            const v = _sessRfidBuf.trim();
            _sessRfidBuf = '';
            clearTimeout(_sessRfidTimer);
            if (v.length >= 2) lookupSessionRfid(v);
        }
    });
    _sessRfidEl.addEventListener('input', function() {
        if (!_sessRfidListening) return;
        _sessRfidBuf = this.value;
        clearTimeout(_sessRfidTimer);
        _sessRfidTimer = setTimeout(() => {
            const v = _sessRfidBuf.trim();
            _sessRfidBuf = '';
            if (v.length >= 4) lookupSessionRfid(v);
        }, 200);
    });
}

// Also let the desk ESP32 SignalR RFID tap trigger the session lookup
// when the Assign modal is NOT open (to avoid interfering with that flow)
if (typeof libraryConnection !== 'undefined') {
    libraryConnection.on('DeskRfidTap', function(data) {
        const assignModal = document.getElementById('assignModal');
        const assignOpen  = assignModal && !assignModal.classList.contains('hidden');
        if (!assignOpen) {
            _sessRfidListening = true;
            document.getElementById('sessionRfidInput').readOnly = false;
            lookupSessionRfid(data.rfidNumber);
        }
    });
}

// ── End Session — opens a small confirm dialog ────────────────────────────
function endSessionFromPanel(sessionId, pcNo, ln, fn, mn, sect, adviser, startISO) {
    document.getElementById('slipSessionId').value = sessionId;
    document.getElementById('confirmPcName').textContent      = pcNo || '—';
    document.getElementById('confirmStudentName').textContent = (ln && fn) ? ln + ', ' + fn : '—';
    const btn = document.getElementById('confirmEndBtn');
    if (btn) { btn.disabled = false; btn.textContent = 'End Session'; }
    document.getElementById('endSessionConfirm').classList.remove('hidden');
}

function closeSlipModal() {
    document.getElementById('endSessionConfirm').classList.add('hidden');
}

// Called by the confirm dialog's "End Session" button — performs the AJAX end
async function confirmEndSessionFromSlip() {
    const sessionId = document.getElementById('slipSessionId').value;
    const endBtn    = document.getElementById('confirmEndBtn');
    if (endBtn) { endBtn.disabled = true; endBtn.textContent = 'Ending...'; }

    try {
        const fd = new FormData();
        fd.append('sessionId', sessionId);
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        const res  = await fetch('@Url.Action("EndSessionAjax","Computer")', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
            closeSlipModal();
            clearSessionRfidHighlight();
            document.getElementById('sessionRfidInput').value = '';
            setTimeout(() => location.reload(), 400);
        } else {
            if (endBtn) { endBtn.disabled = false; endBtn.textContent = 'End Session'; }
        }
    } catch {
        if (endBtn) { endBtn.disabled = false; endBtn.textContent = 'End Session'; }
    }
}
