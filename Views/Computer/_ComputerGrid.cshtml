@using BookHiveLibrary.Models
@model IEnumerable<ComputerUnit>
@{
    // Both Index and Transaction pass SectionAdvisers and IsTransaction via ViewData/ViewBag.
    // ViewBag is accessible inside partials from the parent page's controller.
    var advisers      = ViewBag.SectionAdvisers as Dictionary<string,string> ?? new Dictionary<string,string>();
    var isTransaction = (bool)(ViewData["IsTransaction"] ?? false);
}

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <h2 class="font-bold text-gray-900">Computer Usage</h2>
        </div>
        @if (!isTransaction)
        {
            <!-- Management page: Add Computer shortcut -->
            <a href="@Url.Action("Register","Computer")" class="btn-primary">+ Add Computer</a>
        }
    </div>

    @* When embedded in Transaction page the grid scrolls; Management shows all *@
    @{
        var scrollStyle  = isTransaction ? "max-height:320px;" : "";
        var scrollClass  = isTransaction ? "overflow-y-auto" : "";
        var gridCols     = isTransaction ? "grid-cols-2 sm:grid-cols-3" : "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4";
    }
    <div class="@scrollClass" style="@scrollStyle">
    <div class="grid @gridCols gap-3 p-4">
        @foreach (var pc in Model)
        {
            var sess    = pc.Sessions.FirstOrDefault(s => s.IsActive);
            var inUse   = sess != null;
            var sect    = sess?.User?.Section ?? "";
            var adviser = (!string.IsNullOrEmpty(sect) && advisers.TryGetValue(sect, out var adv)) ? adv : "";

            <div class="border rounded-xl p-3 @(inUse ? "border-blue-200 bg-blue-50/40" : !pc.IsAvailable ? "border-red-100 bg-red-50/30" : "border-gray-200 bg-white")">

                <!-- Top: PC name (left) | In Use badge OR lock toggle (right) -->
                <div class="flex items-start justify-between mb-2">
                    <div>
                        <p class="font-bold text-gray-800 text-sm leading-tight truncate">@pc.ComputerNumber</p>
                        @if (!inUse)
                        {
                            <!-- Available / Unavailable shown under name when not in use -->
                            <span class="text-[11px] font-medium @(!pc.IsAvailable ? "text-orange-500" : "text-green-600")">
                                ● @(!pc.IsAvailable ? "Unavailable" : "Available")
                            </span>
                        }
                    </div>
                    @if (inUse)
                    {
                        <!-- "In Use" badge moved to top-right -->
                        <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-red-100 text-red-600 flex-shrink-0">● In Use</span>
                    }
                    else if (!isTransaction)
                    {
                        <!-- Availability toggle — Computer Management page only -->
                        <button onclick="toggleAvailability(@pc.Id, this)"
                                title="@(pc.IsAvailable ? "Mark as Unavailable" : "Mark as Available")"
                                class="flex-shrink-0 w-7 h-7 rounded-lg flex items-center justify-center transition @(pc.IsAvailable ? "text-gray-400 hover:bg-red-50 hover:text-red-500" : "text-orange-400 hover:bg-green-50 hover:text-green-600")">
                            @if (pc.IsAvailable)
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                                </svg>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                                </svg>
                            }
                        </button>
                    }
                </div>

                <!-- Bottom: duration badge + action button on same line -->
                <div class="flex items-center justify-between mt-2 gap-1">
                    @if (inUse && sess != null)
                    {
                        <!-- Duration badge (left) -->
                        <span class="duration-badge text-[10px] font-semibold px-1.5 py-0.5 rounded flex-shrink-0"
                              style="background:#000147; color:white;"
                              data-start="@sess.StartTime.ToUniversalTime().ToString("o")">—</span>
                    }
                    else
                    {
                        <span></span>
                    }

                    <!-- Action button (right side of the same flex row as duration badge) -->
                    @if (isTransaction)
                    {
                        @if (!inUse && pc.IsAvailable)
                        {
                            <button onclick="openAssignModal(@pc.Id, '@pc.ComputerNumber')"
                                    class="px-3 py-1 text-[11px] font-medium text-white rounded-lg" style="background:#000147;">
                                Assign
                            </button>
                        }
                        @if (!inUse && !pc.IsAvailable)
                        {
                            <span class="px-3 py-1 text-[11px] font-medium text-orange-600 bg-orange-50 border border-orange-200 rounded-lg">Maintenance</span>
                        }
                        @* In-use PCs show no button here — End Session is in the Active Session panel *@
                    }
                    else
                    {
                        <!-- Management page: Archive button only for unavailable (not in use, not available) -->
                        @if (!inUse && !pc.IsAvailable)
                        {
                            <button onclick="showArchiveModal(@pc.Id, '@pc.ComputerNumber')"
                                    class="px-3 py-1 text-[11px] font-medium rounded-lg border border-gray-200 text-gray-500 hover:bg-red-50 hover:text-red-500 hover:border-red-200 transition">
                                Archive
                            </button>
                        }
                    }
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="col-span-4 py-12 text-center text-gray-400">No computers registered</div>
        }
    </div>
    </div>
</div>
