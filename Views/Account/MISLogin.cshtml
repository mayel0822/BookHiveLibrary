@model BookHiveLibrary.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "MIS Login";
}

<div class="min-h-screen bg-gradient-to-br from-indigo-700 to-purple-700 flex items-center justify-center relative">

    <div class="bg-white rounded-3xl sm:rounded-[70px] shadow-2xl w-full max-w-3xl mx-4 flex flex-col items-center pt-10 px-6 sm:px-20 pb-10">

        <!-- Logo -->
        <img src="/images/bookhive_logo_v2.png" class="w-full max-w-lg mb-4" />
        <p class="text-gray-500 text-sm mb-8 font-medium tracking-wide uppercase">MIS Facilitator Portal</p>

        @if (TempData["Error"] != null)
        {
            <div class="w-full max-w-md bg-red-50 border border-red-300 text-red-700 text-sm px-4 py-3 rounded-xl mb-4 text-center">
                @TempData["Error"]
            </div>
        }

        <!-- Login Form -->
        <form asp-action="MISLogin" asp-controller="Account" method="post"
              class="flex flex-col items-center w-full">
            @Html.AntiForgeryToken()

            <input asp-for="EmailOrUsername"
                   type="text"
                   placeholder="Email or Username"
                   class="w-full max-w-md h-[58px] px-6 bg-gray-100 rounded-2xl text-lg outline-none shadow-sm mb-4" />

            <input asp-for="Password"
                   type="password"
                   placeholder="Password"
                   class="w-full max-w-md h-[58px] px-6 bg-gray-100 rounded-2xl text-lg outline-none shadow-sm mb-6" />

            <button type="submit"
                    class="w-full max-w-md h-[65px] rounded-3xl text-white text-2xl font-medium shadow-lg hover:opacity-90 transition"
                    style="background-color:#000147;">
                Sign In
            </button>
        </form>

        <!-- Back -->
        <div class="mt-6">
            <a href="/Account/Login" class="text-gray-400 text-sm hover:text-gray-600 underline">
                Back to Login
            </a>
        </div>

    </div>

</div>
