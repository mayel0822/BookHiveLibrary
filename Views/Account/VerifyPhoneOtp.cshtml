@model BookHiveLibrary.ViewModels.VerifyPhoneOtpViewModel

@{
    ViewData["Title"] = "Verify Phone";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Phone — BookHive</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen flex items-center justify-center" style="background:#000147;">

    <div class="bg-white rounded-2xl w-full max-w-sm mx-4 px-10 py-10 flex flex-col items-center">

        <div class="mb-6" style="font-family:'Dancing Script',cursive;font-size:2.2rem;font-weight:700;color:#000147;">BookHive</div>

        @if (TempData["SmsError"] != null)
        {
            <div class="w-full bg-yellow-50 border border-yellow-300 text-yellow-800 text-sm px-4 py-3 rounded-xl mb-4 text-center">
                @TempData["SmsError"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="w-full bg-green-50 border border-green-300 text-green-700 text-sm px-4 py-3 rounded-xl mb-4 text-center">
                @TempData["Success"]
            </div>
        }

        <p class="text-gray-500 text-sm text-center mb-5">A 6-digit code was sent to your registered phone number.</p>

        <form method="post" asp-action="VerifyPhoneOtp" class="w-full flex flex-col items-center gap-4">
            <input asp-for="Email" type="hidden" />

            <div asp-validation-summary="All" class="w-full text-red-500 text-center text-sm"></div>

            <input asp-for="Code"
                   placeholder=""
                   maxlength="6"
                   autocomplete="one-time-code"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-xl text-center tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-400" />

            <button type="submit"
                    class="w-auto px-10 py-2.5 text-white rounded-full font-semibold text-base hover:opacity-90 transition"
                    style="background:#000147;font-family:'Dancing Script',cursive;font-size:1.3rem;">
                Verify
            </button>
        </form>

        <form method="post" asp-action="ResendPhoneOtp" class="mt-4">
            <input type="hidden" name="email" value="@Model.Email" />
            <button type="submit" class="text-blue-500 text-sm hover:underline">
                Didn't receive a code? Resend
            </button>
        </form>

    </div>

</body>
</html>
