@{
    ViewData["Title"] = "Complete Profile";
}

<div class="min-h-screen flex items-center justify-center bg-violet-700">

    <div class="bg-white rounded-3xl sm:rounded-[40px] w-full max-w-lg mx-4 p-8 sm:p-16 flex flex-col items-center">

        <img src="/images/bookhive_logo_v2.png" class="w-[150px] mb-3" />

        <h1 class="text-4xl font-light mb-2">
            Book<span class="text-violet-700">Hive</span>
        </h1>

        <h3 class="text-2xl mb-3">
            Complete Your Profile
        </h3>

        <p class="text-gray-500 text-center text-base mb-8">
            Enter your active phone number below.<br />
            This will be used to send you book due-date reminders.
        </p>

        <form method="post"
              asp-action="CompleteProfile"
              class="flex flex-col items-center w-full"
              id="phoneForm">

            @Html.AntiForgeryToken()
            <input type="hidden" name="phoneNumber" id="phoneNumberHidden" />

            <div class="w-full max-w-sm flex items-center bg-gray-100 rounded-2xl h-[60px] mb-8 overflow-hidden">
                <span class="pl-6 pr-3 text-xl text-gray-500 select-none whitespace-nowrap">+63</span>
                <div class="w-px h-8 bg-gray-300"></div>
                <input type="text"
                       id="phoneInput"
                       placeholder="9XXXXXXXXX"
                       maxlength="10"
                       required
                       class="flex-1 bg-transparent px-4 text-xl outline-none" />
            </div>

            <button type="submit"
                    class="w-full max-w-sm h-[65px] bg-violet-700 text-white rounded-2xl text-2xl hover:bg-violet-800 transition">
                Send Verification Code
            </button>

        </form>

        <script>
        document.getElementById('phoneForm').addEventListener('submit', function(e) {
            var digits = document.getElementById('phoneInput').value.replace(/\D/g, '');
            if (digits.startsWith('0')) digits = digits.substring(1);
            document.getElementById('phoneNumberHidden').value = '+63' + digits;
        });
        </script>

    </div>

</div>
