@using BookHiveLibrary.Models
@{
    Layout = "~/Views/Shared/_LibrarianLayout.cshtml";
    ViewData["Title"] = "Sectioning";
    var sections = ViewBag.Sections as List<Section> ?? new List<Section>();
}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6" style="height:100%;">
    <!-- Left: Create Section Form — matched in height to the Sections list next
         to it, but not made scrollable itself: this form has a fixed set of
         fields that never grows, and forcing a scrollbar here would clip the
         Course/Adviser dropdowns that pop open below their fields. -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6" style="height:100%;overflow:hidden;">
        <h2 class="text-2xl font-bold pb-3 mb-5 border-b border-gray-200" class="text-gray-900">Add Section</h2>
        <form method="post" action="@Url.Action("CreateSection","Librarian")" id="sectionForm">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-600 mb-1">Level</label>
                <select name="level" id="levelSelect" required onchange="onLevelChange()"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                    <option value="">Select level...</option>
                    <option value="Junior High School">Junior High School</option>
                    <option value="Senior High School">Senior High School</option>
                    <option value="Tertiary">Tertiary</option>
                </select>
            </div>

            <div class="mb-4" id="courseDiv">
                <label class="block text-sm font-medium text-gray-600 mb-1">Course / Strand</label>
                <div class="relative">
                    <button type="button" id="courseDropdownBtn"
                            onclick="toggleCourseDropdown()"
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-left flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-blue-300 bg-white">
                        <span id="courseDropdownLabel" class="text-gray-400">Select level first...</span>
                        <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    <div id="courseDropdownMenu"
                         class="hidden absolute z-30 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-60 overflow-y-auto">
                    </div>
                </div>
                <input type="hidden" name="course" id="courseValue" />
                <input type="hidden" id="courseAbbr" />
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-600 mb-1">Year</label>
                <select name="year" id="yearSelect" required
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                    <option value="">Select level first...</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-600 mb-1">Section Name</label>
                <input type="text" name="sectionName" id="sectionNameInput" required placeholder="e.g. 601, Dahlia..."
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
            </div>

            <div class="mb-6 relative">
                <label class="block text-sm font-medium text-gray-600 mb-1">Adviser Name</label>
                <input type="text" id="adviserSearch" name="adviserName" autocomplete="off"
                       placeholder="Type to search professor..."
                       oninput="filterAdvisers()"
                       onfocus="showAdviserDropdown()"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                <div id="adviserDropdown"
                     class="hidden absolute z-30 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
                    @{
                        var professors = ViewBag.Professors as List<string> ?? new List<string>();
                    }
                    @if (!professors.Any())
                    {
                        <p class="px-4 py-3 text-sm text-gray-400">No professors registered.</p>
                    }
                    @foreach (var p in professors)
                    {
                        <div class="adviser-option px-4 py-2 text-sm cursor-pointer hover:bg-blue-50 hover:text-blue-700"
                             data-name="@p.ToLower()"
                             onclick="selectAdviser('@p')">@p</div>
                    }
                </div>
            </div>

            <div class="flex gap-3 justify-end">
                <button type="reset" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200">Cancel</button>
                <button type="submit" class="px-6 py-2 text-white rounded-lg text-sm font-medium" style="background-color:#000147;">Save</button>
            </div>
        </form>
    </div>

    <!-- Right: Sections List -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col" style="height:100%;overflow:hidden;">
        <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between flex-shrink-0">
            <h2 class="text-2xl font-bold" class="text-gray-900">Sections (@sections.Count)</h2>
            <button type="button"
                    onclick="@(sections.Any() ? "document.getElementById('resetModal').classList.remove('hidden')" : "document.getElementById('noSectionToast').classList.remove('hidden'); setTimeout(()=>document.getElementById('noSectionToast').classList.add('hidden'),2500)")"
                    class="px-3 py-1.5 text-xs text-white rounded-lg" style="background-color:#000147;">
                Reset Section
            </button>
        </div>
        <div class="px-5 py-3 border-b border-gray-100 flex-shrink-0">
            <div class="flex items-center gap-2 border border-gray-300 rounded-lg px-3 py-1.5 focus-within:ring-2 focus-within:ring-blue-300 bg-white">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/></svg>
                <input type="text" id="sectionSearch" placeholder="Search sections..."
                       oninput="filterSections()"
                       class="flex-1 text-sm outline-none bg-transparent text-gray-700 placeholder-gray-400" />
            </div>
        </div>
        <div id="sectionList" class="flex-1 min-h-0 overflow-y-scroll">
            @if (!sections.Any())
            {
                <p class="px-5 py-8 text-center text-gray-400 text-sm">No sections created yet</p>
            }
            @{
                var levelOrder = new[] { "Junior High School", "Senior High School", "College" };
                // Normalize old "Tertiary"/"College" values to "College"
                var grouped = sections
                    .GroupBy(s => (s.Level == "Tertiary" || s.Level == "College") ? "College" :
                                   s.Level == "SHS" ? "Senior High School" :
                                   (s.Level == "Grade 7" || s.Level == "Grade 8" || s.Level == "Grade 9" || s.Level == "Grade 10") ? "Junior High School" :
                                   s.Level)
                    .OrderBy(g => Array.IndexOf(levelOrder, g.Key) < 0 ? 99 : Array.IndexOf(levelOrder, g.Key));
            }
            @foreach (var group in grouped)
            {
                <div class="sticky top-0 z-10 px-5 py-2 text-xs font-semibold uppercase tracking-widest text-white" style="background-color:#1234C4;">
                    @(group.Key == "Junior High School" ? "Junior High School" : group.Key == "Senior High School" ? "Senior High School" : "College")
                </div>
                <div class="divide-y divide-gray-100">
                @foreach (var s in group.OrderBy(s => s.SectionName))
                {
                <div class="flex items-center justify-between px-5 py-3 hover:bg-gray-50 cursor-pointer group"
                     data-section="@s.SectionName"
                     onclick="openSectionStudents('@s.SectionName', '@s.AdviserName')">
                    <div>
                        <p class="text-sm font-medium text-gray-800 group-hover:text-blue-700 transition">@s.SectionName</p>
                        @if (!string.IsNullOrEmpty(s.Year))
                        {
                            <p class="text-xs text-gray-500 font-medium">@s.Year</p>
                        }
                        @if (!string.IsNullOrEmpty(s.AdviserName))
                        {
                            <p class="text-xs text-gray-400">Adviser: @s.AdviserName</p>
                        }
                    </div>
                    <div class="flex items-center gap-3">
                        <svg class="w-4 h-4 text-gray-300 group-hover:text-blue-400 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                        <form method="post" action="@Url.Action("DeleteSection","Librarian")"
                              onsubmit="return bhConfirmSubmit(event, 'Delete this section?')" onclick="event.stopPropagation()">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.Id" />
                            <button type="submit" class="text-red-400 hover:text-red-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </form>
                    </div>
                </div>
                }
                </div>
            }
        </div>
    </div>
</div>

<!-- No section warning modal -->
<div id="noSectionToast" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-xl p-6 w-full max-w-sm mx-4 shadow-xl text-center">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-yellow-100 mx-auto mb-4">
            <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
            </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-700 mb-2">No Sections Found</h3>
        <p class="text-sm text-gray-400 mb-5">There are no sections listed yet. Add a section first before resetting.</p>
        <button onclick="document.getElementById('noSectionToast').classList.add('hidden')"
                class="px-6 py-2 text-white rounded-lg text-sm font-medium" style="background-color:#000147;">OK</button>
    </div>
</div>

<!-- Reset Section Modal -->
<div id="resetModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-xl p-6 w-full max-w-md mx-4 shadow-xl">
        <h3 class="text-lg font-semibold text-gray-700 mb-1">Reset Sections</h3>
        <p class="text-sm text-gray-400 mb-5">Select which level to reset. This will delete all sections under that level.</p>

        <form method="post" action="@Url.Action("DeleteAllSections","Librarian")"
              onsubmit="return bhConfirmSubmit(event, 'Reset all sections for the selected level? This cannot be undone.')">
            @Html.AntiForgeryToken()

            <div class="space-y-3 mb-6">
                <label class="flex items-start gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
                    <input type="radio" name="levelGroup" value="JHS" class="mt-0.5" required />
                    <div>
                        <p class="text-sm font-medium text-gray-700">Junior High School (Grade 7–10)</p>
                        <p class="text-xs text-gray-400">Resets every academic year</p>
                    </div>
                </label>
                <label class="flex items-start gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
                    <input type="radio" name="levelGroup" value="SHS" class="mt-0.5" />
                    <div>
                        <p class="text-sm font-medium text-gray-700">Senior High School (Grade 11–12)</p>
                        <p class="text-xs text-gray-400">Resets every academic year</p>
                    </div>
                </label>
                <label class="flex items-start gap-3 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-gray-50">
                    <input type="radio" name="levelGroup" value="Tertiary" class="mt-0.5" />
                    <div>
                        <p class="text-sm font-medium text-gray-700">Tertiary</p>
                        <p class="text-xs text-gray-400">Resets every semester</p>
                    </div>
                </label>
            </div>

            <div class="flex gap-3 justify-end">
                <button type="button" onclick="document.getElementById('resetModal').classList.add('hidden')"
                        class="px-5 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm hover:bg-gray-200">Cancel</button>
                <button type="submit" class="px-5 py-2 text-white rounded-lg text-sm font-medium" style="background-color:#000147;">Reset</button>
            </div>
        </form>
    </div>
</div>

<!-- Section Students Modal -->
<div id="sectionStudentsModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/50 px-6 py-6">
    <div class="bg-white rounded-2xl shadow-2xl w-full overflow-hidden flex flex-col" style="max-width:1100px;height:88vh;">

        <!-- Header -->
        <div class="px-6 py-4 flex items-center justify-between flex-shrink-0" style="background-color:#000147;">
            <div>
                <h3 id="sm-title" class="text-base font-semibold text-white"></h3>
                <p id="sm-adviser" class="text-xs text-blue-300 mt-0.5"></p>
            </div>
            <div class="flex items-center gap-3">
                <!-- Back button (shown only in add-student view) -->
                <button id="sm-back-btn" onclick="showEnrolledView()" class="hidden items-center gap-1.5 px-4 py-1.5 text-xs font-semibold rounded-lg bg-white/20 hover:bg-white/30 text-white transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    Back to Section
                </button>
                <!-- Add Student button (shown only in enrolled view) -->
                <button id="sm-add-btn" onclick="showAddView()"
                        class="flex items-center gap-1.5 px-4 py-1.5 text-xs font-semibold rounded-lg bg-white/20 hover:bg-white/30 text-white transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    Add Student
                </button>
                <button onclick="closeSectionStudents()" class="text-white/70 hover:text-white transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        </div>

        <!-- VIEW 1: Enrolled Students -->
        <div id="sm-enrolled-panel" class="flex flex-col flex-1 min-h-0">
            <div class="px-6 py-3 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">Students in Section</p>
                <span id="sm-student-count" class="text-xs text-gray-400"></span>
            </div>
            <div id="sm-body" class="flex-1 overflow-y-auto divide-y divide-gray-100">
                <p class="px-6 py-10 text-center text-sm text-gray-400">Loading…</p>
            </div>
        </div>

        <!-- VIEW 2: Add / Unassigned Students (hidden by default) -->
        <div id="sm-add-panel" class="hidden flex-col flex-1 min-h-0">
            <div class="px-6 py-3 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">Unassigned Students</p>
                <span id="sm-unassigned-count" class="text-xs text-gray-400"></span>
            </div>
            <!-- Search / RFID bar -->
            <div class="px-6 py-3 border-b border-gray-100 flex-shrink-0">
                <div id="smRfidWrap" class="flex rounded-xl overflow-hidden border border-gray-300 transition-all duration-200">
                    <input type="text" id="sm-search" placeholder=""
                           oninput="filterUnassigned()"
                           class="flex-1 px-4 py-2.5 text-sm outline-none bg-white text-gray-700" readonly />
                    <button id="smRfidBtn" type="button" onclick="activateSmRfid()"
                            class="px-4 py-2.5 text-sm font-semibold text-white flex-shrink-0 transition-colors duration-200"
                            style="background-color:#000147;">
                        Tap RFID Card
                    </button>
                </div>
            </div>
            <div id="sm-unassigned-list" class="flex-1 overflow-y-auto divide-y divide-gray-100">
                <p class="px-6 py-10 text-center text-sm text-gray-400">Loading…</p>
            </div>
        </div>

    </div>
</div>

<!-- Assign Student Preview Popup -->
<div id="assignPreviewModal" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-black/50 px-4" onclick="if(event.target===this)closeAssignPreview()">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden">
        <div class="px-5 py-4 flex items-center justify-between" style="background-color:#000147;">
            <h3 class="text-sm font-semibold text-white">Add to Section</h3>
            <button onclick="closeAssignPreview()" class="text-white/70 hover:text-white transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <div class="p-5">
            <!-- Student info -->
            <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gray-100">
                <div id="preview-initial" class="w-12 h-12 rounded-full flex items-center justify-center text-white text-xl font-bold flex-shrink-0" style="background-color:#000147;"></div>
                <div>
                    <p id="preview-name" class="font-bold text-gray-900 text-base"></p>
                    <p class="text-xs text-gray-400 mt-0.5">Student</p>
                </div>
            </div>
            <div class="space-y-2 text-sm mb-5">
                <div class="flex justify-between py-1.5 border-b border-gray-100">
                    <span class="text-gray-500">Student ID</span>
                    <span id="preview-idno" class="font-semibold text-gray-800 font-mono"></span>
                </div>
                <div class="flex justify-between py-1.5">
                    <span class="text-gray-500">Assign to</span>
                    <span id="preview-section" class="font-semibold text-blue-700"></span>
                </div>
            </div>
            <p class="text-xs text-gray-400 mb-4">This will assign the student to the section and activate their account.</p>
            <div class="flex gap-2">
                <button onclick="closeAssignPreview()" class="flex-1 py-2 text-sm border border-gray-300 text-gray-600 rounded-xl hover:bg-gray-50 transition">Cancel</button>
                <button id="preview-save-btn" onclick="confirmAssignStudent()" class="flex-1 py-2 text-sm text-white rounded-xl font-medium transition" style="background-color:#000147;">Add to Section</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
<script>
const data = {
    'Junior High School': {
        courses: null,
        years:   ['Grade 7', 'Grade 8', 'Grade 9', 'Grade 10']
    },
    'Senior High School': {
        courses: [
            { abbr: 'ABM',         label: 'Accountancy, Business, and Management' },
            { abbr: 'STEM',        label: 'Science, Technology, Engineering, and Mathematics' },
            { abbr: 'HUMSS',       label: 'Humanities and Social Sciences' },
            { abbr: 'GA',          label: 'General Academic' },
            { abbr: 'ICT',         label: 'IT in Mobile App and Web Development' },
            { abbr: 'DA',          label: 'Digital Arts' },
            { abbr: 'TVL-Tourism', label: 'Tourism Operations' },
            { abbr: 'TVL-RCO',     label: 'Restaurant and Cafe Operations' },
            { abbr: 'TVL-CA',      label: 'Culinary Arts' }
        ],
        years: ['Grade 11', 'Grade 12']
    },
    'Tertiary': {
        courses: [
            { abbr: 'BSCS',   label: 'Bachelor of Science in Computer Science' },
            { abbr: 'BSIT',   label: 'Bachelor of Science in Information Technology' },
            { abbr: 'BSCpE',  label: 'Bachelor of Science in Computer Engineering' },
            { abbr: 'BSBA',   label: 'Bachelor of Science in Business Administration' },
            { abbr: 'BSRTCS', label: 'Bachelor of Science in Retail Technology and Consumer Science' },
            { abbr: 'BACOMM', label: 'Bachelor of Arts in Communication' },
            { abbr: 'BAP',    label: 'Bachelor of Arts in Psychology' },
            { abbr: 'BSTM',   label: 'Bachelor of Science in Tourism Management' },
            { abbr: 'ACT',    label: '2-yr. Associate in Computer Technology' },
            { abbr: 'ART',    label: '2-yr. Associate in Retail Technology' }
        ],
        years: ['1st Year', '2nd Year', '3rd Year', '4th Year']
    }
};

function filterSections() {
    const q = document.getElementById('sectionSearch').value.toLowerCase();
    document.querySelectorAll('#sectionList [data-section]').forEach(row => {
        row.style.display = row.dataset.section.toLowerCase().includes(q) ? '' : 'none';
    });
}

let currentSection = '';
let allUnassigned  = [];

async function openSectionStudents(sectionName, adviserName) {
    currentSection = sectionName;
    document.getElementById('sm-title').textContent   = sectionName + ' — Students';
    document.getElementById('sm-adviser').textContent = adviserName ? 'Adviser: ' + adviserName : '';
    document.getElementById('sm-body').innerHTML      = '<p class="px-6 py-10 text-center text-sm text-gray-400">Loading…</p>';
    // Always start in enrolled view
    showEnrolledView();
    document.getElementById('sectionStudentsModal').classList.remove('hidden');
    await refreshEnrolledStudents();
}

async function refreshEnrolledStudents() {
    try {
        const res  = await fetch('/Librarian/GetStudentsBySection?sectionName=' + encodeURIComponent(currentSection));
        const list = await res.json();
        const countEl = document.getElementById('sm-student-count');
        if (countEl) countEl.textContent = list.length ? list.length + ' student' + (list.length > 1 ? 's' : '') : '';
        if (!list.length) {
            document.getElementById('sm-body').innerHTML = '<p class="px-6 py-10 text-center text-sm text-gray-400">No students in this section yet.<br><span class="text-xs text-gray-300">Click "+ Add Student" to assign students.</span></p>';
            return;
        }
        document.getElementById('sm-body').innerHTML = list.map((s, i) => `
            <div class="flex items-center gap-4 px-6 py-3.5 hover:bg-gray-50 transition">
                <span class="text-xs text-gray-300 w-6 text-right flex-shrink-0 font-mono">${i + 1}</span>
                <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0" style="background-color:#000147;">
                    ${s.name.charAt(0).toUpperCase()}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-800">${s.name}</p>
                    <p class="text-xs text-gray-400 mt-0.5">${s.idNo || '—'}</p>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full ${s.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">
                        ${s.active ? 'Active' : 'Inactive'}
                    </span>
                    <button onclick="removeStudent('${s.id}','${s.name.replace(/'/g,"\\'")}',this)"
                            title="Remove from section"
                            class="p-1.5 rounded-lg text-red-300 hover:text-red-600 hover:bg-red-50 transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                    </button>
                </div>
            </div>`).join('');
    } catch {
        document.getElementById('sm-body').innerHTML = '<p class="px-6 py-10 text-center text-sm text-gray-400">Could not load students.</p>';
    }
}

function showEnrolledView() {
    document.getElementById('sm-add-panel').classList.add('hidden');
    document.getElementById('sm-add-panel').classList.remove('flex');
    document.getElementById('sm-enrolled-panel').classList.remove('hidden');
    document.getElementById('sm-enrolled-panel').classList.add('flex');
    document.getElementById('sm-add-btn').classList.remove('hidden');
    document.getElementById('sm-add-btn').classList.add('flex');
    document.getElementById('sm-back-btn').classList.add('hidden');
    document.getElementById('sm-back-btn').classList.remove('flex');
}

async function showAddView() {
    document.getElementById('sm-enrolled-panel').classList.add('hidden');
    document.getElementById('sm-enrolled-panel').classList.remove('flex');
    document.getElementById('sm-add-panel').classList.remove('hidden');
    document.getElementById('sm-add-panel').classList.add('flex');
    document.getElementById('sm-add-btn').classList.add('hidden');
    document.getElementById('sm-add-btn').classList.remove('flex');
    document.getElementById('sm-back-btn').classList.remove('hidden');
    document.getElementById('sm-back-btn').classList.add('flex');
    const searchEl = document.getElementById('sm-search');
    searchEl.value = '';
    searchEl.classList.remove('ring-2', 'ring-blue-400');
    document.getElementById('sm-unassigned-list').innerHTML = '<p class="px-6 py-10 text-center text-sm text-gray-400">Loading…</p>';
    try {
        const res     = await fetch('/Librarian/GetUnassignedStudents');
        allUnassigned = await res.json();
        const countEl = document.getElementById('sm-unassigned-count');
        if (countEl) countEl.textContent = allUnassigned.length + ' student' + (allUnassigned.length !== 1 ? 's' : '');
        renderUnassigned(allUnassigned);
        deactivateSmRfid();
    } catch {
        document.getElementById('sm-unassigned-list').innerHTML = '<p class="px-6 py-10 text-center text-sm text-gray-400">Could not load students.</p>';
    }
}

// Keep old name as alias so RFID handler still works
async function toggleAddPanel() { await showAddView(); }

function renderUnassigned(list) {
    const el = document.getElementById('sm-unassigned-list');
    if (!list.length) {
        el.innerHTML = '<p class="px-4 py-8 text-sm text-gray-400 text-center">No unassigned students found</p>';
        return;
    }
    el.innerHTML = list.map(s => `
        <div class="flex items-center gap-4 px-6 py-3.5 hover:bg-blue-50 transition group">
            <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0" style="background-color:#000147;">
                ${s.name.charAt(0).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-800">${s.name}</p>
                <p class="text-xs text-gray-400 mt-0.5">${s.idNo || '—'}</p>
            </div>
            <div class="flex items-center gap-1 flex-shrink-0">
                <!-- Add to section button -->
                <button onclick="openAssignPreview('${s.id}','${s.name.replace(/'/g,"\\'")}','${s.idNo||''}','${s.rfid||''}')"
                        class="w-9 h-9 flex items-center justify-center text-2xl font-bold flex-shrink-0 hover:opacity-60 transition"
                        style="color:#000147;background:none;border:none;" title="Add to this section">
                    +
                </button>
            </div>
        </div>`).join('');
}

function filterUnassigned() {
    const q = document.getElementById('sm-search').value.toLowerCase().trim();
    if (!q) {
        renderUnassigned(allUnassigned); // show all when search is empty
        return;
    }
    renderUnassigned(allUnassigned.filter(s =>
        s.name.toLowerCase().includes(q) ||
        (s.idNo  || '').toLowerCase().includes(q) ||
        (s.rfid  || '').toLowerCase().includes(q)
    ));
}

// Preview popup before assigning
let _previewUserId = '', _previewUserName = '';

function openAssignPreview(userId, name, idNo, rfid) {
    _previewUserId   = userId;
    _previewUserName = name;
    document.getElementById('preview-initial').textContent = name.charAt(0).toUpperCase();
    document.getElementById('preview-name').textContent    = name;
    document.getElementById('preview-idno').textContent    = idNo || '—';
    document.getElementById('preview-section').textContent = currentSection;
    document.getElementById('assignPreviewModal').classList.remove('hidden');
}

function closeAssignPreview() {
    document.getElementById('assignPreviewModal').classList.add('hidden');
}

async function confirmAssignStudent() {
    const saveBtn = document.getElementById('preview-save-btn');
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';
    try {
        const res  = await fetch('/Librarian/AssignStudentToSection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getAntiForgeryToken() },
            body: 'userId=' + encodeURIComponent(_previewUserId) + '&sectionName=' + encodeURIComponent(currentSection)
        });
        const json = await res.json();
        if (json.success) {
            closeAssignPreview();
            // Remove from local unassigned list
            allUnassigned = allUnassigned.filter(s => s.id !== _previewUserId);
            // Switch back to enrolled view and refresh
            showEnrolledView();
            await refreshEnrolledStudents();
        } else {
            alert(json.message || 'Failed to assign student.');
        }
    } catch {
        alert('Error assigning student.');
    }
    saveBtn.disabled = false;
    saveBtn.textContent = 'Add to Section';
}

// ── Sectioning RFID tap button ───────────────────────────────────────────
let smRfidListening = false;
let smRfidBuffer = '';
let smRfidTimer = null;

function activateSmRfid() {
    smRfidListening = true;
    const inp = document.getElementById('sm-search');
    const wrap = document.getElementById('smRfidWrap');
    const btn  = document.getElementById('smRfidBtn');
    inp.readOnly = false;
    inp.value = '';
    wrap.style.borderColor = '#3b82f6';
    wrap.style.boxShadow = '0 0 0 2px rgba(59,130,246,.25)';
    btn.style.backgroundColor = '#1d4ed8';
    btn.textContent = 'Scanning...';
    inp.focus();
}

function deactivateSmRfid() {
    smRfidListening = false;
    const inp = document.getElementById('sm-search');
    const wrap = document.getElementById('smRfidWrap');
    const btn  = document.getElementById('smRfidBtn');
    inp.readOnly = true;
    wrap.style.borderColor = '';
    wrap.style.boxShadow = '';
    btn.style.backgroundColor = '#000147';
    btn.textContent = 'Tap RFID Card';
}

document.getElementById('sm-search').addEventListener('input', function() {
    if (!smRfidListening) return;
    smRfidBuffer = this.value;
    clearTimeout(smRfidTimer);
    smRfidTimer = setTimeout(() => {
        const rfid = smRfidBuffer.trim();
        smRfidBuffer = '';
        if (rfid.length >= 4) {
            const matched = allUnassigned.find(s => (s.rfid || '').toLowerCase() === rfid.toLowerCase());
            this.value = matched ? (matched.idNo || rfid) : rfid;
            filterUnassigned();
            deactivateSmRfid();
        }
    }, 200);
});

// Join the transaction SignalR group so DeskRfidTap events are received here.
// We wait for _libConnected (the layout's start() promise) so the connection
// is fully open before invoking — otherwise invoke silently fails mid-connect.
// That promise only resolves once, so we also re-join on every reconnect:
// group membership is tied to the connection id and is lost when it changes.
if (typeof libraryConnection !== 'undefined') {
    function _joinTransactionSectioning() {
        libraryConnection.invoke('JoinTransaction').catch(err => console.error('JoinTransaction error:', err));
    }
    (window._libConnected || Promise.resolve()).then(_joinTransactionSectioning);
    libraryConnection.onreconnected(_joinTransactionSectioning);

    libraryConnection.on('DeskRfidTap', function(data) {
        const modal    = document.getElementById('sectionStudentsModal');
        const addPanel = document.getElementById('sm-add-panel');
        if (!modal    || modal.classList.contains('hidden')) return;
        if (!addPanel || addPanel.classList.contains('hidden')) return;

        smRfidListening = true;
        const searchEl = document.getElementById('sm-search');
        searchEl.readOnly = false;
        const matched  = allUnassigned.find(s => (s.rfid || '').toLowerCase() === data.rfidNumber.toLowerCase());
        searchEl.value = matched ? (matched.idNo || data.rfidNumber) : data.rfidNumber;
        filterUnassigned();
        deactivateSmRfid();
    });
}

async function removeStudent(userId, name, btnEl) {
    if (!await bhConfirm('Remove ' + name + ' from this section? This will deactivate their RFID card.')) return;
    btnEl.disabled = true;
    try {
        const res  = await fetch('/Librarian/RemoveStudentFromSection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getAntiForgeryToken() },
            body: 'userId=' + encodeURIComponent(userId)
        });
        const json = await res.json();
        if (json.success) {
            await refreshEnrolledStudents();
            if (!document.getElementById('sm-add-panel').classList.contains('hidden')) {
                const res2 = await fetch('/Librarian/GetUnassignedStudents');
                allUnassigned = await res2.json();
                filterUnassigned();
            }
        }
    } catch {
        btnEl.disabled = false;
    }
}

function getAntiForgeryToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
}

function closeSectionStudents() {
    document.getElementById('sectionStudentsModal').classList.add('hidden');
}
document.getElementById('sectionStudentsModal').addEventListener('click', function(e) {
    if (e.target === this) closeSectionStudents();
});

// ── Adviser searchable dropdown ───────────────────────────────────────────
function showAdviserDropdown() {
    filterAdviserDropdown('');
    document.getElementById('adviserDropdown').classList.remove('hidden');
}
function filterAdvisers() {
    filterAdviserDropdown(document.getElementById('adviserSearch').value);
}
function filterAdviserDropdown(q) {
    const lower = q.toLowerCase();
    document.querySelectorAll('.adviser-option').forEach(el => {
        el.style.display = el.dataset.name.includes(lower) ? '' : 'none';
    });
    document.getElementById('adviserDropdown').classList.remove('hidden');
}
function selectAdviser(name) {
    document.getElementById('adviserSearch').value = name;
    document.getElementById('adviserDropdown').classList.add('hidden');
}
document.addEventListener('click', function(e) {
    const input = document.getElementById('adviserSearch');
    const drop  = document.getElementById('adviserDropdown');
    if (input && drop && !input.contains(e.target) && !drop.contains(e.target)) {
        drop.classList.add('hidden');
    }
});

// ── Custom course dropdown ────────────────────────────────────────────────
function toggleCourseDropdown() {
    document.getElementById('courseDropdownMenu').classList.toggle('hidden');
}
function selectCourse(abbr, label) {
    document.getElementById('courseValue').value        = label; // store full name
    document.getElementById('courseAbbr').value         = abbr;  // keep abbr for section name
    document.getElementById('courseDropdownLabel').innerHTML = label + ' <strong>(' + abbr + ')</strong>';
    document.getElementById('courseDropdownLabel').classList.remove('text-gray-400');
    document.getElementById('courseDropdownMenu').classList.add('hidden');
    document.getElementById('sectionNameInput').value  = '';
}
document.addEventListener('click', function(e) {
    const btn  = document.getElementById('courseDropdownBtn');
    const menu = document.getElementById('courseDropdownMenu');
    if (btn && menu && !btn.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.add('hidden');
    }
});

// ── Form submit ───────────────────────────────────────────────────────────
document.getElementById('sectionForm').addEventListener('submit', function(e) {
    const level        = document.getElementById('levelSelect').value;
    const year         = document.getElementById('yearSelect').value;
    const courseVal    = document.getElementById('courseValue').value;
    const sectionInput = document.getElementById('sectionNameInput');
    const typed        = sectionInput.value.trim();

    if (!typed) { e.preventDefault(); alert('Please enter a section name.'); return; }

    const courseAbbr = document.getElementById('courseAbbr').value;
    if (level === 'Junior High School') {
        if (!year) { e.preventDefault(); alert('Please select a year.'); return; }
        sectionInput.value = year + ' - ' + typed;
    } else if (level === 'Senior High School' || level === 'Tertiary') {
        if (!courseVal) { e.preventDefault(); alert('Please select a course/strand.'); return; }
        sectionInput.value = courseAbbr + ' - ' + typed; // use abbreviation for section name e.g. BSIT - 702
    }
});


// ── Level change ──────────────────────────────────────────────────────────
function onLevelChange() {
    const level     = document.getElementById('levelSelect').value;
    const courseDiv = document.getElementById('courseDiv');
    const courseVal = document.getElementById('courseValue');
    const menu      = document.getElementById('courseDropdownMenu');
    const label     = document.getElementById('courseDropdownLabel');
    const yearSelect = document.getElementById('yearSelect');

    yearSelect.innerHTML = '<option value="">Select year...</option>';
    document.getElementById('sectionNameInput').value = '';
    courseVal.value = '';
    label.innerHTML = 'Select course/strand...';
    label.classList.add('text-gray-400');
    menu.innerHTML  = '';
    menu.classList.add('hidden');

    if (!level || !data[level]) {
        courseDiv.classList.remove('hidden');
        return;
    }

    if (level === 'Junior High School') {
        courseDiv.classList.add('hidden');
        courseVal.value = 'Junior High School';
    } else {
        courseDiv.classList.remove('hidden');
        data[level].courses.forEach(c => {
            const div = document.createElement('div');
            div.className = 'px-4 py-2 text-sm cursor-pointer hover:bg-blue-50 hover:text-blue-700';
            div.innerHTML = c.label + ' <strong>(' + c.abbr + ')</strong>';
            div.onclick   = () => selectCourse(c.abbr, c.label);
            menu.appendChild(div);
        });
    }

    data[level].years.forEach(y => {
        const o = document.createElement('option');
        o.value = o.textContent = y;
        yearSelect.appendChild(o);
    });
}
</script>
}

