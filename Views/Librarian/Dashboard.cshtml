@using BookHiveLibrary.Models
@{
    Layout = "~/Views/Shared/_LibrarianLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<!-- Stat Cards -->
<div class="grid grid-cols-5 gap-4 mb-6">
    <a href="#" onclick="openActiveUsersModal(); return false;"
       class="rounded-xl p-5 text-white shadow-sm hover:opacity-90 transition block text-center" style="background-color:#000147;">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-200 mb-2">Active Users</p>
        <p class="text-4xl font-bold" data-stat="active-users">@ViewBag.ActiveUsers</p>
    </a>
    <a href="@Url.Action("Index","Borrow")"
       class="rounded-xl p-5 text-white shadow-sm hover:opacity-90 transition block text-center" style="background-color:#000147;">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-200 mb-2">Book Borrowed</p>
        <p class="text-4xl font-bold">@ViewBag.BookBorrowed</p>
    </a>
    <a href="@Url.Action("Index","Borrow")"
       class="rounded-xl p-5 text-white shadow-sm hover:opacity-90 transition block text-center" style="background-color:#000147;">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-200 mb-2">Book Reservation</p>
        <p class="text-4xl font-bold">@ViewBag.Reservations</p>
    </a>
    <a href="@Url.Action("Transaction","Computer")"
       class="rounded-xl p-5 text-white shadow-sm hover:opacity-90 transition block text-center" style="background-color:#000147;">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-200 mb-2">Computer In Use</p>
        <p class="text-4xl font-bold">@ViewBag.ComputerInUse</p>
    </a>
    <a href="@Url.Action("Transaction","Computer")"
       class="rounded-xl p-5 text-white shadow-sm hover:opacity-90 transition block text-center" style="background-color:#000147;">
        <p class="text-xs font-semibold uppercase tracking-widest text-blue-200 mb-2">Computer Available</p>
        <p class="text-4xl font-bold">@ViewBag.ComputerAvailable</p>
    </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <!-- Current Borrowers Table -->
    <div class="lg:col-span-2 bg-white rounded-xl shadow-sm overflow-hidden">
        <div class="px-5 py-4 text-white" style="background-color:#000147;">
            <h2 class="font-semibold text-sm">Current Borrowers</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="bh-table">
                <thead>
                    <tr>
                        <th class="px-4 py-3 text-left">Date</th>
                        <th class="px-4 py-3 text-left">Name</th>
                        <th class="px-4 py-3 text-left">Book Title</th>
                        <th class="px-4 py-3 text-left">Due Date</th>
                        <th class="px-4 py-3 text-left">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (ViewBag.CurrentBorrowers != null)
                    {
                        foreach (var r in (List<BookReservation>)ViewBag.CurrentBorrowers)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 text-gray-600">@r.CreatedAt.ToString("MM/dd/yyyy")</td>
                                <td class="px-4 py-3 font-medium text-gray-800">@r.User?.FirstName @r.User?.LastName</td>
                                <td class="px-4 py-3 text-gray-600">@r.Book?.Title</td>
                                <td class="px-4 py-3 text-gray-600">@r.DueDate?.ToString("MM/dd/yyyy")</td>
                                <td class="px-4 py-3">
                                    @if (r.Status == "Overdue")
                                    {
                                        <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs font-medium">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">Active</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    @if (ViewBag.CurrentBorrowers == null || ((List<BookReservation>)ViewBag.CurrentBorrowers).Count == 0)
                    {
                        <tr><td colspan="5" class="px-4 py-8 text-center text-gray-400 text-sm">No active borrowers</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Active Users Modal -->
    <div id="activeUsersModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4 overflow-hidden">
            <div class="px-6 py-4 flex items-center justify-between" style="background-color:#000147;">
                <h3 class="text-sm font-semibold text-white">Users Currently Inside the Library</h3>
                <button onclick="closeActiveUsersModal()" class="text-white/70 hover:text-white">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div id="activeUsersList" class="divide-y divide-gray-100 max-h-96 overflow-y-auto">
                <p class="px-6 py-8 text-center text-sm text-gray-400">Loading…</p>
            </div>
        </div>
    </div>

    <!-- Right panels -->
    <div class="space-y-4">
        <!-- Reservation List -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 text-white" style="background-color:#000147;">
                <h2 class="font-semibold text-sm">Reservation List</h2>
            </div>
            <div class="px-5 py-3 space-y-3 max-h-52 overflow-y-auto">
                @if (ViewBag.ReservationList != null)
                {
                    foreach (var r in (List<BookReservation>)ViewBag.ReservationList)
                    {
                        <a href="@Url.Action("Index","Borrow")" class="flex items-start gap-3 hover:bg-gray-50 rounded-lg px-2 py-1 -mx-2 transition cursor-pointer">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background-color:#000147;">
                                @r.User?.FirstName?.FirstOrDefault()
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-800">@r.User?.FirstName @r.User?.LastName</p>
                                <p class="text-xs text-gray-500">@r.Book?.Title</p>
                            </div>
                        </a>
                    }
                }
                @if (ViewBag.ReservationList == null || ((List<BookReservation>)ViewBag.ReservationList).Count == 0)
                {
                    <p class="text-sm text-gray-400 text-center py-4">No pending reservations</p>
                }
            </div>
        </div>

        <!-- Book Dues -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 text-white" style="background-color:#000147;">
                <h2 class="font-semibold text-sm">Book Dues</h2>
            </div>
            <div class="px-5 py-3 space-y-3 max-h-52 overflow-y-auto">
                @if (ViewBag.BookDues != null)
                {
                    foreach (var r in (List<BookReservation>)ViewBag.BookDues)
                    {
                        <div class="flex items-center gap-3">
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-gray-800 truncate">@r.Book?.Title</p>
                                <p class="text-xs text-gray-500">@r.User?.FirstName @r.User?.LastName &bull; Due @r.DueDate?.ToString("MM/dd")</p>
                            </div>
                            <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs flex-shrink-0">Due Soon</span>
                        </div>
                    }
                }
                @if (ViewBag.BookDues == null || ((List<BookReservation>)ViewBag.BookDues).Count == 0)
                {
                    <p class="text-sm text-gray-400 text-center py-4">No upcoming dues</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function openActiveUsersModal() {
    document.getElementById('activeUsersModal').classList.remove('hidden');
    const list = document.getElementById('activeUsersList');
    list.innerHTML = '<p class="px-6 py-8 text-center text-sm text-gray-400">Loading…</p>';
    try {
        const res  = await fetch('/Librarian/GetActiveUsers');
        const data = await res.json();
        if (!data.length) {
            list.innerHTML = '<p class="px-6 py-8 text-center text-sm text-gray-400">No users currently inside the library.</p>';
            return;
        }
        list.innerHTML = data.map(u => `
            <div class="flex items-center gap-4 px-6 py-3 hover:bg-gray-50">
                <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0" style="background-color:#000147;">
                    ${u.name.charAt(0).toUpperCase()}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-800">${u.name}</p>
                    <p class="text-xs text-gray-400">${u.section || u.userType}</p>
                </div>
                <div class="text-right flex-shrink-0">
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-green-100 text-green-700">${u.userType}</span>
                    <p class="text-xs text-gray-400 mt-0.5">Tapped in ${u.tapIn}</p>
                </div>
            </div>`).join('');
    } catch {
        list.innerHTML = '<p class="px-6 py-8 text-center text-sm text-gray-400">Could not load data.</p>';
    }
}
function closeActiveUsersModal() {
    document.getElementById('activeUsersModal').classList.add('hidden');
}
document.getElementById('activeUsersModal').addEventListener('click', function(e) {
    if (e.target === this) closeActiveUsersModal();
});

// ── Real-time dashboard updates ──────────────────────────────────────────
async function refreshActiveUsersCount() {
    try {
        const res  = await fetch('/Librarian/GetActiveUsers');
        const data = await res.json();
        const el   = document.querySelector('[data-stat="active-users"]');
        if (el) el.textContent = data.length;
    } catch {}
}

libraryConnection.on('LibraryEntryUpdated', function() {
    refreshActiveUsersCount();
    // If the modal is open, refresh its content too
    if (!document.getElementById('activeUsersModal').classList.contains('hidden'))
        openActiveUsersModal();
});

libraryConnection.on('BookTransactionUpdated', function() {
    // Reload the current borrowers table
    location.reload();
});
</script>
}
