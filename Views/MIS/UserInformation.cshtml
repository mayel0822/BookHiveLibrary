@using BookHiveLibrary.Models
@model IEnumerable<ApplicationUser>
@{
    Layout = "~/Views/Shared/_MISLayout.cshtml";
    ViewData["Title"] = "User Information";
    var activeFilter = ViewBag.RoleFilter as string ?? "All";
}

<!-- Search + Filter Row -->
<form method="get" action="@Url.Action("UserInformation","MIS")" class="flex items-center gap-3 mb-6 w-full">
    @{ var roles = new[] { "All", "Student", "Librarian", "Professor" }; }
    <select name="roleFilter" onchange="this.form.submit()"
            class="border border-gray-300 rounded-xl px-4 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white">
        @foreach (var r in roles)
        {
            <option value="@r" selected="@(r == activeFilter)">@r</option>
        }
    </select>

    <div class="flex items-center border border-gray-300 rounded-xl overflow-hidden flex-1 focus-within:ring-2 focus-within:ring-blue-400 bg-white">
        <input type="text" name="search" value="@ViewBag.Search"
               placeholder="Search by name, ID, email..."
               class="flex-1 px-4 py-2 text-sm focus:outline-none" />
        <button type="submit" class="text-white px-4 py-2 text-sm hover:opacity-90 flex-shrink-0" style="background-color:#000147;">
            Search
        </button>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
    {
        <a href="@Url.Action("UserInformation","MIS", new { roleFilter = activeFilter })"
           class="text-gray-400 hover:text-gray-600 transition" title="Clear search">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </a>
    }
</form>

<!-- Table -->
<div class="bg-white rounded-2xl shadow overflow-hidden overflow-x-auto max-h-[32rem] overflow-y-auto">
    <table class="bh-table">
        <thead>
            <tr>
                <th>ID / Emp. No.</th>
                <th>Last Name</th>
                <th>First Name</th>
                <th>Role</th>
                <th>Section</th>
                <th>Email</th>
                <th>Phone No.</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr class="border-b hover:bg-blue-50 cursor-pointer transition"
                    onclick="window.location='@Url.Action("Detail","MIS", new { id = user.Id })'">
                    <td class="px-5 py-3 text-gray-500 font-mono text-xs">
                        @(user.UserType == "Student" ? user.StudentNumber : user.EmployeeNumber)
                    </td>
                    <td class="px-5 py-3 font-medium text-gray-800">@user.LastName</td>
                    <td class="px-5 py-3 text-gray-700">@user.FirstName</td>
                    <td class="px-5 py-3">
                        <span class="px-2 py-1 rounded-full text-xs font-medium
                            @(user.UserType == "Librarian" ? "bg-indigo-100 text-indigo-700" :
                              user.UserType == "Student"   ? "bg-green-100 text-green-700"   :
                              "bg-blue-100 text-blue-700")">
                            @user.UserType
                        </span>
                    </td>
                    <td class="px-5 py-3 text-gray-500">@(string.IsNullOrEmpty(user.Section) ? "—" : user.Section)</td>
                    <td class="px-5 py-3 text-gray-500">@user.Email</td>
                    <td class="px-5 py-3 text-gray-500">@(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                    <td class="px-5 py-3">
                        @if (user.IsActive)
                        { <span class="bg-green-100 text-green-700 text-xs px-2 py-1 rounded-full">Active</span> }
                        else
                        { <span class="bg-gray-100 text-gray-500 text-xs px-2 py-1 rounded-full">Inactive</span> }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="px-5 py-12 text-center text-gray-400">
                        No accounts found.
                        <a href="@Url.Action("Registration","MIS")" class="text-blue-500 hover:underline ml-1">Register one →</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
