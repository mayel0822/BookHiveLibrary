@model BookHiveLibrary.ViewModels.MISCreateUserViewModel
@{
    Layout = "~/Views/Shared/_MISLayout.cshtml";
    ViewData["Title"] = "Create " + Model.Role;
}

<div class="max-w-2xl pt-6">

    <div class="mb-6 flex items-end justify-between">
        <div>
            <a href="/MIS/@(Model.Role)s" class="text-gray-400 hover:text-gray-600 text-sm">← Back</a>
            <h1 class="text-3xl font-bold text-gray-800 mt-2">Create @Model.Role Account</h1>
        </div>
        <button type="button" onclick="document.getElementById('misImportModal').classList.remove('hidden')"
                class="flex items-center gap-2 px-4 py-2 text-sm text-white rounded-lg font-medium" style="background-color:#000147;">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            Import Excel
        </button>
    </div>

    <!-- Import Excel Modal -->
    <div id="misImportModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
        <div class="bg-white rounded-2xl shadow-xl w-[520px] overflow-hidden">
            <div class="px-6 py-4 flex items-center justify-between border-b border-gray-100">
                <h3 class="text-base font-semibold text-gray-800">Import Users from Excel</h3>
                <button type="button" onclick="document.getElementById('misImportModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="px-6 py-5">
                <div class="mb-4 p-3 bg-gray-50 rounded-lg border border-gray-200 text-xs text-gray-500 space-y-1">
                    <p class="font-semibold text-gray-700 mb-1">Required column order (Row 1 = header):</p>
                    <p>A: User Type &nbsp;|&nbsp; B: First Name &nbsp;|&nbsp; C: Middle Name &nbsp;|&nbsp; D: Last Name</p>
                    <p>E: Email &nbsp;|&nbsp; F: Password &nbsp;|&nbsp; G: Phone &nbsp;|&nbsp; H: Student No. &nbsp;|&nbsp; I: Employee No. &nbsp;|&nbsp; J: RFID No.</p>
                </div>
                <form method="post" action="@Url.Action("ImportExcel","MIS")" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div id="misDropZone"
                         ondragover="event.preventDefault(); this.classList.add('border-indigo-400','bg-indigo-50')"
                         ondragleave="this.classList.remove('border-indigo-400','bg-indigo-50')"
                         ondrop="handleMisDrop(event)"
                         onclick="document.getElementById('misExcelInput').click()"
                         class="border-2 border-dashed border-gray-300 rounded-xl p-8 flex flex-col items-center justify-center gap-2 cursor-pointer hover:border-indigo-400 hover:bg-indigo-50 transition">
                        <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                        <p class="text-sm text-gray-500">Drag & drop your Excel file here or</p>
                        <span class="text-sm font-medium text-indigo-600 hover:underline">Browse file</span>
                        <p id="misFileName" class="text-xs text-gray-400 mt-1">No file selected</p>
                        <input type="file" id="misExcelInput" name="file" accept=".xlsx" class="hidden"
                               onchange="document.getElementById('misFileName').textContent = this.files[0]?.name ?? 'No file selected'" />
                    </div>
                    <div class="flex gap-3 justify-end mt-4">
                        <button type="button" onclick="document.getElementById('misImportModal').classList.add('hidden')"
                                class="px-5 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200">Cancel</button>
                        <button type="submit" class="px-5 py-2 text-white rounded-lg text-sm font-medium" style="background-color:#000147;">Import Users</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <form method="post" asp-action="Create" asp-controller="MIS" class="bg-white rounded-2xl shadow p-8 space-y-5">
        <input type="hidden" asp-for="Role" />

        <!-- Name -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="FirstName" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                <span asp-validation-for="FirstName" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="MiddleName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="MiddleName" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>
            <div>
                <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="LastName" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                <span asp-validation-for="LastName" class="text-red-500 text-xs"></span>
            </div>
        </div>

        <!-- Email -->
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input asp-for="Email" type="email" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" placeholder="e.g. user@sti.edu.ph" />
            <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
        </div>

        <!-- Password -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="Password" type="password" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="ConfirmPassword" type="password" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
            </div>
        </div>

        <!-- Role-specific IDs -->
        @if (Model.Role == "Student")
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StudentNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="StudentNumber" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                </div>
                <div>
                    <label asp-for="Section" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Section" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                </div>
            </div>
        }
        else
        {
            <div>
                <label asp-for="EmployeeNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="EmployeeNumber" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>
        }

        <!-- Contact -->
        @if (Model.Role == "Student")
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="PhoneNumber" type="tel" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                </div>
                <div>
                    <label asp-for="RFIDNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="RFIDNumber" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
                </div>
            </div>
        }
        else
        {
            <div>
                <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
                <input asp-for="PhoneNumber" type="tel" class="w-full border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" />
            </div>
        }

        <div class="flex gap-3 pt-2 justify-end">
            <a href="/MIS/@(Model.Role)s"
               class="px-6 py-2.5 rounded-xl text-sm border border-gray-300 text-gray-600 hover:bg-gray-50">
                Cancel
            </a>
            <button type="submit" class="bg-indigo-700 text-white px-6 py-2.5 rounded-xl text-sm hover:bg-indigo-800">
                Create Account
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<script>
function handleMisDrop(e) {
    e.preventDefault();
    document.getElementById('misDropZone').classList.remove('border-indigo-400','bg-indigo-50');
    const file = e.dataTransfer.files[0];
    if (!file) return;
    const dt = new DataTransfer();
    dt.items.add(file);
    document.getElementById('misExcelInput').files = dt.files;
    document.getElementById('misFileName').textContent = file.name;
}
</script>
}
