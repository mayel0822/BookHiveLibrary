@using Microsoft.AspNetCore.Identity
@using BookHiveLibrary.Models
@inject UserManager<ApplicationUser> _layoutUserManager
@{
    var currentUser = await _layoutUserManager.GetUserAsync(User);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var libFirstName = !string.IsNullOrWhiteSpace(currentUser?.FirstName)
        ? currentUser.FirstName
        : User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="en" class="@(currentUser?.DarkMode == true ? "dark" : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookHive Library</title>
    <link rel="stylesheet" href="~/css/output.css" />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <style>
    .mini-menu-btn{display:flex;align-items:center;gap:6px;width:100%;text-align:left;padding:8px 14px;font-size:12px;background:none;border:none;cursor:pointer;white-space:nowrap;}
    /* Three-dot button hidden by default, shown on message row hover */
    .mini-dots-btn { opacity: 0; transition: opacity 0.15s ease; }
    #miniChatMessages .group:hover .mini-dots-btn { opacity: 1; }
</style>
</head>
<body class="bg-[#dce6f5] flex h-screen overflow-hidden">

<!-- Mobile backdrop -->
<div id="lib-backdrop" class="fixed inset-0 bg-black/40 z-40 hidden" onclick="toggleLibSidebar()"></div>

<!-- Sidebar -->
<aside id="lib-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 text-white flex flex-col shadow-xl transition-transform duration-300 -translate-x-full" style="background-color:#000147;">

    <!-- Logo -->
    <div class="flex items-center px-4 py-5 border-b border-white/10 flex-shrink-0 gap-3">
        <button onclick="toggleLibSidebar()" class="text-white/60 hover:text-white transition flex-shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <a href="@Url.Action("Dashboard","Librarian")" style="font-family:'Dancing Script',cursive;font-size:2rem;font-weight:800;color:white;line-height:1;text-decoration:none;">BookHive</a>
    </div>

    <!-- Nav -->
    <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">

        <!-- Home / Dashboard -->
        <a href="@Url.Action("Dashboard","Librarian")"
           class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(currentAction == "Dashboard" && currentController == "Librarian" ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6"/></svg>
            <span>Home</span>
        </a>

        <!-- User Management -->
        @{
            var isUserMgmt = new[] { "UserManagement", "Sectioning", "StudentActivity" }.Contains(currentAction);
        }
        <div>
            <button onclick="toggleLibMenu('libUserMgmtMenu', this)"
                    class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(isUserMgmt ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span class="flex-1 text-left">User Management</span>
                <svg class="w-4 h-4 transition-transform @(isUserMgmt ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="libUserMgmtMenu" class="mt-1 ml-8 space-y-1 @(isUserMgmt ? "" : "hidden")">
                <a href="@Url.Action("UserManagement","Librarian")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "UserManagement" ? "text-white font-medium" : "")">Users</a>
<a href="@Url.Action("Sectioning","Librarian")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Sectioning" ? "text-white font-medium" : "")">Sectioning</a>
                <a href="@Url.Action("StudentActivity","Librarian")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "StudentActivity" ? "text-white font-medium" : "")">Activity</a>
            </div>
        </div>

        <!-- Transaction Activity -->
        @{
            // "Transaction Activity" is active when:
            //   - On the Borrow controller (book transactions), OR
            //   - On Computer/Transaction specifically (the live session page)
            // This avoids it lighting up alongside Computer Management when on other Computer pages.
            var isTransaction = currentController == "Borrow"
                             || (currentController == "Computer" && currentAction == "Transaction");
        }
        <div>
            <button onclick="toggleLibMenu('libTransMenu', this)"
                    class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(isTransaction ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                <span class="flex-1 text-left">Transaction Activity</span>
                <svg class="w-4 h-4 transition-transform @(isTransaction ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="libTransMenu" class="mt-1 ml-8 space-y-1 @(isTransaction ? "" : "hidden")">
                <a href="@Url.Action("Index","Borrow")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentController == "Borrow" ? "text-white font-medium" : "")">Book</a>
                <a href="@Url.Action("Transaction","Computer")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Transaction" ? "text-white font-medium" : "")">Computer</a>
            </div>
        </div>

        <!-- Book Management -->
        @{ var isBook = currentController == "Book"; }
        <div>
            <button onclick="toggleLibMenu('libBookMenu', this)"
                    class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(isBook ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                <span class="flex-1 text-left">Book Management</span>
                <svg class="w-4 h-4 transition-transform @(isBook ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="libBookMenu" class="mt-1 ml-8 space-y-1 @(isBook ? "" : "hidden")">
                <a href="@Url.Action("Register","Book")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Register" && isBook ? "text-white font-medium" : "")">Book Registration</a>
                <a href="@Url.Action("Index","Book")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Index" && isBook ? "text-white font-medium" : "")">Book Catalog</a>
                <a href="@Url.Action("Archive","Book")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Archive" && isBook ? "text-white font-medium" : "")">Archive Records</a>
            </div>
        </div>

        <!-- Computer Management -->
        @{
            // "Computer Management" is active for all Computer pages EXCEPT the Transaction page
            // (which belongs to Transaction Activity above).
            var isComputer = currentController == "Computer" && currentAction != "Transaction";
        }
        <div>
            <button onclick="toggleLibMenu('libComputerMenu', this)"
                    class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(isComputer ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span class="flex-1 text-left">Computer Management</span>
                <svg class="w-4 h-4 transition-transform @(isComputer ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="libComputerMenu" class="mt-1 ml-8 space-y-1 @(isComputer ? "" : "hidden")">
                <a href="@Url.Action("Register","Computer")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Register" && isComputer ? "text-white font-medium" : "")">Computer Registration</a>
                <a href="@Url.Action("Index","Computer")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Index" && isComputer ? "text-white font-medium" : "")">Computer List</a>
                <a href="@Url.Action("ArchiveList","Computer")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "ArchiveList" ? "text-white font-medium" : "")">Archive Records</a>
            </div>
        </div>

    </nav>
</aside>

<!-- Main Area -->
<div class="flex flex-col flex-1 overflow-hidden">

    <!-- Top Header -->
    <header class="flex items-center justify-between px-6 py-3 shadow-sm flex-shrink-0 border-b border-white/10" style="background-color:#000147;">
        <div class="flex items-center gap-3">
            <button onclick="toggleLibSidebar()" class="text-white/70 hover:text-white transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <a href="@Url.Action("Dashboard","Librarian")" style="font-family:'Dancing Script',cursive;font-size:1.6rem;font-weight:800;color:white;line-height:1;text-decoration:none;">BookHive</a>
        </div>

        <div class="flex items-center gap-4 flex-shrink-0">
            <!-- Messages -->
            <div class="relative flex items-center" id="msgWrapper">
                <button type="button" id="msgBtn" onclick="event.preventDefault();toggleMsgPanel()" class="relative flex items-center text-white/70 hover:text-white focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    <span id="msgBadge" class="hidden absolute -top-1 -right-1 w-4 h-4 text-white text-[10px] font-bold rounded-full flex items-center justify-center" style="background:#e53e3e;"></span>
                </button>
            </div>

            <!-- Notification Bell -->
            <div class="relative flex items-center" id="notifWrapper">
                <button onclick="toggleNotifPanel()" class="relative flex items-center text-white/70 hover:text-white focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                    <span id="notifBadge" class="hidden absolute -top-1 -right-1 w-4 h-4 text-white text-[10px] font-bold rounded-full flex items-center justify-center" style="background:#e53e3e;"></span>
                </button>
                <div id="notifPanel" class="hidden absolute right-0 top-8 w-80 bg-white rounded-xl shadow-lg border border-gray-200 z-50 overflow-hidden">
                    <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between" style="background:#000147;">
                        <span class="text-sm font-semibold text-white">Reservations</span>
                        <span id="notifCount" class="text-xs text-blue-200"></span>
                    </div>
                    <div id="notifList" class="divide-y divide-gray-100 max-h-72 overflow-y-auto">
                        <p class="px-4 py-6 text-center text-sm text-gray-400">Loading…</p>
                    </div>
                    <div class="px-4 py-2.5 border-t border-gray-100 text-center">
                        <a href="@Url.Action("Index","Borrow")" class="text-xs font-medium" class="text-gray-900">View all in Book Transactions →</a>
                    </div>
                </div>
            </div>

            <!-- Profile Dropdown -->
            <div class="relative" id="lib-profile-wrapper">
                <button onclick="toggleLibProfile()" class="flex items-center gap-2 px-3 py-1.5 rounded-lg focus:outline-none transition" style="border:1px solid rgba(255,255,255,0.6);background:rgba(255,255,255,0.1);">
                    <span class="text-sm font-medium text-white hidden sm:inline">@libFirstName</span>
                    <div class="w-7 h-7 rounded-full overflow-hidden flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background-color:#000147;">
                        @if (!string.IsNullOrEmpty(currentUser?.ProfilePicture))
                        {
                            <img src="@currentUser.ProfilePicture" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            @(libFirstName.Length > 0 ? libFirstName[0].ToString().ToUpper() : "L")
                        }
                    </div>
                </button>

                <!-- Profile Dropdown Panel -->
                <div id="lib-profile-panel" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-gray-200 z-50 overflow-hidden">
                    <div class="px-4 py-4 border-b border-gray-100 flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full overflow-hidden flex items-center justify-center text-white text-lg font-bold flex-shrink-0" style="background-color:#000147;">
                            @if (!string.IsNullOrEmpty(currentUser?.ProfilePicture))
                            {
                                <img src="@currentUser.ProfilePicture" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                @(libFirstName.Length > 0 ? libFirstName[0].ToString().ToUpper() : "L")
                            }
                        </div>
                        <div class="min-w-0">
                            <a href="/Librarian/Profile" class="text-sm font-semibold text-gray-900 hover:underline truncate block">
                                @($"{currentUser?.FirstName} {currentUser?.LastName}".Trim().Length > 0 ? $"{currentUser?.FirstName} {currentUser?.LastName}".Trim() : User.Identity?.Name)
                            </a>
                            <p class="text-xs text-gray-400 truncate">@currentUser?.Email</p>
                            <span class="text-[10px] bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full font-semibold mt-1 inline-block">Librarian</span>
                        </div>
                    </div>
                    <form method="post" action="/Account/Logout" class="px-2 py-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 hover:bg-red-50 rounded-lg transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                            Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <!-- Page Content -->
    <main class="flex-1 overflow-y-auto px-4 py-4 sm:px-6 sm:py-6">
        @if (TempData["Success"] != null)
        {
            <div id="flashSuccess" class="mb-4 px-4 py-3 bg-green-100 border border-green-300 text-green-800 rounded-lg text-sm flex items-center gap-2 relative overflow-hidden transition-all duration-500">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span class="flex-1">@TempData["Success"]</span>
                <button onclick="dismissFlash('flashSuccess')" class="ml-2 text-green-600 hover:text-green-900 transition flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
                <div id="flashSuccessBar" class="absolute bottom-0 left-0 h-0.5 bg-green-400" style="width:100%;transition:width 5s linear;"></div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div id="flashError" class="mb-4 px-4 py-3 bg-red-100 border border-red-300 text-red-800 rounded-lg text-sm flex items-center gap-2 relative overflow-hidden transition-all duration-500">
                <svg class="w-4 h-4 flex-shrink-0 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                <span class="flex-1">@TempData["Error"]</span>
                <button onclick="dismissFlash('flashError')" class="ml-2 text-red-500 hover:text-red-800 transition flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
                <div id="flashErrorBar" class="absolute bottom-0 left-0 h-0.5 bg-red-400" style="width:100%;transition:width 5s linear;"></div>
            </div>
        }
        @RenderBody()
    </main>
</div>

<!-- Reusable confirmation dialog (bhConfirm()) — styled replacement for the
     browser's native confirm(), same look as the End Session dialog on the
     Transaction page. One shared instance; content is swapped in per call. -->
<div id="bhConfirmModal" class="fixed inset-0 bg-black/40 flex items-center justify-center z-[9999] hidden">
    <div class="bg-white rounded-2xl shadow-2xl w-80 mx-4 overflow-hidden">
        <div class="px-6 pt-6 pb-4 text-center">
            <h3 id="bhConfirmTitle" class="text-base font-bold text-gray-900 mb-1">Are you sure?</h3>
            <p id="bhConfirmMessage" class="text-sm text-gray-500"></p>
        </div>
        <div class="px-6 pb-5 flex gap-3">
            <button id="bhConfirmCancelBtn" type="button" class="flex-1 px-4 py-2.5 text-sm font-medium border border-gray-300 text-gray-700 rounded-xl hover:bg-gray-50 transition">Cancel</button>
            <button id="bhConfirmYesBtn" type="button" class="flex-1 px-4 py-2.5 text-sm font-semibold text-white rounded-xl bg-red-500 hover:bg-red-600 transition">Confirm</button>
        </div>
    </div>
</div>

<script>
// Promise-based replacement for window.confirm() — resolves true/false once
// the user picks a button, styled to match the rest of the app instead of
// the browser's native (and unstyleable) confirm dialog.
//   const ok = await bhConfirm('Delete this section?');
function bhConfirm(message, title) {
    return new Promise(resolve => {
        const modal = document.getElementById('bhConfirmModal');
        document.getElementById('bhConfirmTitle').textContent   = title || 'Are you sure?';
        document.getElementById('bhConfirmMessage').textContent = message || '';
        modal.classList.remove('hidden');

        const yesBtn    = document.getElementById('bhConfirmYesBtn');
        const cancelBtn = document.getElementById('bhConfirmCancelBtn');

        function cleanup(result) {
            modal.classList.add('hidden');
            yesBtn.onclick = null;
            cancelBtn.onclick = null;
            resolve(result);
        }
        yesBtn.onclick    = () => cleanup(true);
        cancelBtn.onclick = () => cleanup(false);
    });
}

// Helper for a <form onsubmit="return bhConfirmSubmit(event, '...')"> —
// blocks the native submit, shows bhConfirm, then submits the form for real
// if the user confirms. Needed because a form's onsubmit must return
// true/false immediately, which an async dialog can't do directly.
function bhConfirmSubmit(event, message, title) {
    event.preventDefault();
    event.stopPropagation();
    const form = event.target;
    bhConfirm(message, title).then(ok => { if (ok) form.submit(); });
    return false;
}

function toggleLibSidebar() {
    const sidebar  = document.getElementById('lib-sidebar');
    const backdrop = document.getElementById('lib-backdrop');
    const hidden   = sidebar.classList.contains('-translate-x-full');
    sidebar.classList.toggle('-translate-x-full', !hidden);
    backdrop.classList.toggle('hidden', !hidden);
}
// Close sidebar when any nav link is clicked
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('#lib-sidebar nav a').forEach(function(link) {
        link.addEventListener('click', function() {
            document.getElementById('lib-sidebar').classList.add('-translate-x-full');
            document.getElementById('lib-backdrop').classList.add('hidden');
        });
    });
});

function toggleLibMenu(menuId, btn) {
    const menu  = document.getElementById(menuId);
    const arrow = btn.querySelector('svg:last-child');
    menu.classList.toggle('hidden');
    if (arrow) arrow.classList.toggle('rotate-180');
}

function toggleLibProfile() {
    document.getElementById('lib-profile-panel').classList.toggle('hidden');
}
document.addEventListener('click', function(e) {
    const pw = document.getElementById('lib-profile-wrapper');
    if (pw && !pw.contains(e.target))
        document.getElementById('lib-profile-panel').classList.add('hidden');
});

function toggleNotifPanel() {
    const panel = document.getElementById('notifPanel');
    panel.classList.toggle('hidden');
    if (!panel.classList.contains('hidden')) loadNotifications();
}
document.addEventListener('click', function(e) {
    const wrapper = document.getElementById('notifWrapper');
    if (wrapper && !wrapper.contains(e.target))
        document.getElementById('notifPanel').classList.add('hidden');
});

// --- Notification read-state (stored in localStorage) ---
function getSeenIds() {
    try { return new Set(JSON.parse(localStorage.getItem('notif_seen') || '[]')); } catch { return new Set(); }
}
function markNotifSeen(id) {
    try {
        const seen = getSeenIds();
        seen.add(id);
        localStorage.setItem('notif_seen', JSON.stringify([...seen]));
    } catch {}
}
// Remove IDs that are no longer pending (reservation was handled) to keep storage tidy
function pruneSeenIds(activeIds) {
    try {
        const seen = getSeenIds();
        const pruned = [...seen].filter(id => activeIds.includes(id));
        localStorage.setItem('notif_seen', JSON.stringify(pruned));
    } catch {}
}

async function loadNotifications() {
    const list = document.getElementById('notifList');
    try {
        const res  = await fetch('/Librarian/GetNotifications');
        const data = await res.json();

        const activeIds = data.items.map(n => n.id);
        pruneSeenIds(activeIds);
        const seen = getSeenIds();
        const unseenCount = activeIds.filter(id => !seen.has(id)).length;

        updateBadge(unseenCount);
        document.getElementById('notifCount').textContent = data.count > 0 ? data.count + ' pending' : 'No pending';

        if (!data.items.length) {
            list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">No pending reservations</p>';
            return;
        }
        list.innerHTML = data.items.map(n => {
            const isSeen = seen.has(n.id);
            return `
            <div class="px-4 py-3 cursor-pointer transition-colors ${isSeen ? 'bg-gray-50' : 'bg-white hover:bg-gray-50'}"
                 onclick="onNotifClick(${n.id}, '${n.user.replace(/'/g,"\\'")}', '${n.userType}', '${n.book.replace(/'/g,"\\'")}', '${n.createdAt}')">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5 ${isSeen ? 'bg-gray-300 text-gray-600' : 'text-white'}"
                         ${isSeen ? '' : 'style="background:#000147;"'}>
                        ${n.user.charAt(0).toUpperCase()}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate ${isSeen ? 'text-gray-400' : 'text-gray-800'}">${n.user} <span class="text-xs font-normal text-gray-400 ml-1">${n.userType}</span></p>
                        <p class="text-xs text-gray-400 truncate">Reserved: <span class="${isSeen ? 'text-gray-400' : 'font-medium text-gray-700'}">${n.book}</span></p>
                        <p class="text-xs text-gray-400 mt-0.5">${n.createdAt}</p>
                    </div>
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full flex-shrink-0 ${isSeen ? 'bg-gray-100 text-gray-400' : 'bg-yellow-100 text-yellow-700'}">Pending</span>
                </div>
            </div>`;
        }).join('');
    } catch {
        list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">Could not load notifications</p>';
    }
}

function onNotifClick(id, user, userType, book, createdAt) {
    markNotifSeen(id);
    // Decrement badge immediately
    const badge = document.getElementById('notifBadge');
    const current = parseInt(badge.textContent) || 0;
    updateBadge(Math.max(0, current - 1));
    // Re-render list so clicked item goes gray
    loadNotifications();
    // Open the detail modal
    openReservationDetail(id, user, userType, book, createdAt);
}

function updateBadge(count) {
    const badge = document.getElementById('notifBadge');
    if (count > 0) { badge.textContent = count > 9 ? '9+' : count; badge.classList.remove('hidden'); }
    else { badge.classList.add('hidden'); }
}

// Initial badge load
async function pollBadge() {
    try {
        const res = await fetch('/Librarian/GetNotifications');
        const data = await res.json();
        const seen = getSeenIds();
        const unseenCount = data.items.filter(n => !seen.has(n.id)).length;
        updateBadge(unseenCount);
    } catch {}
}
pollBadge();

async function pollMsgBadge() {
    try {
        const res  = await fetch('/Message/UnreadCount');
        const data = await res.json();
        updateMsgBadge(data.count);
    } catch {}
}
pollMsgBadge();

function updateMsgBadge(count) {
    const badge = document.getElementById('msgBadge');
    if (!badge) return;
    if (count > 0) { badge.textContent = count > 9 ? '9+' : count; badge.classList.remove('hidden'); }
    else { badge.classList.add('hidden'); }
}

// ── SignalR real-time ─────────────────────────────────────────────────────
const libraryConnection = new signalR.HubConnectionBuilder()
    .withUrl('/hubs/library')
    .withAutomaticReconnect()
    .build();

libraryConnection.on('NewReservation', function(n) {
    // Increment notification badge
    const badge = document.getElementById('notifBadge');
    const current = parseInt(badge.textContent) || 0;
    const next = current + 1;
    badge.textContent = next > 9 ? '9+' : next;
    badge.classList.remove('hidden');

    // Prepend to notification list if open
    const list = document.getElementById('notifList');
    const countEl = document.getElementById('notifCount');
    if (countEl) countEl.textContent = (next) + ' pending';
    const item = document.createElement('div');
    item.className = 'px-4 py-3 hover:bg-gray-50 cursor-pointer border-b border-gray-50 bg-yellow-50';
    item.innerHTML = `
        <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0 mt-0.5" style="background:#000147;">
                ${n.user.charAt(0).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-800 truncate">${n.user} <span class="text-xs font-normal text-gray-400 ml-1">${n.userType}</span></p>
                <p class="text-xs text-gray-500 truncate">Reserved: <span class="font-medium text-gray-700">${n.book}</span></p>
                <p class="text-xs text-gray-400 mt-0.5">${n.createdAt}</p>
            </div>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700 flex-shrink-0">Pending</span>
        </div>`;
    if (list.firstChild) list.insertBefore(item, list.firstChild);
    else list.appendChild(item);
});

libraryConnection.on('ReceiveMessage', function(msg) {
    // Update badge
    const badge = document.getElementById('msgBadge');
    if (badge) {
        const current = parseInt(badge.textContent) || 0;
        const next = current + 1;
        badge.textContent = next > 9 ? '9+' : next;
        badge.classList.remove('hidden');
    }
    // Show message popup toast
    showMessageToast(msg);
    // If chat modal is open for this sender, refresh messages
    if (_chatUserId && msg.senderId === _chatUserId) loadChatMessages();
});

// When the other person unsends a message, replace its bubble instantly
libraryConnection.on('MessageUnsent', function(data) {
    const el = document.getElementById('chatmsg-' + data.id);
    if (el) {
        el.innerHTML = '<span class="text-xs italic text-gray-400 px-3 py-1 border border-gray-200 rounded-2xl">Message unsent</span>';
    }
});

function showMessageToast(msg) {
    const toast = document.getElementById('msgToast');
    if (!toast) return;
    document.getElementById('toastSender').textContent  = msg.senderName || 'Someone';
    document.getElementById('toastTime').textContent    = msg.sentAt     || '';
    document.getElementById('toastPreview').textContent = msg.content    ? (msg.content.length > 80 ? msg.content.slice(0, 80) + '…' : msg.content) : '📎 Message';
    document.getElementById('toastLink').href           = '/Message/Index';
    toast.classList.remove('translate-x-full', 'opacity-0');
    toast.classList.add('translate-x-0', 'opacity-100');
    clearTimeout(window._toastTimer);
    window._toastTimer = setTimeout(() => dismissMessageToast(), 6000);
}
function dismissMessageToast() {
    const toast = document.getElementById('msgToast');
    if (!toast) return;
    toast.classList.remove('translate-x-0', 'opacity-100');
    toast.classList.add('translate-x-full', 'opacity-0');
}

// ── Flash message auto-dismiss (5 s) ─────────────────────────────────────
function dismissFlash(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.style.opacity = '0';
    el.style.maxHeight = '0';
    el.style.marginBottom = '0';
    el.style.paddingTop = '0';
    el.style.paddingBottom = '0';
    setTimeout(() => el.remove(), 500);
}
(function() {
    ['flashSuccess', 'flashError'].forEach(function(id) {
        const el = document.getElementById(id);
        if (!el) return;
        // Start the shrinking progress bar after a tiny delay so CSS transition fires
        const bar = document.getElementById(id + 'Bar');
        if (bar) requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.width = '0%'; }));
        // Auto-dismiss after 5 s
        setTimeout(() => dismissFlash(id), 5000);
    });
})();

// Group membership is tied to the connection id, so re-join on every reconnect.
function _joinLibrarian() {
    libraryConnection.invoke("JoinLibrarian").catch(err => console.error('JoinLibrarian error:', err));
}

window._libConnected = libraryConnection.start()
    .then(_joinLibrarian)
    .catch(err => console.error('SignalR error:', err));

libraryConnection.onreconnected(_joinLibrarian);

// ── Message Panel ────────────────────────────────────────────────────────
let msgPanelOpen = false;
let _msgConvos   = [];

async function toggleMsgPanel() {
    msgPanelOpen = !msgPanelOpen;
    const panel = document.getElementById('msgPanel');
    if (!msgPanelOpen) { panel.style.display = 'none'; return; }
    const btn  = document.getElementById('msgBtn');
    const rect = btn.getBoundingClientRect();
    panel.style.top   = (rect.bottom + 8) + 'px';
    panel.style.right = Math.max(8, window.innerWidth - rect.right) + 'px';
    panel.style.left  = 'auto';
    panel.style.display = 'block';
    await loadMsgPanel();
}

async function loadMsgPanel() {
    const list = document.getElementById('msgPanelList');
    list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">Loading…</p>';
    try {
        _msgConvos = await fetch('/Message/GetConversationList').then(r => r.json());
        renderMsgPanelList(list, _msgConvos);
    } catch {
        list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-red-400">Could not load messages</p>';
    }
}

function renderMsgPanelList(list, convos) {
    if (!convos.length) { list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">No messages yet</p>'; return; }
    list.innerHTML = convos.map(c => msgConvoRow(c, false)).join('');
}

function escQ(s) { return (s||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }
function escHtml(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
const _tok = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

// ── Conversation row (sidebar + dropdown) ────────────────────────────────
function msgConvoRow(c, active) {
    return `<div class="msg-convo-row flex items-center gap-3 px-4 py-3 cursor-pointer transition ${active ? 'bg-blue-50' : 'hover:bg-gray-50'}"
         id="mconvo-${c.userId}"
         onclick="openMsgChat('${c.userId}','${escQ(c.name)}','${c.userType}')">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0" style="background-color:#000147;">
            ${c.name.charAt(0).toUpperCase()}
        </div>
        <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-gray-800 truncate" id="mconvo-name-${c.userId}">${c.name}</p>
                <span class="text-[10px] text-gray-400 ml-2 flex-shrink-0">${c.sentAt}</span>
            </div>
            <p class="text-xs text-gray-500 truncate">${c.lastMsgUnsent ? '<em>Message unsent</em>' : (c.lastMsg||'…')}</p>
        </div>
        <div class="flex items-center gap-1 flex-shrink-0">
            ${c.unread > 0 ? `<span class="w-5 h-5 rounded-full text-white text-[10px] font-bold flex items-center justify-center" style="background:#e53e3e;">${c.unread}</span>` : ''}
            <button onclick="event.stopPropagation();showConvoMenuModal(event,'${c.userId}')"
                    id="mdots-${c.userId}"
                    class="w-6 h-6 flex items-center justify-center rounded hover:bg-gray-200 text-gray-400 hover:text-gray-600 transition flex-shrink-0">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm0 6a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm0 6a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5z"/></svg>
            </button>
        </div>
    </div>`;
}

document.addEventListener('click', function(e) {
    // Close msg dropdown
    if (!e.target.closest('#msgWrapper') && !e.target.closest('#msgPanel') && !e.target.closest('#miniChatPopup')) {
        const _p = document.getElementById('msgPanel'); if (_p) _p.style.display = 'none';
        msgPanelOpen = false;
    }
    // Close mini chat bubble menus. Checks the dots button by its id prefix
    // rather than the .mini-dots-btn class — that class already carries an
    // opacity:0 hover-reveal rule above meant for a .group-hover pattern that
    // was never actually wired to a "group" ancestor, so adding the class
    // here just to satisfy this check would make the button permanently
    // invisible instead of only hidden until row-hover.
    if (!e.target.closest('.mini-chat-bubble') && !e.target.closest('.mini-msg-menu') && !e.target.closest('[id^="minidots-"]'))
        document.querySelectorAll('.mini-msg-menu').forEach(m => m.style.display = 'none');
    // Close message bubble menus
    if (!e.target.closest('.chat-msg-bubble') && !e.target.closest('.chat-msg-menu'))
        document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    // Close convo 3-dot menu
    const gcm = document.getElementById('globalConvoMenuModal');
    if (gcm && !e.target.closest('#globalConvoMenuModal') && !e.target.closest('[id^="mdots-"]')) {
        gcm.style.display = 'none'; _activeConvoMenuUser = null;
    }
});

// ── Conversation 3-dot menu ──────────────────────────────────────────────
let _activeConvoMenuUser = null;

function _ensureConvoMenu() {
    if (document.getElementById('globalConvoMenuModal')) return;
    const m = document.createElement('div');
    m.id = 'globalConvoMenuModal';
    m.style.cssText = 'position:fixed;z-index:10000;background:white;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);min-width:180px;overflow:hidden;font-size:13px;display:none;';
    m.innerHTML = `
        <div style="padding:7px 14px 5px;font-size:10px;font-weight:700;letter-spacing:.08em;color:#9ca3af;text-transform:uppercase;border-bottom:1px solid #f3f4f6;">Conversation</div>
        <button id="gcmm-important" class="w-full text-left px-4 py-2.5 hover:bg-amber-50 flex items-center gap-3" style="color:#b45309;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/></svg>
            Mark as Important
        </button>
        <div style="height:1px;background:#f3f4f6;margin:2px 0;"></div>
        <button id="gcmm-delete" class="w-full text-left px-4 py-2.5 hover:bg-red-50 flex items-center gap-3" style="color:#dc2626;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
            Delete Conversation
        </button>`;
    document.body.appendChild(m);
}

function showConvoMenuModal(event, userId) {
    _ensureConvoMenu();
    const menu = document.getElementById('globalConvoMenuModal');
    if (_activeConvoMenuUser === userId && menu.style.display !== 'none') {
        menu.style.display = 'none'; _activeConvoMenuUser = null; return;
    }
    _activeConvoMenuUser = userId;
    document.getElementById('gcmm-important').onclick = (e) => { e.stopPropagation(); markImportantModal(userId); menu.style.display='none'; _activeConvoMenuUser=null; };
    document.getElementById('gcmm-delete').onclick    = (e) => { e.stopPropagation(); deleteConversationModal(userId); menu.style.display='none'; _activeConvoMenuUser=null; };
    const btn  = event.target.closest('button') || event.currentTarget;
    const rect = btn ? btn.getBoundingClientRect() : { right: event.clientX, bottom: event.clientY };
    menu.style.display = 'block';
    menu.style.left = Math.min(rect.right - 180, window.innerWidth - 190) + 'px';
    menu.style.top  = Math.min(rect.bottom + 4, window.innerHeight - 100) + 'px';
}

function markImportantModal(userId) {
    const el = document.getElementById('mconvo-name-' + userId);
    if (el && !el.textContent.startsWith('⭐')) el.textContent = '⭐ ' + el.textContent;
}

async function deleteConversationModal(userId) {
    if (!confirm('Delete this entire conversation? This cannot be undone.')) return;
    const fd = new FormData();
    fd.append('otherUserId', userId);
    fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/DeleteConversation', { method: 'POST', body: fd });
    if (!res.ok) return;
    _msgConvos = _msgConvos.filter(c => c.userId !== userId);
    document.getElementById('chat-sidebar').innerHTML = _msgConvos.map(c => msgConvoRow(c, c.userId === _chatUserId)).join('');
    document.getElementById('msgPanelList').innerHTML = _msgConvos.length
        ? _msgConvos.map(c => msgConvoRow(c, false)).join('')
        : '<p class="px-4 py-6 text-center text-sm text-gray-400">No messages yet</p>';
    if (_chatUserId === userId) {
        _chatUserId = '';
        document.getElementById('chat-messages').innerHTML = '<p class="text-center text-sm text-gray-400 py-8">Select a conversation to start</p>';
        document.getElementById('chat-name').textContent = 'Select a conversation';
        document.getElementById('chat-type').textContent = '';
        document.getElementById('chat-avatar').textContent = '';
    }
}

// ── Message bubble right-click menu ─────────────────────────────────────
function showMsgMenuModal(event, menuId) {
    event.preventDefault();
    document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    const menu = document.getElementById(menuId);
    if (!menu) return;
    menu.classList.remove('hidden');
    menu.style.left = Math.min(event.clientX, window.innerWidth - 175) + 'px';
    menu.style.top  = Math.min(event.clientY + 4, window.innerHeight - 110) + 'px';
}

async function unsendMsgModal(id) {
    document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    if (!confirm('Unsend this message for everyone?')) return;
    const fd = new FormData();
    fd.append('id', id);
    fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/Unsend', { method: 'POST', body: fd });
    if (res.ok) await loadChatMessages();
}

async function deleteForMeModal(id) {
    document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    const fd = new FormData();
    fd.append('id', id);
    fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/DeleteForMe', { method: 'POST', body: fd });
    if (res.ok) document.getElementById('chatmsg-' + id)?.remove();
}

// ── Message Chat Modal (two-panel) ───────────────────────────────────────
let _chatUserId = '', _chatMyId = '';

async function openMsgChat(userId, name, userType) {
    // Close the mini dropdown panel
    document.getElementById('msgPanel').classList.add('hidden');
    msgPanelOpen = false;

    // Open mini chat popup instead of the big modal
    _chatUserId = userId;
    _miniChatUserId = userId;
    document.getElementById('miniChatAvatar').textContent = name.charAt(0).toUpperCase();
    document.getElementById('miniChatName').textContent = name;
    document.getElementById('miniChatType').textContent = userType || '';
    document.getElementById('miniChatPopup').style.display = 'flex';
    document.getElementById('miniChatBackdrop').style.display = 'block';
    document.getElementById('miniChatInput').focus();
    await loadMiniChatMessages();
}

// ── Mini Chat Popup ───────────────────────────────────────────────────────
let _miniChatUserId = '', _miniChatMyId = '';

const _miniIcoUnsend = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>`;
const _miniIcoTrash  = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>`;

async function loadMiniChatMessages() {
    const box = document.getElementById('miniChatMessages');
    box.innerHTML = '<p class="text-center text-xs text-gray-400 py-4">Loading…</p>';
    if (!_miniChatUserId) return;
    try {
        const data = await fetch('/Message/GetConversation?otherUserId=' + encodeURIComponent(_miniChatUserId)).then(r => r.json());
        const msgs = data.messages || [];
        _miniChatMyId = data.myId;
        if (!msgs.length) { box.innerHTML = '<p class="text-center text-xs text-gray-400 py-4">No messages yet</p>'; return; }
        box.innerHTML = msgs.map(m => {
            const isMe = m.senderId === _miniChatMyId;
            if (m.isUnsent) return `<div class="flex ${isMe?'justify-end':'justify-start'}" id="mini-msg-${m.id}">
                <span class="text-xs italic text-gray-400 px-3 py-1.5 border border-dashed border-gray-300 rounded-2xl">Message unsent</span>
            </div>`;
            const menuItems = isMe
                ? `<button onclick="unsendMiniMsg(${m.id})" class="mini-menu-btn" style="color:#dc2626;" onmouseover="this.style.background='#fef2f2'" onmouseout="this.style.background='none'">${_miniIcoUnsend} Unsend for everyone</button>
                   <div style="height:1px;background:#f3f4f6;"></div>
                   <button onclick="deleteForMeMini(${m.id})" class="mini-menu-btn" style="color:#6b7280;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='none'">${_miniIcoTrash} Delete for me</button>`
                : `<button onclick="deleteForMeMini(${m.id})" class="mini-menu-btn" style="color:#6b7280;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='none'">${_miniIcoTrash} Delete for me</button>`;
            // Three-dot button — hidden by default, shown on row hover via JS
            const threeDotBtn = `
                <button onclick="showMiniMsgMenu(event,'minimenu-${m.id}')"
                        id="minidots-${m.id}"
                        style="display:none;flex-shrink:0;width:22px;height:22px;align-items:center;justify-content:center;border-radius:50%;border:none;background:none;cursor:pointer;color:#9ca3af;"
                        onmouseover="this.style.background='#f3f4f6';this.style.color='#6b7280'"
                        onmouseout="this.style.background='none';this.style.color='#9ca3af'"
                        title="Message options">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="5"  r="1.5"/>
                        <circle cx="12" cy="12" r="1.5"/>
                        <circle cx="12" cy="19" r="1.5"/>
                    </svg>
                </button>`;

            return `<div class="flex items-center gap-1 ${isMe?'justify-end':'justify-start'}" id="mini-msg-${m.id}"
                onmouseenter="var b=document.getElementById('minidots-${m.id}');if(b){b.style.display='flex';}"
                onmouseleave="var b=document.getElementById('minidots-${m.id}');if(b){b.style.display='none';}">
                ${isMe ? threeDotBtn : ''}
                <div class="relative max-w-[80%]">
                    <div class="mini-chat-bubble px-3 py-1.5 rounded-xl text-xs select-none ${isMe?'text-white':'bg-white border border-gray-200 text-gray-800'}"
                         style="${isMe?'background-color:#000147;':''}"
                         oncontextmenu="showMiniMsgMenu(event,'minimenu-${m.id}')"
                         ondblclick="showMiniMsgMenu(event,'minimenu-${m.id}')">
                        ${escHtml(m.content)}
                    </div>
                    <div id="minimenu-${m.id}" class="mini-msg-menu" style="display:none;position:fixed;z-index:10002;background:white;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);min-width:175px;overflow:hidden;">
                        ${menuItems}
                    </div>
                </div>
                ${!isMe ? threeDotBtn : ''}
            </div>`;
        }).join('');
        box.scrollTop = box.scrollHeight;
    } catch { box.innerHTML = '<p class="text-center text-xs text-gray-400 py-4">Failed to load</p>'; }
}

function showMiniMsgMenu(event, menuId) {
    event.preventDefault();
    document.querySelectorAll('.mini-msg-menu').forEach(m => m.style.display = 'none');
    const menu = document.getElementById(menuId); if (!menu) return;
    menu.style.display = 'block';
    menu.style.left = Math.min(event.clientX, window.innerWidth - 185) + 'px';
    menu.style.top  = Math.min(event.clientY + 4, window.innerHeight - 110) + 'px';
}

async function unsendMiniMsg(id) {
    document.querySelectorAll('.mini-msg-menu').forEach(m => m.style.display = 'none');
    if (!confirm('Unsend this message for everyone?')) return;
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/Unsend', { method: 'POST', body: fd });
    if (res.ok) {
        const el = document.getElementById('mini-msg-' + id);
        if (el) el.innerHTML = '<span class="text-xs italic text-gray-400 px-3 py-1.5 border border-dashed border-gray-300 rounded-2xl">Message unsent</span>';
    }
}

async function deleteForMeMini(id) {
    document.querySelectorAll('.mini-msg-menu').forEach(m => m.style.display = 'none');
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/DeleteForMe', { method: 'POST', body: fd });
    if (res.ok) document.getElementById('mini-msg-' + id)?.remove();
}

async function sendMiniChat() {
    const input = document.getElementById('miniChatInput');
    const text = input.value.trim();
    if (!text || !_miniChatUserId) return;
    input.value = '';
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    try {
        const fd = new FormData();
        fd.append('receiverId', _miniChatUserId);
        fd.append('content', text);
        if (token) fd.append('__RequestVerificationToken', token);
        const res = await fetch('/Message/Send', { method: 'POST', body: fd });
        if (res.ok) await loadMiniChatMessages();
    } catch {}
}

function closeMiniChat() {
    document.getElementById('miniChatPopup').style.display = 'none';
    document.getElementById('miniChatBackdrop').style.display = 'none';
    _miniChatUserId = '';
}

// ─────────────────────────────────────────────────────────────────────────────
function closeMsgChat() {
    document.getElementById('msgChatModal').style.display = 'none';
    _chatUserId = ''; _msgConvos = [];
    document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    const gcm = document.getElementById('globalConvoMenuModal');
    if (gcm) gcm.style.display = 'none';
    pollMsgBadge();
}

async function loadChatMessages() {
    if (!_chatUserId) return;
    try {
        const data = await fetch('/Message/GetConversation?otherUserId=' + encodeURIComponent(_chatUserId)).then(r => r.json());
        _chatMyId = data.myId;
        const box = document.getElementById('chat-messages');
        if (!data.messages.length) {
            box.innerHTML = '<p class="text-center text-sm text-gray-400 py-8">No messages yet. Say hi!</p>';
            return;
        }
        box.innerHTML = data.messages.map(m => {
            const isMe   = m.senderId === _chatMyId;
            const unsent = m.isUnsent;
            if (unsent) return `<div class="flex ${isMe?'justify-end':'justify-start'}" id="chatmsg-${m.id}">
                <span class="text-xs italic text-gray-400 px-3 py-1 border border-gray-200 rounded-2xl">Message unsent</span></div>`;

            const _icoUnsend  = `<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>`;
            const _icoTrash   = `<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>`;
            const _menuHdr    = `<div style="padding:7px 14px 5px;font-size:10px;font-weight:700;letter-spacing:.08em;color:#9ca3af;text-transform:uppercase;border-bottom:1px solid #f3f4f6;">Message</div>`;
            const _menuDiv    = `<div style="height:1px;background:#f3f4f6;margin:2px 0;"></div>`;
            const menuItems = isMe
                ? `${_menuHdr}
                   <button onclick="unsendMsgModal(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-red-50 flex items-center gap-3" style="font-size:13px;color:#dc2626;">
                       ${_icoUnsend} Unsend for everyone
                   </button>
                   ${_menuDiv}
                   <button onclick="deleteForMeModal(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-gray-50 flex items-center gap-3" style="font-size:13px;color:#6b7280;">
                       ${_icoTrash} Delete for me
                   </button>`
                : `${_menuHdr}
                   <button onclick="deleteForMeModal(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-gray-50 flex items-center gap-3" style="font-size:13px;color:#6b7280;">
                       ${_icoTrash} Delete for me
                   </button>`;

            const chatDotBtn = `
                <button onclick="showMsgMenuModal(event,'cmmenu-${m.id}')"
                        id="chatdots-${m.id}"
                        style="display:none;flex-shrink:0;width:24px;height:24px;align-items:center;justify-content:center;border-radius:50%;border:none;background:none;cursor:pointer;color:#9ca3af;align-self:center;"
                        onmouseover="this.style.background='#f3f4f6';this.style.color='#6b7280'"
                        onmouseout="this.style.background='none';this.style.color='#9ca3af'"
                        title="Message options">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="5"  r="1.5"/>
                        <circle cx="12" cy="12" r="1.5"/>
                        <circle cx="12" cy="19" r="1.5"/>
                    </svg>
                </button>`;
            return `<div class="flex items-end gap-1 ${isMe?'justify-end':'justify-start'}" id="chatmsg-${m.id}"
                onmouseenter="var b=document.getElementById('chatdots-${m.id}');if(b){b.style.display='flex';}"
                onmouseleave="var b=document.getElementById('chatdots-${m.id}');if(b){b.style.display='none';}">
                ${isMe ? chatDotBtn : ''}
                <div class="max-w-[72%] relative">
                    <div class="chat-msg-bubble px-4 py-2 rounded-2xl text-sm select-none ${isMe?'text-white rounded-br-sm':'bg-white border border-gray-200 text-gray-800 rounded-bl-sm'}"
                         style="${isMe?'background-color:#000147;':''}"
                         oncontextmenu="showMsgMenuModal(event,'cmmenu-${m.id}')"
                         ondblclick="showMsgMenuModal(event,'cmmenu-${m.id}')">
                        ${escHtml(m.content)}
                    </div>
                    <p class="text-[10px] mt-0.5 text-gray-400 ${isMe?'text-right':''}">${m.sentAt}</p>
                    <div id="cmmenu-${m.id}" class="chat-msg-menu hidden" style="position:fixed;z-index:10001;background:white;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);min-width:175px;overflow:hidden;">
                        ${menuItems}
                    </div>
                </div>
                ${!isMe ? chatDotBtn : ''}
            </div>`;
        }).join('');
        box.scrollTop = box.scrollHeight;
        // Refresh sidebar
        try {
            _msgConvos = await fetch('/Message/GetConversationList').then(r => r.json());
            document.getElementById('chat-sidebar').innerHTML = _msgConvos.map(c => msgConvoRow(c, c.userId === _chatUserId)).join('');
        } catch {}
        updateMsgBadge(0);
    } catch {
        document.getElementById('chat-messages').innerHTML = '<p class="text-center text-sm text-red-400 py-8">Could not load messages</p>';
    }
}

async function sendChatMsg() {
    const input = document.getElementById('chat-input');
    const text  = input.value.trim();
    if (!text || !_chatUserId) return;
    input.value = '';
    try {
        const fd = new FormData();
        fd.append('receiverId', _chatUserId);
        fd.append('content', text);
        fd.append('__RequestVerificationToken', _tok());
        await fetch('/Message/Send', { method: 'POST', body: fd });
        await loadChatMessages();
    } catch { input.value = text; }
}

function openReservationDetail(id, user, userType, book, createdAt) {
    document.getElementById('rdUser').textContent     = user;
    document.getElementById('rdUserInitial').textContent = user.charAt(0).toUpperCase();
    document.getElementById('rdUserType').textContent = userType;
    document.getElementById('rdBook').textContent     = book;
    document.getElementById('rdDate').textContent     = createdAt;
    document.getElementById('rdViewBtn').href        = '/Borrow/Index';
    document.getElementById('reservationDetailModal').classList.remove('hidden');
    // close notification panel
    document.getElementById('notifPanel').classList.add('hidden');
}
function closeReservationDetail() {
    document.getElementById('reservationDetailModal').classList.add('hidden');
}
</script>
@await RenderSectionAsync("Scripts", required: false)

<!-- Reservation Detail Modal -->
