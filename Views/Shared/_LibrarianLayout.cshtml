</div>

<!-- Message Toast Popup -->
<div id="msgToast"
     class="fixed bottom-5 right-5 z-[9999] w-80 bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden transition-all duration-300 ease-in-out translate-x-full opacity-0">
