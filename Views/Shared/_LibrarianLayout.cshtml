@using Microsoft.AspNetCore.Identity
@using BookHiveLibrary.Models
@inject UserManager<ApplicationUser> _layoutUserManager
@{
    var currentUser = await _layoutUserManager.GetUserAsync(User);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var libFirstName = !string.IsNullOrWhiteSpace(currentUser?.FirstName)
        ? currentUser.FirstName
        : User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookHive Library</title>
    <link rel="stylesheet" href="~/css/output.css" />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
</head>
<body class="bg-[#dce6f5] flex h-screen overflow-hidden">

<!-- Mobile backdrop -->
<div id="lib-backdrop" class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden" onclick="toggleLibSidebar()"></div>

<!-- Sidebar -->
<aside id="lib-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 text-white flex flex-col shadow-xl transition-transform duration-300 -translate-x-full lg:translate-x-0 lg:relative lg:flex-shrink-0" style="background-color:#000147;">

    <!-- Logo -->
    <div class="flex items-center px-6 py-5 border-b border-white/10 flex-shrink-0">
        <a href="@Url.Action("Dashboard","Librarian")" class="flex items-center justify-center w-full">
            <span style="font-family:'Dancing Script',cursive;font-size:2rem;font-weight:800;color:white;line-height:1;display:block;text-align:center;">BookHive</span>
        </a>
    </div>

    <!-- Nav -->
    <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">

        <!-- Home / Dashboard -->
        <a href="@Url.Action("Dashboard","Librarian")"
           class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(currentAction == "Dashboard" && currentController == "Librarian" ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6"/></svg>
            <span>Home</span>
        </a>

        <!-- User Management -->
        @{
            var isUserMgmt = new[] { "UserManagement", "Registration", "Sectioning", "StudentActivity" }.Contains(currentAction);
        }
        <div>
            <button onclick="toggleLibMenu('libUserMgmtMenu', this)"
                    class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(isUserMgmt ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span class="flex-1 text-left">User Management</span>
                <svg class="w-4 h-4 transition-transform @(isUserMgmt ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="libUserMgmtMenu" class="mt-1 ml-8 space-y-1 @(isUserMgmt ? "" : "hidden")">
                <a href="@Url.Action("UserManagement","Librarian")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "UserManagement" ? "text-white font-medium" : "")">Users</a>
                <a href="@Url.Action("Registration","Librarian")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Registration" && currentController == "Librarian" ? "text-white font-medium" : "")">Registration</a>
                <a href="@Url.Action("Sectioning","Librarian")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Sectioning" ? "text-white font-medium" : "")">Sectioning</a>
                <a href="@Url.Action("StudentActivity","Librarian")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "StudentActivity" ? "text-white font-medium" : "")">Activity</a>
            </div>
        </div>

        <!-- Transaction Activity -->
        @{ var isTransaction = new[] { "Borrow", "Computer" }.Contains(currentController); }
        <div>
            <button onclick="toggleLibMenu('libTransMenu', this)"
                    class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(isTransaction ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                <span class="flex-1 text-left">Transaction Activity</span>
                <svg class="w-4 h-4 transition-transform @(isTransaction ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="libTransMenu" class="mt-1 ml-8 space-y-1 @(isTransaction ? "" : "hidden")">
                <a href="@Url.Action("Index","Borrow")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentController == "Borrow" ? "text-white font-medium" : "")">Book</a>
                <a href="@Url.Action("Transaction","Computer")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Transaction" ? "text-white font-medium" : "")">Computer</a>
            </div>
        </div>

        <!-- Book Management -->
        @{ var isBook = currentController == "Book"; }
        <div>
            <button onclick="toggleLibMenu('libBookMenu', this)"
                    class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(isBook ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                <span class="flex-1 text-left">Book Management</span>
                <svg class="w-4 h-4 transition-transform @(isBook ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="libBookMenu" class="mt-1 ml-8 space-y-1 @(isBook ? "" : "hidden")">
                <a href="@Url.Action("Register","Book")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Register" && isBook ? "text-white font-medium" : "")">Book Registration</a>
                <a href="@Url.Action("Index","Book")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Index" && isBook ? "text-white font-medium" : "")">Book Catalog</a>
                <a href="@Url.Action("Archive","Book")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Archive" && isBook ? "text-white font-medium" : "")">Archive Records</a>
            </div>
        </div>

        <!-- Computer Management -->
        @{ var isComputer = currentController == "Computer"; }
        <div>
            <button onclick="toggleLibMenu('libComputerMenu', this)"
                    class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm transition @(isComputer ? "bg-white/20 ring-1 ring-white/10 font-semibold" : "hover:bg-white/10")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span class="flex-1 text-left">Computer Management</span>
                <svg class="w-4 h-4 transition-transform @(isComputer ? "rotate-180" : "")" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="libComputerMenu" class="mt-1 ml-8 space-y-1 @(isComputer ? "" : "hidden")">
                <a href="@Url.Action("Register","Computer")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Register" && isComputer ? "text-white font-medium" : "")">Computer Registration</a>
                <a href="@Url.Action("Index","Computer")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "Index" && isComputer ? "text-white font-medium" : "")">Computer List</a>
                <a href="@Url.Action("ArchiveList","Computer")" class="block px-3 py-2 rounded-lg text-sm text-blue-200 hover:bg-white/10 hover:text-white transition @(currentAction == "ArchiveList" ? "text-white font-medium" : "")">Archive Records</a>
            </div>
        </div>

    </nav>
</aside>

<!-- Main Area -->
<div class="flex flex-col flex-1 overflow-hidden">

    <!-- Top Header -->
    <header class="bg-white border-b border-gray-200 flex items-center justify-between px-6 py-3 shadow-sm flex-shrink-0">
        <div class="flex items-center gap-3">
            <!-- Mobile hamburger -->
            <button onclick="toggleLibSidebar()" class="lg:hidden text-gray-500 hover:text-gray-700 transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <div class="mt-1">
                <h2 class="text-base font-semibold text-gray-800">@ViewData["Title"]</h2>
                <p class="text-xs text-gray-400 hidden sm:block">Librarian Portal — STI San Jose Del Monte</p>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <!-- Messages -->
            <a href="@Url.Action("Index","Message")" class="relative flex items-center text-gray-500 hover:text-gray-700">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span id="msgBadge" class="hidden absolute -top-1 -right-1 w-4 h-4 text-white text-[10px] font-bold rounded-full flex items-center justify-center" style="background:#e53e3e;"></span>
            </a>

            <!-- Notification Bell -->
            <div class="relative flex items-center" id="notifWrapper">
                <button onclick="toggleNotifPanel()" class="relative flex items-center text-gray-500 hover:text-gray-700 focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                    <span id="notifBadge" class="hidden absolute -top-1 -right-1 w-4 h-4 text-white text-[10px] font-bold rounded-full flex items-center justify-center" style="background:#e53e3e;"></span>
                </button>
                <div id="notifPanel" class="hidden absolute right-0 top-8 w-80 bg-white rounded-xl shadow-lg border border-gray-200 z-50 overflow-hidden">
                    <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between" style="background:#000147;">
                        <span class="text-sm font-semibold text-white">Reservations</span>
                        <span id="notifCount" class="text-xs text-blue-200"></span>
                    </div>
                    <div id="notifList" class="divide-y divide-gray-100 max-h-72 overflow-y-auto">
                        <p class="px-4 py-6 text-center text-sm text-gray-400">Loading…</p>
                    </div>
                    <div class="px-4 py-2.5 border-t border-gray-100 text-center">
                        <a href="@Url.Action("Index","Borrow")" class="text-xs font-medium" class="text-gray-900">View all in Book Transactions →</a>
                    </div>
                </div>
            </div>

            <!-- Profile Dropdown -->
            <div class="relative" id="lib-profile-wrapper">
                <button onclick="toggleLibProfile()" class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 focus:outline-none transition">
                    <span class="text-sm font-medium text-gray-700 hidden sm:inline">@libFirstName</span>
                    <div class="w-7 h-7 rounded-full overflow-hidden flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background-color:#000147;">
                        @if (!string.IsNullOrEmpty(currentUser?.ProfilePicture))
                        {
                            <img src="@currentUser.ProfilePicture" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            @(libFirstName.Length > 0 ? libFirstName[0].ToString().ToUpper() : "L")
                        }
                    </div>
                </button>

                <!-- Profile Dropdown Panel -->
                <div id="lib-profile-panel" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-gray-200 z-50 overflow-hidden">
                    <div class="px-4 py-4 border-b border-gray-100 flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full overflow-hidden flex items-center justify-center text-white text-lg font-bold flex-shrink-0" style="background-color:#000147;">
                            @if (!string.IsNullOrEmpty(currentUser?.ProfilePicture))
                            {
                                <img src="@currentUser.ProfilePicture" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                @(libFirstName.Length > 0 ? libFirstName[0].ToString().ToUpper() : "L")
                            }
                        </div>
                        <div class="min-w-0">
                            <a href="/Librarian/Profile" class="text-sm font-semibold text-gray-900 hover:underline truncate block">
                                @($"{currentUser?.FirstName} {currentUser?.LastName}".Trim().Length > 0 ? $"{currentUser?.FirstName} {currentUser?.LastName}".Trim() : User.Identity?.Name)
                            </a>
                            <p class="text-xs text-gray-400 truncate">@currentUser?.Email</p>
                            <span class="text-[10px] bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full font-semibold mt-1 inline-block">Librarian</span>
                        </div>
                    </div>
                    <form method="post" action="/Account/Logout" class="px-2 py-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 hover:bg-red-50 rounded-lg transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                            Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <!-- Page Content -->
    <main class="flex-1 overflow-y-auto p-6">
        @if (TempData["Success"] != null)
        {
            <div class="mb-4 px-4 py-3 bg-green-100 border border-green-300 text-green-800 rounded-lg text-sm flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-4 px-4 py-3 bg-red-100 border border-red-300 text-red-800 rounded-lg text-sm">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
</div>

<script>
function toggleLibSidebar() {
    const sidebar  = document.getElementById('lib-sidebar');
    const backdrop = document.getElementById('lib-backdrop');
    const hidden   = sidebar.classList.contains('-translate-x-full');
    sidebar.classList.toggle('-translate-x-full', !hidden);
    backdrop.classList.toggle('hidden', !hidden);
}

function toggleLibMenu(menuId, btn) {
    const menu  = document.getElementById(menuId);
    const arrow = btn.querySelector('svg:last-child');
    menu.classList.toggle('hidden');
    if (arrow) arrow.classList.toggle('rotate-180');
}

function toggleLibProfile() {
    document.getElementById('lib-profile-panel').classList.toggle('hidden');
}
document.addEventListener('click', function(e) {
    const pw = document.getElementById('lib-profile-wrapper');
    if (pw && !pw.contains(e.target))
        document.getElementById('lib-profile-panel').classList.add('hidden');
});

function toggleNotifPanel() {
    const panel = document.getElementById('notifPanel');
    panel.classList.toggle('hidden');
    if (!panel.classList.contains('hidden')) loadNotifications();
}
document.addEventListener('click', function(e) {
    const wrapper = document.getElementById('notifWrapper');
    if (wrapper && !wrapper.contains(e.target))
        document.getElementById('notifPanel').classList.add('hidden');
});

async function loadNotifications() {
    const list = document.getElementById('notifList');
    try {
        const res  = await fetch('/Librarian/GetNotifications');
        const data = await res.json();
        updateBadge(data.count);
        document.getElementById('notifCount').textContent = data.count > 0 ? data.count + ' pending' : 'No pending';
        if (!data.items.length) {
            list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">No pending reservations</p>';
            return;
        }
        list.innerHTML = data.items.map(n => `
            <div class="px-4 py-3 hover:bg-gray-50 cursor-pointer" onclick="openReservationDetail(${n.id}, '${n.user.replace(/'/g,"\\'")}', '${n.userType}', '${n.book.replace(/'/g,"\\'")}', '${n.createdAt}')">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0 mt-0.5" style="background:#000147;">
                        ${n.user.charAt(0).toUpperCase()}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-800 truncate">${n.user} <span class="text-xs font-normal text-gray-400 ml-1">${n.userType}</span></p>
                        <p class="text-xs text-gray-500 truncate">Reserved: <span class="font-medium text-gray-700">${n.book}</span></p>
                        <p class="text-xs text-gray-400 mt-0.5">${n.createdAt}</p>
                    </div>
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700 flex-shrink-0">Pending</span>
                </div>
            </div>`).join('');
    } catch {
        list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">Could not load notifications</p>';
    }
}

function updateBadge(count) {
    const badge = document.getElementById('notifBadge');
    if (count > 0) { badge.textContent = count > 9 ? '9+' : count; badge.classList.remove('hidden'); }
    else { badge.classList.add('hidden'); }
}

// Initial badge load
async function pollBadge() {
    try { const res = await fetch('/Librarian/GetNotifications'); const data = await res.json(); updateBadge(data.count); } catch {}
}
pollBadge();

async function pollMsgBadge() {
    try {
        const res  = await fetch('/Message/UnreadCount');
        const data = await res.json();
        updateMsgBadge(data.count);
    } catch {}
}
pollMsgBadge();

function updateMsgBadge(count) {
    const badge = document.getElementById('msgBadge');
    if (!badge) return;
    if (count > 0) { badge.textContent = count > 9 ? '9+' : count; badge.classList.remove('hidden'); }
    else { badge.classList.add('hidden'); }
}

// ── SignalR real-time ─────────────────────────────────────────────────────
const libraryConnection = new signalR.HubConnectionBuilder()
    .withUrl('/hubs/library')
    .withAutomaticReconnect()
    .build();

libraryConnection.on('NewReservation', function(n) {
    // Increment notification badge
    const badge = document.getElementById('notifBadge');
    const current = parseInt(badge.textContent) || 0;
    const next = current + 1;
    badge.textContent = next > 9 ? '9+' : next;
    badge.classList.remove('hidden');

    // Prepend to notification list if open
    const list = document.getElementById('notifList');
    const countEl = document.getElementById('notifCount');
    if (countEl) countEl.textContent = (next) + ' pending';
    const item = document.createElement('div');
    item.className = 'px-4 py-3 hover:bg-gray-50 cursor-pointer border-b border-gray-50 bg-yellow-50';
    item.innerHTML = `
        <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0 mt-0.5" style="background:#000147;">
                ${n.user.charAt(0).toUpperCase()}
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-800 truncate">${n.user} <span class="text-xs font-normal text-gray-400 ml-1">${n.userType}</span></p>
                <p class="text-xs text-gray-500 truncate">Reserved: <span class="font-medium text-gray-700">${n.book}</span></p>
                <p class="text-xs text-gray-400 mt-0.5">${n.createdAt}</p>
            </div>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700 flex-shrink-0">Pending</span>
        </div>`;
    if (list.firstChild) list.insertBefore(item, list.firstChild);
    else list.appendChild(item);
});

libraryConnection.on('ReceiveMessage', function(msg) {
    const badge = document.getElementById('msgBadge');
    if (!badge) return;
    const current = parseInt(badge.textContent) || 0;
    const next = current + 1;
    badge.textContent = next > 9 ? '9+' : next;
    badge.classList.remove('hidden');
});

libraryConnection.start().catch(err => console.error('SignalR error:', err));

function openReservationDetail(id, user, userType, book, createdAt) {
    document.getElementById('rdUser').textContent     = user;
    document.getElementById('rdUserInitial').textContent = user.charAt(0).toUpperCase();
    document.getElementById('rdUserType').textContent = userType;
    document.getElementById('rdBook').textContent     = book;
    document.getElementById('rdDate').textContent     = createdAt;
    document.getElementById('rdViewBtn').href        = '/Borrow/Index';
    document.getElementById('reservationDetailModal').classList.remove('hidden');
    // close notification panel
    document.getElementById('notifPanel').classList.add('hidden');
}
function closeReservationDetail() {
    document.getElementById('reservationDetailModal').classList.add('hidden');
}
</script>
@await RenderSectionAsync("Scripts", required: false)

<!-- Reservation Detail Modal -->
<div id="reservationDetailModal" class="fixed inset-0 bg-black/50 z-[999] hidden flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4 overflow-hidden">
        <div class="px-6 py-4 flex items-center justify-between" style="background-color:#000147;">
            <h3 class="text-sm font-semibold text-white">Reservation Details</h3>
            <button onclick="closeReservationDetail()" class="text-white/70 hover:text-white">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <div class="px-6 py-5 space-y-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center text-white text-lg font-bold flex-shrink-0" style="background-color:#000147;">
                    <span id="rdUserInitial">?</span>
                </div>
                <div>
                    <p id="rdUser" class="text-sm font-semibold text-gray-800"></p>
                    <span id="rdUserType" class="text-[10px] bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-semibold"></span>
                </div>
            </div>
            <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-500">Book Reserved</span>
                    <span id="rdBook" class="font-medium text-gray-800 text-right max-w-[60%]"></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Reserved At</span>
                    <span id="rdDate" class="text-gray-700"></span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Status</span>
                    <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-700">Pending</span>
                </div>
            </div>
        </div>
        <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
            <button onclick="closeReservationDetail()" class="px-4 py-2 border border-gray-300 text-gray-600 rounded-xl text-sm hover:bg-gray-50">Close</button>
            <a id="rdViewBtn" href="/Borrow/Index" class="px-4 py-2 text-white rounded-xl text-sm font-medium" style="background-color:#000147;">View in Transactions</a>
        </div>
    </div>
</div>
</body>
</html>
