    <div id="msgPanelList" class="divide-y divide-gray-100 overflow-y-auto" style="max-height:260px;">
        <p class="px-4 py-6 text-center text-sm text-gray-400">Loading…</p>
    </div>
</div>

<!-- Mini Chat Backdrop -->
<div id="miniChatBackdrop" onclick="closeMiniChat()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:9998;"></div>

<!-- Small Compact Chat Popup -->
<div id="miniChatPopup" class="fixed z-[9999] bg-white rounded-2xl shadow-2xl border border-gray-200 flex flex-col overflow-hidden" style="display:none;width:480px;height:580px;top:50%;left:50%;transform:translate(-50%,-50%);">
    <div class="px-4 py-3 flex items-center justify-between flex-shrink-0" style="background-color:#000147;">
        <div class="flex items-center gap-2 min-w-0">
            <div id="miniChatAvatar" class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0 bg-white/20"></div>
            <div class="min-w-0">
                <p id="miniChatName" class="text-sm font-semibold text-white truncate"></p>
                <p id="miniChatType" class="text-[10px] text-white/60"></p>
            </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
            <button onclick="closeMiniChat()" class="text-white/60 hover:text-white transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
    </div>
    <div id="miniChatMessages" class="flex-1 overflow-y-auto px-3 py-3 space-y-2 bg-gray-50">
        <p class="text-center text-xs text-gray-400 py-4">Loading…</p>
    </div>
    <div class="px-3 py-2 border-t border-gray-100 flex gap-2 flex-shrink-0 bg-white">
        @Html.AntiForgeryToken()
        <input id="miniChatInput" type="text" placeholder="Type a message…"
               class="flex-1 border border-gray-300 rounded-xl px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"
               onkeydown="if(event.key==='Enter'){event.preventDefault();sendMiniChat();}" />
        <button onclick="sendMiniChat()" class="px-3 py-1.5 text-xs text-white rounded-xl font-medium transition hover:opacity-90 flex-shrink-0" style="background-color:#000147;">Send</button>
    </div>
</div>

<!-- Message Chat Modal (two-panel: sidebar + conversation) -->
<div id="msgChatModal" class="fixed inset-0 z-[9998] items-center justify-center bg-black/40 px-4" style="display:none;" onclick="if(event.target===this)closeMsgChat()">
    <div class="bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden w-full" style="max-width:780px;height:580px;">

        <!-- Full-width header row -->
        <div class="flex items-center justify-between px-5 py-3.5 flex-shrink-0" style="background-color:#000147;">
            <p class="text-sm font-semibold text-white tracking-wide">Messages</p>
            <button onclick="closeMsgChat()" class="text-white/70 hover:text-white transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Two-column body -->
        <div class="flex flex-1 min-h-0 overflow-hidden">

        <!-- Left: conversation list -->
