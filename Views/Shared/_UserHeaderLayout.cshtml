@inject Microsoft.AspNetCore.Identity.UserManager<BookHiveLibrary.Models.ApplicationUser> _stuLayoutUserManager
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var stuCurrentUser = await _stuLayoutUserManager.GetUserAsync(User);
    var stuName = $"{stuCurrentUser?.FirstName} {stuCurrentUser?.LastName}".Trim();
    if (string.IsNullOrEmpty(stuName)) stuName = User.Identity?.Name ?? "";
    var stuInitial = stuName.Length > 0 ? stuName[0].ToString().ToUpper() : "S";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookHive</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <style>.mini-menu-btn{display:flex;align-items:center;gap:6px;width:100%;text-align:left;padding:8px 14px;font-size:12px;background:none;border:none;cursor:pointer;white-space:nowrap;}</style>
</head>
<body class="bg-[#dce6f5]">

<!-- Sidebar backdrop -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-black/40 z-40 hidden" onclick="toggleSidebar()"></div>

<div class="flex h-screen bg-[#dce6f5]">

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-56 bg-[#000147] text-white flex flex-col py-8 px-5 flex-shrink-0 shadow-xl -translate-x-full transition-transform duration-300">
        <div class="mb-10 flex items-center gap-3">
            <button onclick="toggleSidebar()" class="text-white/60 hover:text-white transition flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <a href="/Student/Dashboard" style="font-family:'Dancing Script',cursive;font-size:2rem;font-weight:800;color:white;line-height:1;text-decoration:none;">BookHive</a>
        </div>
        <nav class="space-y-1 flex-1">
            <a href="/Student/Dashboard"
               class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm @(currentController == "Student" && currentAction == "Dashboard" ? "font-semibold bg-white/20 text-white ring-1 ring-white/10" : "font-medium text-blue-200 hover:bg-white/10 hover:text-white transition-all duration-200")">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
                Home
            </a>
            <a href="/Student/BookViewing"
               class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm @(currentController == "Student" && currentAction == "BookViewing" ? "font-semibold bg-white/20 text-white ring-1 ring-white/10" : "font-medium text-blue-200 hover:bg-white/10 hover:text-white transition-all duration-200")">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>
                Book Viewing
            </a>
            <a href="/Student/ComputerVacancy"
               class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm @(currentController == "Student" && currentAction == "ComputerVacancy" ? "font-semibold bg-white/20 text-white ring-1 ring-white/10" : "font-medium text-blue-200 hover:bg-white/10 hover:text-white transition-all duration-200")">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd"/></svg>
                Computer Vacancy
            </a>
        </nav>
    </aside>

    <!-- Main -->
    <main class="flex-1 overflow-y-auto bg-[#dce6f5] flex flex-col">

        <!-- Header -->
        <header class="flex items-center justify-between px-6 py-3 shadow-sm flex-shrink-0 border-b border-white/10" style="background-color:#000147;">
            <div class="flex items-center gap-3">
                <button onclick="toggleSidebar()" class="text-white/70 hover:text-white transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <a href="/Student/Dashboard" style="font-family:'Dancing Script',cursive;font-size:1.6rem;font-weight:800;color:white;line-height:1;text-decoration:none;">BookHive</a>
            </div>

            <div class="flex items-center gap-4 flex-shrink-0">
                <!-- Messages -->
                <div class="relative flex items-center" id="msgWrapper">
                    <button type="button" id="msgBtn" onclick="event.preventDefault();toggleMsgPanel()" class="relative flex items-center text-white/70 hover:text-white focus:outline-none">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        <span id="msgBadge" class="hidden absolute -top-1 -right-1 w-4 h-4 text-white text-[10px] font-bold rounded-full flex items-center justify-center" style="background:#e53e3e;"></span>
                    </button>
                </div>
                <!-- Bell / Notifications -->
                <div class="relative flex items-center" id="stuNotifWrapper">
                    <button onclick="toggleStuNotifPanel()" class="relative flex items-center text-white/70 hover:text-white focus:outline-none">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                        <span id="stuNotifBadge" class="hidden absolute -top-1 -right-1 w-4 h-4 text-white text-[10px] font-bold rounded-full flex items-center justify-center" style="background:#e53e3e;"></span>
                    </button>
                    <!-- Notification dropdown -->
                    <div id="stuNotifPanel" class="hidden fixed top-14 right-32 w-80 bg-white rounded-xl shadow-xl border border-gray-200 z-[999] overflow-hidden">
                        <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
                            <span class="text-sm font-semibold text-gray-800">Notifications</span>
                            <span id="stuNotifCount" class="text-xs text-gray-400"></span>
                        </div>
                        <div id="stuNotifList" class="max-h-72 overflow-y-auto divide-y divide-gray-50">
                            <p class="px-4 py-6 text-center text-sm text-gray-400">Loading…</p>
                        </div>
                    </div>
                </div>
                <!-- Profile Dropdown -->
                <div class="relative" id="stu-profile-wrapper">
                    <button onclick="toggleStuProfile()" class="flex items-center gap-2 px-3 py-1.5 rounded-lg focus:outline-none transition" style="border:1px solid rgba(255,255,255,0.6);background:rgba(255,255,255,0.1);">
                        <span class="text-sm font-medium text-white hidden sm:inline">@(stuCurrentUser?.FirstName ?? User.Identity?.Name)</span>
                        <div class="w-7 h-7 rounded-full overflow-hidden flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background-color:#000147;">
                            @if (!string.IsNullOrEmpty(stuCurrentUser?.ProfilePicture))
                            {
                                <img src="@stuCurrentUser.ProfilePicture" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                @stuInitial
                            }
                        </div>
                    </button>
                    <div id="stu-profile-panel" class="hidden fixed top-14 right-4 w-64 bg-white rounded-xl shadow-lg border border-gray-200 z-[999] overflow-hidden">
                        <div class="px-4 py-4 border-b border-gray-100 flex items-center gap-3">
                            <div class="w-12 h-12 rounded-full overflow-hidden flex items-center justify-center text-white text-lg font-bold flex-shrink-0" style="background-color:#000147;">
                                @if (!string.IsNullOrEmpty(stuCurrentUser?.ProfilePicture))
                                {
                                    <img src="@stuCurrentUser.ProfilePicture" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    @stuInitial
                                }
                            </div>
                            <div class="min-w-0">
                                <a href="/Student/Profile" class="text-sm font-semibold text-gray-900 hover:underline truncate block">@stuName</a>
                                <p class="text-xs text-gray-400 truncate">@stuCurrentUser?.Email</p>
                                <span class="text-[10px] bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-semibold mt-1 inline-block">@(stuCurrentUser?.UserType ?? "Student")</span>
                            </div>
                        </div>
                        <form method="post" action="/Account/Logout" class="px-2 py-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 hover:bg-red-50 rounded-lg transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <!-- Page content -->
        <div class="flex-1 px-4 py-4 sm:px-6 sm:py-6 overflow-y-auto">
            @RenderBody()
        </div>

    </main>
</div>

@RenderSection("Scripts", required: false)

<script>
function toggleSidebar() {
    const s = document.getElementById('sidebar');
    const b = document.getElementById('sidebar-backdrop');
    const isHidden = s.classList.contains('-translate-x-full');
    s.classList.toggle('-translate-x-full', !isHidden);
    b.classList.toggle('hidden', !isHidden);
}
// Close sidebar when any nav link is clicked
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('#sidebar nav a').forEach(function(link) {
        link.addEventListener('click', function() {
            document.getElementById('sidebar').classList.add('-translate-x-full');
            document.getElementById('sidebar-backdrop').classList.add('hidden');
        });
    });
});
function toggleStuProfile() {
    document.getElementById('stu-profile-panel').classList.toggle('hidden');
}
document.addEventListener('click', function(e) {
    const w = document.getElementById('stu-profile-wrapper');
    if (w && !w.contains(e.target))
        document.getElementById('stu-profile-panel')?.classList.add('hidden');
});

// ── SignalR real-time ────────────────────────────────────────────────────
const stuConnection = new signalR.HubConnectionBuilder()
    .withUrl('/hubs/library')
    .withAutomaticReconnect()
    .build();

stuConnection.on('ReceiveMessage', function(msg) {
    const badge = document.getElementById('msgBadge');
    if (badge) {
        const current = parseInt(badge.textContent) || 0;
        const next = current + 1;
        badge.textContent = next > 9 ? '9+' : next;
        badge.classList.remove('hidden');
    }
    if (_chatUserId && msg.senderId === _chatUserId) loadChatMessages();
    if (_miniChatUserId && msg.senderId === _miniChatUserId) loadMiniChatMessages();
});

// When the other person unsends a message, replace its bubble instantly
stuConnection.on('MessageUnsent', function(data) {
    // Mini chat popup
    const miniEl = document.getElementById('mini-msg-' + data.id);
    if (miniEl) {
        miniEl.innerHTML = '<span class="text-xs italic text-gray-400 px-3 py-1.5 border border-dashed border-gray-300 rounded-2xl">Message unsent</span>';
    }
    // Full chat modal (if open)
    const chatEl = document.getElementById('chatmsg-' + data.id);
    if (chatEl) {
        chatEl.innerHTML = '<span class="text-xs italic text-gray-400 px-3 py-1 border border-gray-200 rounded-2xl">Message unsent</span>';
    }
});

stuConnection.start().then(() => { pollMsgBadge(); pollStuNotifBadge(); }).catch(err => console.error('SignalR error:', err));

// Keep the message badge in sync every 10 seconds (catches server-side read changes)
setInterval(pollMsgBadge, 10000);

// ── Student Notification Bell ────────────────────────────────────────────
async function pollStuNotifBadge() {
    try {
        const data = await fetch('/Student/GetNotifications').then(r => r.json());
        updateStuNotifBadge(data.count);
    } catch {}
}

function updateStuNotifBadge(count) {
    const badge = document.getElementById('stuNotifBadge');
    if (!badge) return;
    if (count > 0) { badge.textContent = count > 9 ? '9+' : count; badge.classList.remove('hidden'); }
    else badge.classList.add('hidden');
}

function toggleStuNotifPanel() {
    const panel = document.getElementById('stuNotifPanel');
    panel.classList.toggle('hidden');
    if (!panel.classList.contains('hidden')) loadStuNotifications();
}

document.addEventListener('click', function(e) {
    const wrapper = document.getElementById('stuNotifWrapper');
    if (wrapper && !wrapper.contains(e.target))
        document.getElementById('stuNotifPanel')?.classList.add('hidden');
});

async function loadStuNotifications() {
    const list = document.getElementById('stuNotifList');
    try {
        const data = await fetch('/Student/GetNotifications').then(r => r.json());
        updateStuNotifBadge(data.count);
        document.getElementById('stuNotifCount').textContent = data.count > 0 ? data.count + ' alert' + (data.count > 1 ? 's' : '') : 'All clear';
        if (!data.items.length) {
            list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">No notifications</p>';
            return;
        }
        const labelColors = {
            'Pending':   'bg-yellow-100 text-yellow-700',
            'Due Soon':  'bg-orange-100 text-orange-700',
            'Overdue':   'bg-red-100 text-red-700',
        };
        list.innerHTML = data.items.map(n => `
            <div class="px-4 py-3 hover:bg-gray-50 cursor-default">
                <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-gray-800 truncate">${n.title}</p>
                        <p class="text-xs text-gray-500 mt-0.5">${n.message}</p>
                        <p class="text-[10px] text-gray-400 mt-1">${n.time}</p>
                    </div>
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full flex-shrink-0 ${labelColors[n.label] || 'bg-gray-100 text-gray-600'}">${n.label}</span>
                </div>
            </div>`).join('');
    } catch {
        list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">Could not load notifications</p>';
    }
}

// ── Message Panel ──────────────────────────────────────────────────────
let msgPanelOpen = false, _chatUserId = '', _chatMyId = '', _msgConvos = [];

async function pollMsgBadge() {
    try { const d = await fetch('/Message/UnreadCount').then(r=>r.json()); updateMsgBadge(d.count); } catch {}
}
function updateMsgBadge(count) {
    const b = document.getElementById('msgBadge'); if (!b) return;
    if (count > 0) { b.textContent = count > 9 ? '9+' : count; b.classList.remove('hidden'); } else b.classList.add('hidden');
}
function escQ(s) { return (s||'').replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }
function escHtml(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
const _tok = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

function msgConvoRow(c, active) {
    return `<div class="msg-convo-row flex items-center gap-3 px-4 py-3 cursor-pointer transition ${active?'bg-blue-50':'hover:bg-gray-50'}"
         id="mconvo-${c.userId}" onclick="openMsgChat('${c.userId}','${escQ(c.name)}','${c.userType}')">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0" style="background-color:#000147;">${c.name.charAt(0).toUpperCase()}</div>
        <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-gray-800 truncate" id="mconvo-name-${c.userId}">${c.name}</p>
                <span class="text-[10px] text-gray-400 ml-2 flex-shrink-0">${c.sentAt}</span>
            </div>
            <p class="text-xs text-gray-500 truncate">${c.lastMsgUnsent?'<em>Message unsent</em>':(c.lastMsg||'…')}</p>
        </div>
        <div class="flex items-center gap-1 flex-shrink-0">
            ${c.unread>0?`<span class="w-5 h-5 rounded-full text-white text-[10px] font-bold flex items-center justify-center" style="background:#e53e3e;">${c.unread}</span>`:''}
            <button onclick="event.stopPropagation();showConvoMenuModal(event,'${c.userId}')"
                    id="mdots-${c.userId}"
                    class="w-6 h-6 flex items-center justify-center rounded hover:bg-gray-200 text-gray-400 hover:text-gray-600 transition flex-shrink-0">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm0 6a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5zm0 6a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5z"/></svg>
            </button>
        </div>
    </div>`;
}

async function toggleMsgPanel() {
    msgPanelOpen = !msgPanelOpen;
    const panel = document.getElementById('msgPanel');
    if (!msgPanelOpen) { panel.style.display = 'none'; return; }
    // Position directly under the envelope button
    const btn = document.getElementById('msgBtn'), rect = btn.getBoundingClientRect();
    panel.style.top   = (rect.bottom + 8) + 'px';
    panel.style.right = Math.max(8, window.innerWidth - rect.right) + 'px';
    panel.style.left  = 'auto';
    panel.style.display = 'block';
    const list = document.getElementById('msgPanelList');
    list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-gray-400">Loading…</p>';
    try {
        _msgConvos = await fetch('/Message/GetConversationList').then(r=>r.json());
        list.innerHTML = _msgConvos.length ? _msgConvos.map(c=>msgConvoRow(c,false)).join('') : '<p class="px-4 py-6 text-center text-sm text-gray-400">No messages yet</p>';
    } catch { list.innerHTML = '<p class="px-4 py-6 text-center text-sm text-red-400">Could not load</p>'; }
}

document.addEventListener('click', function(e) {
    if (!e.target.closest('#msgWrapper') && !e.target.closest('#msgPanel') && !e.target.closest('#miniChatPopup')) { const _p=document.getElementById('msgPanel'); if(_p) _p.style.display='none'; msgPanelOpen = false; }
    if (!e.target.closest('.mini-chat-bubble') && !e.target.closest('.mini-msg-menu') && !e.target.closest('.mini-dots-btn'))
        document.querySelectorAll('.mini-msg-menu').forEach(m => m.style.display = 'none');
    if (!e.target.closest('.chat-msg-bubble') && !e.target.closest('.chat-msg-menu'))
        document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    const gcm = document.getElementById('globalConvoMenuModal');
    if (gcm && !e.target.closest('#globalConvoMenuModal') && !e.target.closest('[id^="mdots-"]')) { gcm.style.display='none'; _activeConvoMenuUser=null; }
});

// ── Conversation 3-dot menu ───────────────────────────────────────────────
let _activeConvoMenuUser = null;

function _ensureConvoMenu() {
    if (document.getElementById('globalConvoMenuModal')) return;
    const m = document.createElement('div');
    m.id = 'globalConvoMenuModal';
    m.style.cssText = 'position:fixed;z-index:10000;background:white;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);min-width:180px;overflow:hidden;font-size:13px;display:none;';
    m.innerHTML = `
        <div style="padding:7px 14px 5px;font-size:10px;font-weight:700;letter-spacing:.08em;color:#9ca3af;text-transform:uppercase;border-bottom:1px solid #f3f4f6;">Conversation</div>
        <button id="gcmm-important" class="w-full text-left px-4 py-2.5 hover:bg-amber-50 flex items-center gap-3" style="color:#b45309;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z"/></svg>
            Mark as Important
        </button>
        <div style="height:1px;background:#f3f4f6;margin:2px 0;"></div>
        <button id="gcmm-delete" class="w-full text-left px-4 py-2.5 hover:bg-red-50 flex items-center gap-3" style="color:#dc2626;">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
            Delete Conversation
        </button>`;
    document.body.appendChild(m);
}

function showConvoMenuModal(event, userId) {
    _ensureConvoMenu();
    const menu = document.getElementById('globalConvoMenuModal');
    if (_activeConvoMenuUser === userId && menu.style.display !== 'none') { menu.style.display='none'; _activeConvoMenuUser=null; return; }
    _activeConvoMenuUser = userId;
    document.getElementById('gcmm-important').onclick = (e) => { e.stopPropagation(); markImportantModal(userId); menu.style.display='none'; _activeConvoMenuUser=null; };
    document.getElementById('gcmm-delete').onclick    = (e) => { e.stopPropagation(); deleteConversationModal(userId); menu.style.display='none'; _activeConvoMenuUser=null; };
    const btn = event.target.closest('button') || event.currentTarget;
    const rect = btn ? btn.getBoundingClientRect() : { right: event.clientX, bottom: event.clientY };
    menu.style.display = 'block';
    menu.style.left = Math.min(rect.right - 180, window.innerWidth - 190) + 'px';
    menu.style.top  = Math.min(rect.bottom + 4, window.innerHeight - 100) + 'px';
}

function markImportantModal(userId) {
    const el = document.getElementById('mconvo-name-'+userId);
    if (el && !el.textContent.startsWith('⭐')) el.textContent = '⭐ ' + el.textContent;
}

async function deleteConversationModal(userId) {
    if (!confirm('Delete this entire conversation? This cannot be undone.')) return;
    const fd = new FormData();
    fd.append('otherUserId', userId); fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/DeleteConversation', { method: 'POST', body: fd });
    if (!res.ok) return;
    _msgConvos = _msgConvos.filter(c => c.userId !== userId);
    document.getElementById('chat-sidebar').innerHTML = _msgConvos.map(c=>msgConvoRow(c,c.userId===_chatUserId)).join('');
    if (_chatUserId === userId) {
        _chatUserId = '';
        document.getElementById('chat-messages').innerHTML = '<p class="text-center text-sm text-gray-400 py-8">Select a conversation to start</p>';
        document.getElementById('chat-name').textContent = 'Select a conversation';
        document.getElementById('chat-type').textContent = '';
        document.getElementById('chat-avatar').textContent = '';
    }
}

// ── Message bubble right-click menu ──────────────────────────────────────
function showMsgMenuModal(event, menuId) {
    event.preventDefault();
    document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    const menu = document.getElementById(menuId); if (!menu) return;
    menu.classList.remove('hidden');
    menu.style.left = Math.min(event.clientX, window.innerWidth - 175) + 'px';
    menu.style.top  = Math.min(event.clientY + 4, window.innerHeight - 110) + 'px';
}

async function unsendMsgModal(id) {
    document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    if (!confirm('Unsend this message for everyone?')) return;
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/Unsend', { method: 'POST', body: fd });
    if (res.ok) await loadChatMessages();
}

async function deleteForMeModal(id) {
    document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/DeleteForMe', { method: 'POST', body: fd });
    if (res.ok) document.getElementById('chatmsg-'+id)?.remove();
}

let _miniChatUserId = '';

async function openMsgChat(userId, name, userType) {
    // Use style.display (not classList) so toggleMsgPanel can reopen it later
    const panel = document.getElementById('msgPanel');
    panel.style.display = 'none'; panel.classList.remove('hidden'); msgPanelOpen = false;
    _miniChatUserId = userId;
    _chatUserId = userId;
    // Immediately clear the unread dot on this convo row and decrement badge
    const convoRow = document.getElementById('mconvo-' + userId);
    if (convoRow) {
        const dot = convoRow.querySelector('.w-5.h-5.rounded-full');
        if (dot) { const n = parseInt(dot.textContent)||0; dot.remove(); const b=document.getElementById('msgBadge'); if(b){ const cur=parseInt(b.textContent)||0; updateMsgBadge(Math.max(0,cur-n)); } }
    }
    // Immediately hide badge if no more unread in other conversations
    pollMsgBadge();
    document.getElementById('miniChatAvatar').textContent = name.charAt(0).toUpperCase();
    document.getElementById('miniChatName').textContent = name;
    document.getElementById('miniChatType').textContent = userType || '';
    document.getElementById('miniChatPopup').style.display = 'flex';
    document.getElementById('miniChatBackdrop').style.display = 'block';
    document.getElementById('miniChatInput').focus();
    await loadMiniChatMessages();
}

let _miniChatMyId = '';
const _miniIcoUnsend = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>`;
const _miniIcoTrash  = `<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>`;

async function loadMiniChatMessages() {
    const box = document.getElementById('miniChatMessages');
    box.innerHTML = '<p class="text-center text-xs text-gray-400 py-4">Loading…</p>';
    if (!_miniChatUserId) return;
    try {
        const data = await fetch('/Message/GetConversation?otherUserId=' + encodeURIComponent(_miniChatUserId)).then(r => r.json());
        const msgs = data.messages || [];
        _miniChatMyId = data.myId;
        if (!msgs.length) { box.innerHTML = '<p class="text-center text-xs text-gray-400 py-4">No messages yet</p>'; return; }
        const escH = s => (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        box.innerHTML = msgs.map(m => {
            const isMe = m.senderId === _miniChatMyId;
            if (m.isUnsent) return `<div class="flex ${isMe?'justify-end':'justify-start'}" id="mini-msg-${m.id}">
                <span class="text-xs italic text-gray-400 px-3 py-1.5 border border-dashed border-gray-300 rounded-2xl">Message unsent</span>
            </div>`;
            const menuItems = isMe
                ? `<button onclick="unsendMiniMsg(${m.id})" class="mini-menu-btn" style="color:#dc2626;" onmouseover="this.style.background='#fef2f2'" onmouseout="this.style.background='none'">${_miniIcoUnsend} Unsend for everyone</button>
                   <div style="height:1px;background:#f3f4f6;"></div>
                   <button onclick="deleteForMeMini(${m.id})" class="mini-menu-btn" style="color:#6b7280;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='none'">${_miniIcoTrash} Delete for me</button>`
                : `<button onclick="deleteForMeMini(${m.id})" class="mini-menu-btn" style="color:#6b7280;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='none'">${_miniIcoTrash} Delete for me</button>`;
            const threeDotBtn = `
                <button onclick="showMiniMsgMenu(event,'minimenu-${m.id}')"
                        id="minidots-${m.id}"
                        style="display:none;flex-shrink:0;width:22px;height:22px;align-items:center;justify-content:center;border-radius:50%;border:none;background:none;cursor:pointer;color:#9ca3af;"
                        onmouseover="this.style.background='#f3f4f6';this.style.color='#6b7280'"
                        onmouseout="this.style.background='none';this.style.color='#9ca3af'"
                        title="Message options">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="5"  r="1.5"/>
                        <circle cx="12" cy="12" r="1.5"/>
                        <circle cx="12" cy="19" r="1.5"/>
                    </svg>
                </button>`;
            return `<div class="flex items-center gap-1 ${isMe?'justify-end':'justify-start'}" id="mini-msg-${m.id}"
                onmouseenter="var b=document.getElementById('minidots-${m.id}');if(b){b.style.display='flex';}"
                onmouseleave="var b=document.getElementById('minidots-${m.id}');if(b){b.style.display='none';}">
                ${isMe ? threeDotBtn : ''}
                <div class="relative max-w-[80%]">
                    <div class="mini-chat-bubble px-3 py-1.5 rounded-xl text-xs select-none ${isMe?'text-white':'bg-white border border-gray-200 text-gray-800'}"
                         style="${isMe?'background-color:#000147;':''}"
                         oncontextmenu="showMiniMsgMenu(event,'minimenu-${m.id}')"
                         ondblclick="showMiniMsgMenu(event,'minimenu-${m.id}')">
                        ${escH(m.content)}
                    </div>
                    <div id="minimenu-${m.id}" class="mini-msg-menu" style="display:none;position:fixed;z-index:10002;background:white;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);min-width:175px;overflow:hidden;">
                        ${menuItems}
                    </div>
                </div>
                ${!isMe ? threeDotBtn : ''}
            </div>`;
        }).join('');
        box.scrollTop = box.scrollHeight;
        // Messages marked read by GetConversation — refresh badge to reflect the new count
        pollMsgBadge();
    } catch { box.innerHTML = '<p class="text-center text-xs text-gray-400 py-4">Failed to load</p>'; }
}

function showMiniMsgMenu(event, menuId) {
    event.preventDefault();
    document.querySelectorAll('.mini-msg-menu').forEach(m => m.style.display = 'none');
    const menu = document.getElementById(menuId); if (!menu) return;
    menu.style.display = 'block';
    menu.style.left = Math.min(event.clientX, window.innerWidth - 185) + 'px';
    menu.style.top  = Math.min(event.clientY + 4, window.innerHeight - 110) + 'px';
}

async function unsendMiniMsg(id) {
    document.querySelectorAll('.mini-msg-menu').forEach(m => m.style.display = 'none');
    if (!confirm('Unsend this message for everyone?')) return;
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', _tok());
    const res = await fetch('/Message/Unsend', { method: 'POST', body: fd });
    if (res.ok) {
        // Update the sender's bubble immediately without a full reload
        const el = document.getElementById('mini-msg-' + id);
        if (el) el.innerHTML = '<span class="text-xs italic text-gray-400 px-3 py-1.5 border border-dashed border-gray-300 rounded-2xl">Message unsent</span>';
    }
}

async function deleteForMeMini(id) {
    document.querySelectorAll('.mini-msg-menu').forEach(m => m.style.display = 'none');
    const tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const fd = new FormData(); fd.append('id', id); if (tok) fd.append('__RequestVerificationToken', tok);
    const res = await fetch('/Message/DeleteForMe', { method: 'POST', body: fd });
    if (res.ok) document.getElementById('mini-msg-' + id)?.remove();
}

async function sendMiniChat() {
    const input = document.getElementById('miniChatInput');
    const text = input.value.trim();
    if (!text || !_miniChatUserId) return;
    input.value = '';
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    try {
        const fd = new FormData();
        fd.append('receiverId', _miniChatUserId);
        fd.append('content', text);
        if (token) fd.append('__RequestVerificationToken', token);
        const res = await fetch('/Message/Send', { method: 'POST', body: fd });
        if (res.ok) await loadMiniChatMessages();
    } catch {}
}

function closeMiniChat() {
    document.getElementById('miniChatPopup').style.display = 'none';
    document.getElementById('miniChatBackdrop').style.display = 'none';
    _miniChatUserId = '';
}

function closeMsgChat() {
    document.getElementById('msgChatModal').style.display = 'none';
    _chatUserId=''; _msgConvos=[];
    document.querySelectorAll('.chat-msg-menu').forEach(m => m.classList.add('hidden'));
    const gcm = document.getElementById('globalConvoMenuModal'); if (gcm) gcm.style.display='none';
    pollMsgBadge();
}

async function loadChatMessages() {
    if (!_chatUserId) return;
    try {
        const data = await fetch('/Message/GetConversation?otherUserId='+encodeURIComponent(_chatUserId)).then(r=>r.json());
        _chatMyId = data.myId;
        const box = document.getElementById('chat-messages');
        if (!data.messages.length) { box.innerHTML='<p class="text-center text-sm text-gray-400 py-8">No messages yet. Say hi!</p>'; return; }
        box.innerHTML = data.messages.map(m => {
            const isMe=m.senderId===_chatMyId, unsent=m.isUnsent;
            if (unsent) return `<div class="flex ${isMe?'justify-end':'justify-start'}" id="chatmsg-${m.id}"><span class="text-xs italic text-gray-400 px-3 py-1 border border-gray-200 rounded-2xl">Message unsent</span></div>`;
            const _icoUnsend = `<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"/></svg>`;
            const _icoTrash  = `<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>`;
            const _menuHdr   = `<div style="padding:7px 14px 5px;font-size:10px;font-weight:700;letter-spacing:.08em;color:#9ca3af;text-transform:uppercase;border-bottom:1px solid #f3f4f6;">Message</div>`;
            const _menuDiv   = `<div style="height:1px;background:#f3f4f6;margin:2px 0;"></div>`;
            const menuItems = isMe
                ? `${_menuHdr}
                   <button onclick="unsendMsgModal(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-red-50 flex items-center gap-3" style="font-size:13px;color:#dc2626;">${_icoUnsend} Unsend for everyone</button>
                   ${_menuDiv}
                   <button onclick="deleteForMeModal(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-gray-50 flex items-center gap-3" style="font-size:13px;color:#6b7280;">${_icoTrash} Delete for me</button>`
                : `${_menuHdr}
                   <button onclick="deleteForMeModal(${m.id})" class="w-full text-left px-4 py-2.5 hover:bg-gray-50 flex items-center gap-3" style="font-size:13px;color:#6b7280;">${_icoTrash} Delete for me</button>`;
            return `<div class="flex ${isMe?'justify-end':'justify-start'}" id="chatmsg-${m.id}">
                <div class="max-w-[72%] relative">
                    <div class="chat-msg-bubble px-4 py-2 rounded-2xl text-sm cursor-pointer select-none ${isMe?'text-white rounded-br-sm':'bg-white border border-gray-200 text-gray-800 rounded-bl-sm'}"
                         style="${isMe?'background-color:#000147;':''}"
                         oncontextmenu="showMsgMenuModal(event,'cmmenu-${m.id}')"
                         ondblclick="showMsgMenuModal(event,'cmmenu-${m.id}')">
                        ${escHtml(m.content)}
                    </div>
                    <p class="text-[10px] mt-0.5 text-gray-400 ${isMe?'text-right':''}">${m.sentAt}</p>
                    <div id="cmmenu-${m.id}" class="chat-msg-menu hidden" style="position:fixed;z-index:10001;background:white;border:1px solid #e5e7eb;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,.12);min-width:175px;overflow:hidden;">${menuItems}</div>
                </div>
            </div>`;
        }).join('');
        box.scrollTop = box.scrollHeight;
        try { _msgConvos=await fetch('/Message/GetConversationList').then(r=>r.json()); document.getElementById('chat-sidebar').innerHTML=_msgConvos.map(c=>msgConvoRow(c,c.userId===_chatUserId)).join(''); } catch {}
        updateMsgBadge(0);
    } catch { document.getElementById('chat-messages').innerHTML='<p class="text-center text-sm text-red-400 py-8">Could not load</p>'; }
}

async function sendChatMsg() {
    const input=document.getElementById('chat-input'), text=input.value.trim();
    if (!text||!_chatUserId) return; input.value='';
    try { const fd=new FormData(); fd.append('receiverId',_chatUserId); fd.append('content',text); fd.append('__RequestVerificationToken',_tok()); await fetch('/Message/Send',{method:'POST',body:fd}); await loadChatMessages(); } catch { input.value=text; }
}
</script>

<!-- Message Dropdown (fixed, overlays header) -->
<div id="msgPanel" class="fixed z-[9997] bg-white border border-gray-200 rounded-2xl shadow-2xl overflow-hidden" style="display:none;width:380px;">
    <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between" style="background-color:#000147;">
        <span class="text-sm font-semibold text-white">Messages</span>
        <a href="/Message/Index" class="text-xs text-blue-200 hover:text-white transition">See all</a>
    </div>
    <div id="msgPanelList" class="divide-y divide-gray-100 overflow-y-auto" style="max-height:240px;">
        <p class="px-4 py-6 text-center text-sm text-gray-400">Loading…</p>
    </div>
</div>

<!-- Mini Chat Backdrop -->
<div id="miniChatBackdrop" onclick="closeMiniChat()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:9998;"></div>

<!-- Mini Chat Popup (centered) -->
<div id="miniChatPopup" class="fixed z-[9999] bg-white rounded-2xl shadow-2xl border border-gray-200 flex flex-col overflow-hidden" style="display:none;width:480px;height:580px;top:50%;left:50%;transform:translate(-50%,-50%);">
    <div class="px-4 py-3 flex items-center justify-between flex-shrink-0" style="background-color:#000147;">
        <div class="flex items-center gap-2 min-w-0">
            <div id="miniChatAvatar" class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0 bg-white/20"></div>
            <div class="min-w-0">
                <p id="miniChatName" class="text-sm font-semibold text-white truncate"></p>
                <p id="miniChatType" class="text-[10px] text-white/60"></p>
            </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
            <button onclick="closeMiniChat()" class="text-white/60 hover:text-white transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
    </div>
    <div id="miniChatMessages" class="flex-1 overflow-y-auto px-3 py-3 space-y-2 bg-gray-50">
        <p class="text-center text-xs text-gray-400 py-4">Loading…</p>
    </div>
    <div class="px-3 py-2 border-t border-gray-100 flex gap-2 flex-shrink-0 bg-white">
        @Html.AntiForgeryToken()
        <input id="miniChatInput" type="text" placeholder="Type a message…"
               class="flex-1 border border-gray-300 rounded-xl px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"
               onkeydown="if(event.key==='Enter'){event.preventDefault();sendMiniChat();}" />
        <button onclick="sendMiniChat()" class="px-3 py-1.5 text-xs text-white rounded-xl font-medium transition hover:opacity-90 flex-shrink-0" style="background-color:#000147;">Send</button>
    </div>
</div>

<!-- Message Chat Modal (two-panel) -->
<div id="msgChatModal" class="fixed inset-0 z-[9998] items-center justify-center bg-black/40 px-4" style="display:none;" onclick="if(event.target===this)closeMsgChat()">
    <div class="bg-white rounded-2xl shadow-2xl flex flex-col overflow-hidden w-full" style="max-width:780px;height:580px;">

        <!-- Full-width header row -->
        <div class="flex items-center justify-between px-5 py-3.5 flex-shrink-0" style="background-color:#000147;">
            <p class="text-sm font-semibold text-white tracking-wide">Messages</p>
            <button onclick="closeMsgChat()" class="text-white/70 hover:text-white transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Two-column body -->
        <div class="flex flex-1 min-h-0 overflow-hidden">

        <!-- Left sidebar -->
        <div class="flex flex-col border-r border-gray-200 flex-shrink-0" style="width:260px;">
            <div id="chat-sidebar" class="flex-1 overflow-y-auto divide-y divide-gray-100"></div>
        </div>
        <!-- Right conversation -->
        <div class="flex flex-col flex-1 min-w-0">
            <!-- Chat sub-header -->
            <div class="px-5 py-3 flex items-center gap-3 flex-shrink-0 border-b border-gray-100">
                <div id="chat-avatar" class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0" style="background-color:#000147;"></div>
                <div class="flex-1 min-w-0">
                    <p id="chat-name" class="text-sm font-semibold text-gray-800 truncate">Select a conversation</p>
                    <p id="chat-type" class="text-xs text-gray-400"></p>
                </div>
            </div>
            <div id="chat-messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-2 bg-gray-50">
                <p class="text-center text-sm text-gray-400 py-8">Select a conversation to start</p>
            </div>
            <div class="px-4 py-3 border-t border-gray-200 flex gap-2 flex-shrink-0 bg-white">
                @Html.AntiForgeryToken()
                <input id="chat-input" type="text" placeholder="Type a message…"
                       class="flex-1 border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"
                       onkeydown="if(event.key==='Enter'){event.preventDefault();sendChatMsg();}"/>
                <button onclick="sendChatMsg()" class="px-4 py-2 text-sm text-white rounded-xl font-medium flex-shrink-0 transition hover:opacity-90" style="background-color:#000147;">Send</button>
            </div>
        </div>
        </div><!-- end two-column body -->
    </div>
</div>
</body>
</html>
