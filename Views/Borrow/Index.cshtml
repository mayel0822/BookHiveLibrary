@using BookHiveLibrary.Models
@model IEnumerable<BookReservation>
@{
    Layout = "~/Views/Shared/_LibrarianLayout.cshtml";
    ViewData["Title"] = "Transaction Management - Book";
    var pending      = ViewBag.PendingReservations as List<BookReservation> ?? new List<BookReservation>();
    var sendReminder = ViewBag.BooksDue            as List<BookReservation> ?? new List<BookReservation>();
    var allDue       = ViewBag.AllBooksDue         as List<BookReservation> ?? new List<BookReservation>();
    var advisers     = ViewBag.SectionAdvisers     as Dictionary<string,string> ?? new Dictionary<string,string>();
}

<!-- Stats Row -->
<div class="grid grid-cols-3 gap-4 mb-6">
    <div class="rounded-xl p-4 text-white text-center" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Total Books</p>
        <p class="text-3xl font-bold">@ViewBag.TotalBooks</p>
    </div>
    <div class="rounded-xl p-4 text-white text-center" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Available</p>
        <p class="text-3xl font-bold">@ViewBag.AvailableCount</p>
    </div>
    <div class="rounded-xl p-4 text-white text-center" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Borrowed</p>
        <p class="text-3xl font-bold">@ViewBag.BorrowedCount</p>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
    <!-- Pending Reservations Panel -->
    <div class="col-span-1 bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col" style="max-height:420px;">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
            <h2 class="font-semibold" class="text-gray-900">Pending Reservations</h2>
            <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">@pending.Count</span>
        </div>

        <!-- RFID Tap Area -->
        <div class="px-4 py-3 border-b border-gray-100 bg-gray-50">
            <div id="rfidFieldWrap" class="flex rounded-lg overflow-hidden border border-gray-300 transition-all duration-200">
                <input id="rfidInput" type="text" placeholder=""
                       class="flex-1 px-4 py-2.5 text-sm text-gray-600 bg-white focus:outline-none" autocomplete="off" readonly />
                <button id="rfidTapBtn" type="button" onclick="activateRfidScan()"
                        class="px-4 py-2.5 text-sm font-semibold text-white flex-shrink-0 transition-colors duration-200"
                        style="background-color:#000147;">
                    Tap RFID Card
                </button>
            </div>
            <p id="rfidError" class="text-xs text-red-500 mt-1 hidden"></p>
        </div>
        <div class="flex-1 overflow-y-auto divide-y divide-gray-100">
            @if (!pending.Any())
            {
                <p class="px-5 py-8 text-center text-gray-400 text-sm">No pending reservations</p>
            }
            @foreach (var r in pending)
            {
                var timeLeft = r.PickupDeadline - DateTime.UtcNow;
                var isExpiringSoon = timeLeft.TotalMinutes <= 30 && timeLeft.TotalMinutes > 0;
                var timeDisplay = timeLeft.TotalMinutes > 0
                    ? $"{(int)timeLeft.TotalHours}h {timeLeft.Minutes:D2}m left"
                    : "Expiring...";

                <div class="px-4 py-3 border-b border-gray-50 reservation-row transition-colors duration-300"
                     data-student-no="@r.User?.StudentNumber">
                    <div class="flex items-start gap-3">
                        <div class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 text-sm font-bold flex-shrink-0">
                            @r.User?.LastName?.FirstOrDefault()
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-800">@r.User?.LastName, @r.User?.FirstName @(string.IsNullOrEmpty(r.User?.MiddleName) ? "" : r.User!.MiddleName![0] + ".")</p>
                            @{
                                var sect = r.User?.Section ?? "";
                                var adv  = (!string.IsNullOrEmpty(sect) && advisers.TryGetValue(sect, out var a) && !string.IsNullOrEmpty(a)) ? a : "";
                            }
                            <p class="text-xs text-gray-500">@sect@(adv != "" ? " — " + adv : "")</p>
                            <p class="text-xs text-gray-600 truncate mt-0.5">@r.Book?.Title</p>
                            <span class="text-xs @(isExpiringSoon ? "text-red-500 font-semibold" : "text-gray-400")">@timeDisplay</span>
                        </div>
                    </div>
                    <div class="flex gap-2 mt-2 ml-12">
                        <form method="post" action="@Url.Action("Deny","Borrow")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="px-3 py-1.5 text-xs border border-red-300 text-red-600 rounded-lg hover:bg-red-50">Deny</button>
                        </form>
                        <form method="post" action="@Url.Action("Approve","Borrow")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@r.Id" />
                            <button type="submit" class="px-3 py-1.5 text-xs text-white rounded-lg" style="background-color:#000147;">Picked Up</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Books Due Panel -->
    <div class="col-span-1 bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col" style="max-height:420px;">
        <div class="px-5 py-4 border-b border-gray-100 flex-shrink-0">
            <h2 class="font-semibold" class="text-gray-900">Books Due</h2>
        </div>
        <div class="flex-1 overflow-y-auto divide-y divide-gray-100">
            @if (!allDue.Any())
            {
                <p class="px-5 py-8 text-center text-gray-400 text-sm">No active borrows</p>
            }
            @{
                // Group by the PH calendar date, not the raw stored UTC date — DueDate
                // is stored as UTC, so taking .Date on it directly can land on the wrong
                // day (e.g. a deadline just after midnight UTC is still evening of the
                // previous day in the Philippines).
                var grouped = allDue.GroupBy(r => PhTime.FromUtc(r.DueDate)?.Date ?? DateTime.MinValue).OrderBy(g => g.Key);
                var todayPh = PhTime.Now.Date;
            }
            @foreach (var group in grouped)
            {
                <div class="px-4 py-2 bg-gray-50">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
                        @group.Key.ToString("dddd, MMMM dd")
                        @if (group.Key.Date == todayPh)
                        { <span class="ml-1 text-red-500">(Today)</span> }
                        else if (group.Key.Date == todayPh.AddDays(1))
                        { <span class="ml-1 text-yellow-500">(Tomorrow)</span> }
                    </p>
                </div>
                @foreach (var r in group)
                {
                    var isOverdue = r.DueDate < DateTime.UtcNow;
                    <div class="px-4 py-2.5 hover:bg-gray-50">
                        <p class="text-sm font-medium text-gray-800">@r.User?.LastName, @r.User?.FirstName</p>
                        <p class="text-xs text-gray-500 truncate">@r.Book?.Title</p>
                        @if (isOverdue)
                        {
                            <span class="text-xs text-red-500 font-medium">Overdue</span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Borrowed Books Table — same fixed-height card pattern as the two panels
     above: max-height on the OUTER card (not just the inner table wrapper), so
     the whole box has one predictable size instead of growing to whatever the
     header row plus table happen to need. Header stays pinned via flex-shrink-0;
     only the table body scrolls, in the flex-1 area beneath it. -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col" style="max-height:32rem;">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between gap-3 flex-wrap flex-shrink-0">
        <h2 class="font-semibold" class="text-gray-900">Borrowed Books</h2>
        <div class="flex items-center gap-3 flex-1 justify-end min-w-[200px]">
            <!-- Find the person returning a book, either by typing a name/student
                 number (filters the table instantly, no round trip — the full list
                 is already rendered on the page) or by tapping their RFID card,
                 same "input + Tap RFID Card button" pattern as the Pending
                 Reservations panel above. -->
            <div class="max-w-sm w-full">
                <div id="returnRfidWrap" class="flex rounded-lg overflow-hidden border border-gray-300 transition-all duration-200">
                    <input id="returnSearchInput" type="text" placeholder="Find by name or student number..."
                           oninput="filterReturnTable()" autocomplete="off"
                           class="flex-1 min-w-0 px-3 py-1.5 text-sm text-gray-700 bg-white focus:outline-none" />
                    <button id="returnRfidBtn" type="button" onclick="activateReturnRfidScan()"
                            class="px-3 py-1.5 text-sm font-semibold text-white flex-shrink-0 transition-colors duration-200"
                            style="background-color:#000147;">
                        Tap RFID Card
                    </button>
                </div>
                <p id="returnRfidError" class="text-xs text-red-500 mt-1 hidden"></p>
            </div>
            <button onclick="openBorrowModal()" class="btn-primary flex-shrink-0">+ Borrow Book</button>
        </div>
    </div>
    <div class="flex-1 overflow-auto">
        <table class="bh-table" id="returnTable">
            <thead>
                <tr>
                    <th>Stud ID</th>
                    <th>Name</th>
                    <th>Level</th>
                    <th>Course</th>
                    <th>Section</th>
                    <th>Book Title</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var searchKey = $"{r.User?.StudentNumber} {r.User?.FirstName} {r.User?.LastName}".ToLower();
                    <tr class="return-row @(r.Status == "ReturnedLate" ? "bh-selected" : "")" data-search="@searchKey">
                        <td class="px-4 py-3 text-gray-600 text-xs">@r.User?.StudentNumber</td>
                        <td class="px-4 py-3 font-medium text-gray-800">
                            @r.User?.FirstName @r.User?.LastName
                            @if (r.Status == "Overdue")
                            {
                                <span class="ml-1 px-2 py-0.5 bg-red-100 text-red-700 text-xs font-semibold rounded-full">OVERDUE</span>
                            }
                            else if (r.Status == "ReturnedLate")
                            {
                                <span class="ml-1 px-2 py-0.5 bg-orange-100 text-orange-700 text-xs font-semibold rounded-full">Returned Late</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-gray-600">@r.User?.Level</td>
                        <td class="px-4 py-3 text-gray-600">@r.User?.Course</td>
                        <td class="px-4 py-3 text-gray-600">@r.User?.Section</td>
                        <td class="px-4 py-3 text-gray-700">@r.Book?.Title</td>
                        <td class="px-4 py-3 text-gray-500 text-xs">@PhTime.FromUtc(r.ActualPickupTime)?.ToString("MM/dd/yyyy")</td>
                        <td class="px-4 py-3 text-gray-500 text-xs">@PhTime.FromUtc(r.DueDate)?.ToString("MM/dd/yyyy")</td>
                        <td class="px-4 py-3">
                            @{
                                var badgeClass = r.Status switch {
                                    "Overdue"      => "bg-red-100 text-red-700",
                                    "ReturnedLate" => "bg-orange-100 text-orange-700",
                                    "PickedUp"     => "bg-green-100 text-green-700",
                                    "Approved"     => "bg-blue-100 text-blue-700",
                                    _              => "bg-gray-100 text-gray-600"
                                };
                                var label = r.Status switch {
                                    "PickedUp"     => "Active",
                                    "ReturnedLate" => "Returned Late",
                                    _              => r.Status
                                };
                            }
                            <span class="px-2 py-1 rounded-full text-xs font-medium @badgeClass">@label</span>
                        </td>
                        <td class="px-4 py-3">
                            @if (r.Status == "PickedUp" || r.Status == "Overdue")
                            {
                                <form method="post" action="@Url.Action("ConfirmReturn","Borrow")" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="text-xs px-3 py-1.5 border border-gray-300 text-gray-600 rounded hover:bg-gray-50">Return</button>
                                </form>
                            }
                            else if (r.Status == "ReturnedLate")
                            {
                                <form method="post" action="@Url.Action("AcknowledgeLateReturn","Borrow")" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="text-xs px-3 py-1.5 bg-orange-500 text-white rounded hover:bg-orange-600">Acknowledge</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="px-4 py-8 text-center text-gray-400">No borrowed books yet. Use <strong>+ Borrow Book</strong> to record a walk-up borrow.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Borrow Slip Modal (RFID pickup confirmation) -->
<div id="borrowSlipModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-xl w-full max-w-lg mx-4 shadow-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between" style="background-color:#000147;">
            <h3 class="text-base font-semibold text-white">Borrow Slip — Pickup Confirmation</h3>
            <button onclick="closeSlip()" class="text-white/70 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div class="px-6 py-5">
            <div class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm mb-5">
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Student / Employee No.</p>
                    <p id="slipStudentNo" class="font-medium text-gray-800"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Name</p>
                    <p id="slipName" class="font-medium text-gray-800"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Section</p>
                    <p id="slipSection" class="font-medium text-gray-800"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Course / Level</p>
                    <p id="slipCourse" class="font-medium text-gray-800"></p>
                </div>
                <div class="col-span-2 border-t border-gray-100 pt-3">
                    <p class="text-xs text-gray-400 mb-0.5">Book Title</p>
                    <p id="slipBook" class="font-semibold text-gray-800"></p>
                    <p id="slipAuthor" class="text-xs text-gray-500"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Reserved At</p>
                    <p id="slipReservedAt" class="text-gray-600"></p>
                </div>
                <div>
                    <p class="text-xs text-gray-400 mb-0.5">Time Remaining</p>
                    <p id="slipTimeLeft" class="text-gray-600"></p>
                </div>
            </div>
            <form method="post" action="@Url.Action("Approve","Borrow")">
                @Html.AntiForgeryToken()
                <input type="hidden" id="slipReservationId" name="id" value="" />
                <div class="flex gap-3">
                    <button type="button" onclick="closeSlip()" class="btn-secondary flex-1 justify-center">Cancel</button>
                    <button type="submit" class="btn-primary flex-1 justify-center">Confirm Pickup</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Borrow Book Modal — Landscape layout -->
<div id="borrowModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden px-4">
    <div class="bg-white rounded-xl shadow-xl w-full overflow-hidden" style="max-width:900px;">

        <!-- Header -->
        <div class="px-6 py-4 flex items-center justify-between" style="background-color:#000147;">
            <div>
                <h3 class="text-base font-semibold text-white">Borrow Slip</h3>
                <p class="text-xs text-white/60 mt-0.5">Walk-in Borrow Record</p>
            </div>
            <button type="button" onclick="closeBorrowModal()" class="text-white/60 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <form method="post" action="@Url.Action("CreateBorrow","Borrow")" id="borrowForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="borrowUserId" />
            <input type="hidden" name="bookId" id="borrowBookSelect" required />

            <!-- Landscape body: left = borrower info, right = book selection -->
            <div class="flex divide-x divide-gray-100">

                <!-- ── LEFT: Borrower Info ─────────────────────────────── -->
                <div class="flex-1 px-6 pt-5 pb-4 flex flex-col gap-4">

                    <!-- User Type + RFID / Professor search -->
                    <div class="flex gap-3">
                        <div class="w-36 flex-shrink-0">
                            <p class="text-xs text-gray-400 mb-1">User Type</p>
                            <select id="borrowUserType" onchange="onBorrowTypeChange()"
                                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                                <option value="">Select...</option>
                                <option value="Student">Student</option>
                                <option value="Professor">Professor</option>
                            </select>
                        </div>
                        <!-- Student: RFID -->
                        <div id="rfidBorrowArea" class="hidden flex-1">
                            <p class="text-xs text-gray-400 mb-1">RFID Card</p>
                            <div id="borrowRfidWrap" class="flex rounded-lg overflow-hidden border border-gray-300 transition-all duration-200">
                                <input id="borrowRfidInput" type="text" placeholder=""
                                       class="flex-1 px-4 py-2.5 text-sm text-gray-600 bg-white focus:outline-none" autocomplete="off" readonly />
                                <button id="borrowRfidTapBtn" type="button" onclick="activateBorrowRfidScan()"
                                        class="px-4 py-2.5 text-sm font-semibold text-white flex-shrink-0 transition-colors duration-200 whitespace-nowrap"
                                        style="background-color:#000147;">
                                    Tap RFID Card
                                </button>
                            </div>
                            <p id="borrowRfidError" class="text-xs text-red-500 mt-1 hidden"></p>
                        </div>
                        <!-- Professor: search -->
                        <div id="professorSelectArea" class="hidden flex-1 relative">
                            <p class="text-xs text-gray-400 mb-1">Employee No. / Name</p>
                            <input id="professorSearch" type="text" placeholder="Type to search..."
                                   oninput="onProfessorSearch()" autocomplete="off"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                            <div id="professorDropdown" class="hidden absolute left-0 right-0 top-full z-50 bg-white border border-gray-200 rounded-lg shadow-lg mt-1 max-h-44 overflow-y-auto"></div>
                            <p id="professorError" class="text-xs text-red-500 mt-1 hidden"></p>
                        </div>
                    </div>

                    <div class="border-t border-dashed border-gray-200"></div>

                    <!-- Borrower slip fields -->
                    <div class="grid grid-cols-2 gap-x-5 gap-y-3 text-sm">
                        <div class="col-span-2">
                            <p class="text-xs text-gray-400 mb-0.5">Student / Employee No.</p>
                            <p id="infoStudentNo" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1 hidden">—</p>
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Last Name</p>
                            <p id="infoLastName" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1 hidden">—</p>
                            <input id="inputLastName" type="text" placeholder="Last name" class="w-full border-b border-gray-300 py-1 text-sm font-medium text-gray-800 focus:outline-none focus:border-blue-400 bg-transparent hidden" />
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">First Name</p>
                            <p id="infoFirstName" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1 hidden">—</p>
                            <input id="inputFirstName" type="text" placeholder="First name" class="w-full border-b border-gray-300 py-1 text-sm font-medium text-gray-800 focus:outline-none focus:border-blue-400 bg-transparent hidden" />
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">M.I.</p>
                            <p id="infoMI" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1 hidden">—</p>
                            <input id="inputMI" type="text" placeholder="M.I." maxlength="2" class="w-full border-b border-gray-300 py-1 text-sm font-medium text-gray-800 focus:outline-none focus:border-blue-400 bg-transparent hidden" />
                        </div>
                        <div>
                            <p class="text-xs text-gray-400 mb-0.5">Section</p>
                            <p id="infoSection" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1 hidden">—</p>
                            <input id="inputSection" type="text" placeholder="Section" class="w-full border-b border-gray-300 py-1 text-sm font-medium text-gray-800 focus:outline-none focus:border-blue-400 bg-transparent hidden" />
                        </div>
                        <div class="col-span-2">
                            <p class="text-xs text-gray-400 mb-0.5">Adviser</p>
                            <p id="infoAdviser" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1 hidden">—</p>
                            <input id="inputAdviser" type="text" placeholder="Adviser name" class="w-full border-b border-gray-300 py-1 text-sm font-medium text-gray-800 focus:outline-none focus:border-blue-400 bg-transparent hidden" />
                        </div>
                    </div>

                    <!-- Due date -->
                    <div class="flex items-center gap-2 text-xs text-gray-400 mt-auto">
                        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        Due: <span id="dueDateDisplay" class="font-medium text-gray-600"></span>
                    </div>
                </div>

                <!-- ── RIGHT: Book Selection ───────────────────────────── -->
                <div class="flex-1 px-6 pt-5 pb-4 flex flex-col gap-4">

                    <!-- Selected book display fields -->
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Book Title</p>
                        <p id="selectedBookTitle" class="font-medium text-gray-800 min-h-[1.25rem] border-b border-gray-200 pb-1 text-sm"></p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-400 mb-0.5">Book Information</p>
                        <p id="selectedBookAuthor" class="text-sm text-gray-500 min-h-[1.25rem] border-b border-gray-200 pb-1"></p>
                    </div>

                    <div class="border-t border-dashed border-gray-200"></div>

                    <!-- Search box + category filter -->
                    <div id="bookSearchArea" class="flex flex-col gap-2 flex-1">
                        <div class="flex gap-2">
                            <select id="bookCategoryFilter" onchange="filterBooks()"
                                    class="border border-gray-300 rounded-lg px-2 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-blue-300 flex-shrink-0">
                                <option value="">All Categories</option>
                                @if (ViewBag.AvailableBooks != null)
                                {
                                    var cats = ((List<BookHiveLibrary.Models.Book>)ViewBag.AvailableBooks)
                                        .Select(b => b.Category).Distinct().OrderBy(c => c);
                                    foreach (var cat in cats)
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                }
                            </select>
                            <div class="flex-1 relative">
                                <input id="bookSearchInput" type="text"
                                       placeholder="Search by title, author, or ISBN..."
                                       oninput="filterBooks()"
                                       class="w-full border border-gray-300 rounded-lg pl-3 pr-8 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                                <svg class="w-4 h-4 text-gray-400 absolute right-2.5 top-2.5 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z"/>
                                </svg>
                            </div>
                        </div>

                        <!-- Results list -->
                        <div id="bookResultsList"
                             class="border border-gray-200 rounded-lg overflow-y-auto bg-white flex-1"
                             style="min-height:120px; max-height:220px;">
                            <p class="text-xs text-gray-400 text-center py-6">Type to search for a book</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="px-6 py-4 border-t border-gray-100 flex gap-3">
                <button type="button" onclick="closeBorrowModal()" class="btn-secondary flex-1 justify-center">Cancel</button>
                <button type="submit" id="borrowSubmitBtn" disabled
                        class="btn-primary flex-1 justify-center opacity-50 cursor-not-allowed">
                    Confirm Borrow
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const rfidInput   = document.getElementById('rfidInput');
const rfidError   = document.getElementById('rfidError');
const rfidTapBtn  = document.getElementById('rfidTapBtn');
const rfidWrap    = document.getElementById('rfidFieldWrap');
let rfidBuffer    = '';
let rfidTimer     = null;
let rfidListening = false;

// RFID scan state for the Borrowed Books search (separate from the Pending
// Reservations one above — that one opens the pickup slip, this one just
// fills in and filters the return-lookup search box).
let returnRfidListening = false;

// ── Activate scan mode ───────────────────────────────────────────────────
function activateRfidScan() {
    rfidListening = true;
    rfidInput.readOnly = false;
    rfidInput.value = '';
    rfidInput.placeholder = 'Waiting for RFID tap...';
    rfidError.classList.add('hidden');
    rfidWrap.style.borderColor = '#3b82f6';
    rfidWrap.style.boxShadow = '0 0 0 2px rgba(59,130,246,.25)';
    rfidTapBtn.style.backgroundColor = '#1d4ed8';
    rfidTapBtn.textContent = 'Scanning...';
    rfidInput.focus();
}

function deactivateRfidScan() {
    rfidListening = false;
    rfidInput.readOnly = true;
    rfidWrap.style.borderColor = '';
    rfidWrap.style.boxShadow = '';
    rfidTapBtn.style.backgroundColor = '#000147';
    rfidTapBtn.textContent = 'Tap RFID Card';
}

function clearRfidField() {
    rfidBuffer = '';
    clearTimeout(rfidTimer);
    rfidInput.value = '';
    rfidInput.placeholder = '';
    rfidError.classList.add('hidden');
    deactivateRfidScan();
    clearHighlight();
}

// ── Desk ESP32 reader — SignalR bridge ───────────────────────────────────
// When desk ESP32 scans a card, server pushes the RFID here and
// we auto-trigger the same lookup as a keyboard-reader tap
if (typeof libraryConnection !== 'undefined') {
    function _joinTransactionBorrow() {
        libraryConnection.invoke("JoinTransaction").catch(err => console.error(err));
    }
    (window._libConnected || Promise.resolve()).then(_joinTransactionBorrow);
    libraryConnection.onreconnected(() => _joinTransactionBorrow());

    libraryConnection.on("DeskRfidTap", function(data) {
        // Checked first, and only when the librarian explicitly armed it by
        // clicking "Tap RFID Card" next to the Borrowed Books search — so a tap
        // meant for finding someone returning a book doesn't get swallowed by the
        // pending-reservation/pickup-slip flow below, which has no equivalent
        // explicit "arm" step of its own.
        if (returnRfidListening) {
            lookupReturnRfid(data.rfidNumber);
            return;
        }
        const borrowModal  = document.getElementById('borrowModal');
        const isBorrowOpen = borrowModal && !borrowModal.classList.contains('hidden');
        if (isBorrowOpen && currentBorrowType === 'Student') {
            lookupBorrowRfid(data.rfidNumber);
        } else if (!isBorrowOpen) {
            // Auto-activate scan mode then process the tap
            rfidListening = true;
            rfidInput.readOnly = false;
            lookupRfid(data.rfidNumber);
        }
    });
}
// ─────────────────────────────────────────────────────────────────────────

// RFID readers type characters rapidly then send Enter
rfidInput.addEventListener('keydown', function(e) {
    if (!rfidListening) return;
    if (e.key === 'Enter') {
        e.preventDefault();
        const rfid = rfidBuffer.trim();
        rfidBuffer = '';
        if (rfid) lookupRfid(rfid);
    }
});

rfidInput.addEventListener('input', function() {
    if (!rfidListening) return;
    rfidBuffer = this.value;
    clearTimeout(rfidTimer);
    rfidTimer = setTimeout(() => {
        const rfid = rfidBuffer.trim();
        rfidBuffer = '';
        if (rfid.length >= 4) lookupRfid(rfid);
    }, 200);
});

// ── Highlight matching reservation row ───────────────────────────────────
function highlightReservationRow(studentNo) {
    clearHighlight();
    if (!studentNo) return;
    const rows = document.querySelectorAll('.reservation-row');
    for (const row of rows) {
        if (row.dataset.studentNo === studentNo) {
            row.style.backgroundColor = '#eff6ff';
            row.style.borderLeft = '3px solid #3b82f6';
            row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            break;
        }
    }
}

function clearHighlight() {
    document.querySelectorAll('.reservation-row').forEach(r => {
        r.style.backgroundColor = '';
        r.style.borderLeft = '';
    });
}

// ── RFID tap for the Borrowed Books search ───────────────────────────────
// Resolves the tapped card to a student, then fills in and runs the same
// client-side filter typing would trigger. Uses FindUserByRfid (identity
// only) rather than FindByRfid (requires an existing Pending reservation) —
// someone returning a book has an active PickedUp/Overdue one, not a
// Pending one, so FindByRfid would always report "not found" here.
function activateReturnRfidScan() {
    returnRfidListening = true;
    document.getElementById('returnRfidWrap').style.borderColor = '#3b82f6';
    document.getElementById('returnRfidWrap').style.boxShadow = '0 0 0 2px rgba(59,130,246,.25)';
    document.getElementById('returnRfidBtn').style.backgroundColor = '#1d4ed8';
    document.getElementById('returnRfidBtn').textContent = 'Scanning...';
    document.getElementById('returnSearchInput').placeholder = 'Waiting for RFID tap...';
    document.getElementById('returnRfidError').classList.add('hidden');
}

function deactivateReturnRfidScan() {
    returnRfidListening = false;
    document.getElementById('returnRfidWrap').style.borderColor = '';
    document.getElementById('returnRfidWrap').style.boxShadow = '';
    document.getElementById('returnRfidBtn').style.backgroundColor = '#000147';
    document.getElementById('returnRfidBtn').textContent = 'Tap RFID Card';
    document.getElementById('returnSearchInput').placeholder = 'Find by name or student number...';
}

async function lookupReturnRfid(rfid) {
    try {
        const res = await fetch(`@Url.Action("FindUserByRfid","Borrow")?rfid=${encodeURIComponent(rfid)}`);
        const data = await res.json();
        deactivateReturnRfidScan();

        const errorEl = document.getElementById('returnRfidError');
        if (!data.found) {
            errorEl.textContent = data.message || 'Card not recognized.';
            errorEl.classList.remove('hidden');
            return;
        }

        document.getElementById('returnSearchInput').value = data.studentNumber || '';
        filterReturnTable(); // setting .value directly doesn't fire oninput
    } catch {
        deactivateReturnRfidScan();
        const errorEl = document.getElementById('returnRfidError');
        errorEl.textContent = 'Error communicating with server.';
        errorEl.classList.remove('hidden');
    }
}

// ── Find the person returning a book (Borrowed Books table) ─────────────
// Client-side filter — the whole list is already on the page, so this is
// instant with no server round trip. Matches name or student number.
function filterReturnTable() {
    const term = document.getElementById('returnSearchInput').value.trim().toLowerCase();
    const rows = document.querySelectorAll('#returnTable tbody tr.return-row');
    let anyVisible = false;

    rows.forEach(row => {
        const matches = !term || (row.dataset.search || '').includes(term);
        row.style.display = matches ? '' : 'none';
        if (matches) anyVisible = true;
    });

    let emptyRow = document.getElementById('returnSearchEmptyRow');
    if (!anyVisible && term) {
        if (!emptyRow) {
            const tbody = document.querySelector('#returnTable tbody');
            emptyRow = document.createElement('tr');
            emptyRow.id = 'returnSearchEmptyRow';
            emptyRow.innerHTML = '<td colspan="10" class="px-4 py-8 text-center text-gray-400">No matching student found.</td>';
            tbody.appendChild(emptyRow);
        }
        emptyRow.style.display = '';
    } else if (emptyRow) {
        emptyRow.style.display = 'none';
    }
}

async function lookupRfid(rfid) {
    rfidError.classList.add('hidden');
    rfidInput.placeholder = 'Looking up...';

    try {
        const res = await fetch(`@Url.Action("FindByRfid","Borrow")?rfid=${encodeURIComponent(rfid)}`);
        const data = await res.json();

        if (!data.found) {
            rfidError.textContent = data.message;
            rfidError.classList.remove('hidden');
            rfidInput.value = '';
            rfidInput.placeholder = '';
            deactivateRfidScan();
            return;
        }

        // Show student number in field and deactivate scan mode
        rfidInput.value = data.studentNumber || '';
        rfidInput.placeholder = '';
        deactivateRfidScan();

        // Highlight the matching pending reservation row
        highlightReservationRow(data.studentNumber);

        // Fill and open borrow slip
        document.getElementById('slipStudentNo').textContent  = data.studentNumber  || '—';
        document.getElementById('slipName').textContent       = data.fullName        || '—';
        document.getElementById('slipSection').textContent    = data.section         || '—';
        document.getElementById('slipCourse').textContent     = [data.course, data.level].filter(Boolean).join(' · ') || '—';
        document.getElementById('slipBook').textContent       = data.bookTitle       || '—';
        document.getElementById('slipAuthor').textContent     = data.bookAuthor      || '';
        document.getElementById('slipReservedAt').textContent = data.reservedAt      || '—';
        document.getElementById('slipTimeLeft').textContent   = data.timeLeft        || '—';
        document.getElementById('slipReservationId').value    = data.reservationId;

        document.getElementById('borrowSlipModal').classList.remove('hidden');
    } catch {
        rfidError.textContent = 'Error communicating with server.';
        rfidError.classList.remove('hidden');
        deactivateRfidScan();
    }
}

function closeSlip() {
    document.getElementById('borrowSlipModal').classList.add('hidden');
    clearHighlight();
    clearRfidField();
}

// ── Walk-in Borrow Modal ──────────────────────────────────────────────────────

// Compute and display the actual due date (2 days from now at 4:30 PM PHT UTC+08:00)
(function() {
    const PHT = 'Asia/Kuala_Lumpur';
    const dueDate = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000);
    const dateStr = new Intl.DateTimeFormat('en-US', {
        timeZone: PHT, month: 'long', day: 'numeric', year: 'numeric'
    }).format(dueDate);
    const el = document.getElementById('dueDateDisplay');
    if (el) el.textContent = dateStr + ' at 4:30 PM';
})();

let borrowRfidBuffer = '';
let borrowRfidTimer  = null;
let currentBorrowType = '';
let borrowRfidListening = false;

// Professor data for search
const professorData = [
    @if (ViewBag.Students != null)
    {
        foreach (var u in (List<BookHiveLibrary.Models.ApplicationUser>)ViewBag.Students)
        {
            if (u.UserType == "Professor")
            {
                @Html.Raw($"{{ id:'{u.Id}', ln:'{u.LastName?.Replace("'","\\'")}', fn:'{u.FirstName?.Replace("'","\\'")}', mn:'{(u.MiddleName ?? "").Replace("'","\\'")}', section:'{(u.Section ?? "").Replace("'","\\'")}', empno:'{(u.EmployeeNumber ?? "").Replace("'","\\'")}' }},")
            }
        }
    }
];

function openBorrowModal() {
    resetBorrowModal();
    document.getElementById('borrowModal').classList.remove('hidden');
}

function closeBorrowModal() {
    document.getElementById('borrowModal').classList.add('hidden');
    resetBorrowModal();
    rfidInput.focus();
}

function resetBorrowModal() {
    currentBorrowType = '';
    document.getElementById('borrowUserType').value = '';
    document.getElementById('borrowUserId').value = '';
    document.getElementById('rfidBorrowArea').classList.add('hidden');
    document.getElementById('professorSelectArea').classList.add('hidden');
    clearBookSelection();
    document.getElementById('borrowSubmitBtn').disabled = true;
    document.getElementById('borrowSubmitBtn').classList.add('opacity-50', 'cursor-not-allowed');
    const errEl = document.getElementById('borrowRfidError');
    if (errEl) { errEl.textContent = ''; errEl.classList.add('hidden'); }
    // Reset RFID tap-button state
    borrowRfidListening = false;
    borrowRfidBuffer = '';
    if (borrowRfidInputEl) { borrowRfidInputEl.value = ''; borrowRfidInputEl.placeholder = ''; borrowRfidInputEl.readOnly = true; }
    if (borrowRfidWrap)    { borrowRfidWrap.style.borderColor = ''; borrowRfidWrap.style.boxShadow = ''; }
    if (borrowRfidTapBtn)  { borrowRfidTapBtn.style.backgroundColor = '#000147'; borrowRfidTapBtn.textContent = 'Tap RFID Card'; }
    showSlipFields(false);
    clearBorrowerInfo();
}

function showSlipFields(show) {
    // Both student and professor use the read-only display fields after lookup
    ['infoStudentNo','infoLastName','infoFirstName','infoMI','infoSection','infoAdviser'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('hidden', !show);
    });
    // Manual input fields are never used — always hidden
    ['inputLastName','inputFirstName','inputMI','inputSection','inputAdviser'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
    });
}

function onBorrowTypeChange() {
    currentBorrowType = document.getElementById('borrowUserType').value;
    document.getElementById('rfidBorrowArea').classList.toggle('hidden', currentBorrowType !== 'Student');
    document.getElementById('professorSelectArea').classList.toggle('hidden', currentBorrowType !== 'Professor');
    document.getElementById('borrowUserId').value = '';
    document.getElementById('borrowSubmitBtn').disabled = true;
    document.getElementById('borrowSubmitBtn').classList.add('opacity-50', 'cursor-not-allowed');
    clearBorrowerInfo();

    if (currentBorrowType === 'Student') {
        showSlipFields(false); // shows after RFID tap
        setTimeout(() => document.getElementById('borrowRfidInput')?.focus(), 50);
    } else if (currentBorrowType === 'Professor') {
        showSlipFields(false); // shows after professor is selected from search
        setTimeout(() => document.getElementById('professorSearch')?.focus(), 50);
    } else {
        showSlipFields(false);
    }
}


function clearBorrowerInfo() {
    ['infoStudentNo','infoLastName','infoFirstName','infoMI','infoSection','infoAdviser'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = '—';
    });
    ['inputLastName','inputFirstName','inputMI','inputSection','inputAdviser'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });
}

function fillBorrowerInfo(data) {
    document.getElementById('infoStudentNo').textContent = data.studentNumber || data.employeeNumber || '—';
    document.getElementById('infoLastName').textContent  = data.lastName   || '—';
    document.getElementById('infoFirstName').textContent = data.firstName  || '—';
    document.getElementById('infoMI').textContent        = data.middleName ? data.middleName[0] + '.' : '—';
    document.getElementById('infoSection').textContent   = data.section    || '—';
    document.getElementById('infoAdviser').textContent   = data.adviserName || '—';
    document.getElementById('borrowUserId').value        = data.userId || '';
    showSlipFields(true);
    document.getElementById('borrowSubmitBtn').disabled = false;
    document.getElementById('borrowSubmitBtn').classList.remove('opacity-50', 'cursor-not-allowed');
}

// ── Borrow modal RFID — tap-button pattern (mirrors Pending Reservations) ───
const borrowRfidInputEl = document.getElementById('borrowRfidInput');
const borrowRfidWrap    = document.getElementById('borrowRfidWrap');
const borrowRfidTapBtn  = document.getElementById('borrowRfidTapBtn');

function activateBorrowRfidScan() {
    borrowRfidListening = true;
    borrowRfidInputEl.readOnly = false;
    borrowRfidInputEl.value = '';
    borrowRfidInputEl.placeholder = 'Waiting for RFID tap...';
    borrowRfidWrap.style.borderColor = '#3b82f6';
    borrowRfidWrap.style.boxShadow = '0 0 0 2px rgba(59,130,246,.25)';
    borrowRfidTapBtn.style.backgroundColor = '#1d4ed8';
    borrowRfidTapBtn.textContent = 'Scanning...';
    borrowRfidInputEl.focus();
}

function deactivateBorrowRfidScan() {
    borrowRfidListening = false;
    borrowRfidInputEl.readOnly = true;
    borrowRfidWrap.style.borderColor = '';
    borrowRfidWrap.style.boxShadow = '';
    borrowRfidTapBtn.style.backgroundColor = '#000147';
    borrowRfidTapBtn.textContent = 'Tap RFID Card';
}

if (borrowRfidInputEl) {
    borrowRfidInputEl.addEventListener('keydown', function(e) {
        if (!borrowRfidListening) return;
        if (e.key === 'Enter') {
            e.preventDefault();
            const rfid = borrowRfidBuffer.trim();
            borrowRfidBuffer = '';
            if (rfid) lookupBorrowRfid(rfid);
        }
    });
    borrowRfidInputEl.addEventListener('input', function() {
        if (!borrowRfidListening) return;
        borrowRfidBuffer = this.value;
        clearTimeout(borrowRfidTimer);
        borrowRfidTimer = setTimeout(() => {
            const rfid = borrowRfidBuffer.trim();
            borrowRfidBuffer = '';
            borrowRfidInputEl.value = '';
            if (rfid.length >= 4) lookupBorrowRfid(rfid);
        }, 200);
    });
}

async function lookupBorrowRfid(rfid) {
    const errEl = document.getElementById('borrowRfidError');
    if (errEl) errEl.classList.add('hidden');
    if (borrowRfidInputEl) borrowRfidInputEl.placeholder = 'Looking up...';

    try {
        const res = await fetch(`@Url.Action("FindUserByRfid","Borrow")?rfid=${encodeURIComponent(rfid)}`);
        const data = await res.json();
        if (!data.found) {
            if (errEl) { errEl.textContent = data.message; errEl.classList.remove('hidden'); }
            deactivateBorrowRfidScan();
        } else {
            // Show student number in field, then lock the input
            if (borrowRfidInputEl) {
                borrowRfidInputEl.value = data.studentNumber || '';
                borrowRfidInputEl.placeholder = '';
            }
            deactivateBorrowRfidScan();
            fillBorrowerInfo(data);
        }
    } catch {
        if (errEl) { errEl.textContent = 'Error communicating with server.'; errEl.classList.remove('hidden'); }
        deactivateBorrowRfidScan();
    }
}

// Professor search
function onProfessorSearch() {
    const q  = document.getElementById('professorSearch').value.toLowerCase().trim();
    const dd = document.getElementById('professorDropdown');
    if (!q) { dd.classList.add('hidden'); return; }

    const matches = professorData.filter(p =>
        (p.ln + ' ' + p.fn + ' ' + p.empno).toLowerCase().includes(q)
    ).slice(0, 8);

    if (!matches.length) { dd.classList.add('hidden'); return; }

    dd.innerHTML = matches.map(p => `
        <div class="flex items-center gap-3 px-3 py-2.5 text-sm text-gray-700 hover:bg-blue-50 cursor-pointer transition"
             onclick="selectProfessor('${p.id}','${p.ln.replace(/'/g,"\\'")}','${p.fn.replace(/'/g,"\\'")}','${p.mn.replace(/'/g,"\\'")}','${p.section.replace(/'/g,"\\'")}','${p.empno}')">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:#000147;">
                ${p.ln.charAt(0).toUpperCase()}
            </div>
            <div class="min-w-0">
                <p class="font-medium truncate">${p.ln}, ${p.fn}</p>
                <p class="text-xs text-gray-400">${p.empno || 'Professor'}</p>
            </div>
        </div>`).join('');
    dd.classList.remove('hidden');
}

function selectProfessor(id, ln, fn, mn, section, empno) {
    // Fill search box to confirm selection
    document.getElementById('professorSearch').value = ln + ', ' + fn;
    document.getElementById('professorDropdown').classList.add('hidden');
    const errEl = document.getElementById('professorError');
    if (errEl) errEl.classList.add('hidden');

    // Fill read-only info fields (same as student RFID fill)
    document.getElementById('infoStudentNo').textContent = empno || '—';
    document.getElementById('infoLastName').textContent  = ln || '—';
    document.getElementById('infoFirstName').textContent = fn || '—';
    document.getElementById('infoMI').textContent        = mn ? mn[0] + '.' : '—';
    document.getElementById('infoSection').textContent   = section || '—';
    document.getElementById('infoAdviser').textContent   = empno || '—';
    document.getElementById('borrowUserId').value        = id;

    showSlipFields(true);
    const btn = document.getElementById('borrowSubmitBtn');
    btn.disabled = false;
    btn.classList.remove('opacity-50', 'cursor-not-allowed');
}

// Close professor dropdown on outside click
document.addEventListener('click', function(e) {
    if (!e.target.closest('#professorSelectArea')) {
        document.getElementById('professorDropdown')?.classList.add('hidden');
    }
});

// ── Real-time: reload page on any book transaction event ─────────────────
libraryConnection.on('BookTransactionUpdated', function() {
    location.reload();
});
libraryConnection.on('NewReservation', function() {
    location.reload();
});

// ── Book live search ──────────────────────────────────────────────────────
//
// All available books are embedded here as a JSON array once when the page
// loads. The librarian types in the search box and the list filters instantly
// — no extra server call needed.

// Embed the server's book list as a JS array (Razor runs this at page load)
const allBooks = @Json.Serialize(
    ViewBag.AvailableBooks != null
        ? ((List<BookHiveLibrary.Models.Book>)ViewBag.AvailableBooks).Select(b => new {
              id            = b.Id,
              title         = b.Title,
              author        = b.Author,
              isbn          = b.ISBN,
              category      = b.Category,
              qty           = b.AvailableQuantity,
              aisleLocation = b.AisleLocation,
              callNumber    = b.CallNumber
          })
        : Enumerable.Empty<object>()
);

// filterBooks() — called whenever the search input or category changes
function filterBooks() {
    const query    = (document.getElementById('bookSearchInput').value || '').toLowerCase().trim();
    const category = (document.getElementById('bookCategoryFilter').value || '').toLowerCase();
    const listEl   = document.getElementById('bookResultsList');

    // If nothing typed yet, show a prompt
    if (!query && !category) {
        listEl.innerHTML = '<p class="text-xs text-gray-400 text-center py-6">Type to search for a book</p>';
        return;
    }

    // Filter the embedded book list by query and/or category
    const results = allBooks.filter(b => {
        const matchesQuery = !query
            || (b.title  || '').toLowerCase().includes(query)
            || (b.author || '').toLowerCase().includes(query)
            || (b.isbn   || '').toLowerCase().includes(query);

        const matchesCategory = !category
            || (b.category || '').toLowerCase() === category;

        return matchesQuery && matchesCategory;
    }).slice(0, 20); // Show at most 20 results at a time

    if (results.length === 0) {
        listEl.innerHTML = '<p class="text-xs text-gray-400 text-center py-6">No matching books found</p>';
        return;
    }

    // Build a clickable row for each matching book
    // Note: JSON.stringify produces double-quoted strings; use &quot; so they
    // don't break the onclick HTML attribute.
    function _q(s) { return JSON.stringify(s).replace(/"/g, '&quot;'); }
    listEl.innerHTML = results.map(b => `
        <div class="flex items-center gap-3 px-3 py-2.5 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-0 transition"
             onclick="selectBook(${b.id}, ${_q(b.title)}, ${_q(b.author)}, ${b.qty}, ${_q(b.aisleLocation||'')}, ${_q(b.callNumber||'')})">
            <div class="w-8 h-8 rounded-md flex-shrink-0 flex items-center justify-center text-white text-xs font-bold" style="background:#000147;">
                ${(b.title || '?')[0].toUpperCase()}
            </div>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-gray-800 truncate">${b.title || '—'}</p>
                <p class="text-xs text-gray-400 truncate">${b.author || '—'} • ${b.category || '—'}</p>
            </div>
            <span class="flex-shrink-0 text-xs ${b.qty > 0 ? 'text-green-600' : 'text-red-400'} font-medium">
                ${b.qty > 0 ? b.qty + ' avail.' : 'none'}
            </span>
        </div>
    `).join('');
}

// selectBook() — called when the librarian clicks a result row
function selectBook(id, title, author, qty, aisleLocation, callNumber) {
    // Store the selected book ID in the hidden input (this is what the form submits)
    document.getElementById('borrowBookSelect').value = id;

    // Fill Book Title field and highlight it to show selection
    const titleEl = document.getElementById('selectedBookTitle');
    titleEl.textContent = title || '';
    titleEl.classList.add('text-gray-900');

    // Build Book Information: Author then Location on separate lines
    const lines = [];
    if (author)       lines.push('Author: ' + author);
    if (aisleLocation) lines.push('Location: ' + aisleLocation);
    if (callNumber)    lines.push('Call No.: ' + callNumber);

    const infoEl = document.getElementById('selectedBookAuthor');
    infoEl.style.whiteSpace = 'pre-line';
    infoEl.textContent = lines.join('\n');

    // Show a check in the results list so the librarian knows it's locked in
    document.getElementById('bookSearchInput').value    = '';
    document.getElementById('bookCategoryFilter').value = '';
    document.getElementById('bookResultsList').innerHTML =
        '<div class="flex items-center justify-center gap-1.5 py-5 text-xs text-green-600 font-medium">' +
        '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>' +
        'Book selected — search again to change</div>';

    // Enable Confirm Borrow
    const btn = document.getElementById('borrowSubmitBtn');
    if (btn) { btn.disabled = false; btn.classList.remove('opacity-50', 'cursor-not-allowed'); }
}

// clearBookSelection() — resets book fields to empty (called on modal reset)
function clearBookSelection() {
    document.getElementById('borrowBookSelect').value = '';

    const titleEl = document.getElementById('selectedBookTitle');
    titleEl.textContent = '';
    titleEl.classList.remove('text-gray-900');

    const infoEl = document.getElementById('selectedBookAuthor');
    infoEl.style.whiteSpace = '';
    infoEl.textContent = '';

    document.getElementById('bookSearchInput').value    = '';
    document.getElementById('bookCategoryFilter').value = '';
    document.getElementById('bookResultsList').innerHTML =
        '<p class="text-xs text-gray-400 text-center py-6">Type to search for a book</p>';
}
</script>
}

