// ── Book live search ──────────────────────────────────────────────────────
//
// All available books are embedded here as a JSON array once when the page
// loads. The librarian types in the search box and the list filters instantly
// — no extra server call needed.

// Embed the server's book list as a JS array (Razor runs this at page load)
const allBooks = @Json.Serialize(
    ViewBag.AvailableBooks != null
        ? ((List<BookHiveLibrary.Models.Book>)ViewBag.AvailableBooks).Select(b => new {
              id            = b.Id,
              title         = b.Title,
              author        = b.Author,
              isbn          = b.ISBN,
              category      = b.Category,
              qty           = b.AvailableQuantity,
              aisleLocation = b.AisleLocation,
              callNumber    = b.CallNumber
          })
        : Enumerable.Empty<object>()
);

// filterBooks() — called whenever the search input or category changes
function filterBooks() {
    const query    = (document.getElementById('bookSearchInput').value || '').toLowerCase().trim();
    const category = (document.getElementById('bookCategoryFilter').value || '').toLowerCase();
    const listEl   = document.getElementById('bookResultsList');

    // If nothing typed yet, show a prompt
    if (!query && !category) {
        listEl.innerHTML = '<p class="text-xs text-gray-400 text-center py-6">Type to search for a book</p>';
        return;
    }

    // Filter the embedded book list by query and/or category
    const results = allBooks.filter(b => {
        const matchesQuery = !query
            || (b.title  || '').toLowerCase().includes(query)
            || (b.author || '').toLowerCase().includes(query)
            || (b.isbn   || '').toLowerCase().includes(query);

        const matchesCategory = !category
            || (b.category || '').toLowerCase() === category;

        return matchesQuery && matchesCategory;
    }).slice(0, 20); // Show at most 20 results at a time

    if (results.length === 0) {
        listEl.innerHTML = '<p class="text-xs text-gray-400 text-center py-6">No matching books found</p>';
        return;
    }

    // Build a clickable row for each matching book
    // Note: JSON.stringify produces double-quoted strings; use &quot; so they
    // don't break the onclick HTML attribute.
    function _q(s) { return JSON.stringify(s).replace(/"/g, '&quot;'); }
    listEl.innerHTML = results.map(b => `
        <div class="flex items-center gap-3 px-3 py-2.5 hover:bg-blue-50 cursor-pointer border-b border-gray-100 last:border-0 transition"
             onclick="selectBook(${b.id}, ${_q(b.title)}, ${_q(b.author)}, ${b.qty}, ${_q(b.aisleLocation||'')}, ${_q(b.callNumber||'')})">
            <div class="w-8 h-8 rounded-md flex-shrink-0 flex items-center justify-center text-white text-xs font-bold" style="background:#000147;">
                ${(b.title || '?')[0].toUpperCase()}
            </div>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-gray-800 truncate">${b.title || '—'}</p>
                <p class="text-xs text-gray-400 truncate">${b.author || '—'} • ${b.category || '—'}</p>
            </div>
            <span class="flex-shrink-0 text-xs ${b.qty > 0 ? 'text-green-600' : 'text-red-400'} font-medium">
                ${b.qty > 0 ? b.qty + ' avail.' : 'none'}
            </span>
        </div>
    `).join('');
}

// selectBook() — called when the librarian clicks a result row
function selectBook(id, title, author, qty, aisleLocation, callNumber) {
    // Store the selected book ID in the hidden input (this is what the form submits)
    document.getElementById('borrowBookSelect').value = id;

    // Fill Book Title field and highlight it to show selection
    const titleEl = document.getElementById('selectedBookTitle');
    titleEl.textContent = title || '';
    titleEl.classList.add('text-gray-900');

    // Build Book Information: Author then Location on separate lines
    const lines = [];
    if (author)       lines.push('Author: ' + author);
    if (aisleLocation) lines.push('Location: ' + aisleLocation);
    if (callNumber)    lines.push('Call No.: ' + callNumber);

    const infoEl = document.getElementById('selectedBookAuthor');
    infoEl.style.whiteSpace = 'pre-line';
    infoEl.textContent = lines.join('\n');

    // Show a check in the results list so the librarian knows it's locked in
    document.getElementById('bookSearchInput').value    = '';
    document.getElementById('bookCategoryFilter').value = '';
    document.getElementById('bookResultsList').innerHTML =
        '<div class="flex items-center justify-center gap-1.5 py-5 text-xs text-green-600 font-medium">' +
        '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>' +
        'Book selected — search again to change</div>';

    // Enable Confirm Borrow
    const btn = document.getElementById('borrowSubmitBtn');
    if (btn) { btn.disabled = false; btn.classList.remove('opacity-50', 'cursor-not-allowed'); }
}

// clearBookSelection() — resets book fields to empty (called on modal reset)
function clearBookSelection() {
    document.getElementById('borrowBookSelect').value = '';

    const titleEl = document.getElementById('selectedBookTitle');
    titleEl.textContent = '';
    titleEl.classList.remove('text-gray-900');

    const infoEl = document.getElementById('selectedBookAuthor');
    infoEl.style.whiteSpace = '';
    infoEl.textContent = '';

    document.getElementById('bookSearchInput').value    = '';
    document.getElementById('bookCategoryFilter').value = '';
    document.getElementById('bookResultsList').innerHTML =
        '<p class="text-xs text-gray-400 text-center py-6">Type to search for a book</p>';
}
</script>
