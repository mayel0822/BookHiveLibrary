@model BookHiveLibrary.Models.ApplicationUser
@{
    ViewData["Title"] = "Computer Vacancy";
    var userName = (!string.IsNullOrWhiteSpace(Model?.FirstName) || !string.IsNullOrWhiteSpace(Model?.LastName))
        ? $"{Model.FirstName} {Model.LastName}".Trim()
        : Model?.UserName ?? "User";
    var computers = (List<BookHiveLibrary.Models.ComputerUnit>)(ViewBag.Computers ?? new List<BookHiveLibrary.Models.ComputerUnit>());
    var availableCount = (int)(ViewBag.AvailableCount ?? 0);
    var occupiedCount = (int)(ViewBag.OccupiedCount ?? 0);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Computer Vacancy – BookHive</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap" rel="stylesheet" />
    <style>
        @@keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.6;transform:scale(1.3)} }
        .pulse { animation: pulse-dot 1.8s ease-in-out infinite; }
    </style>
</head>
<body class="bg-[#dce6f5]">

<div id="sidebar-backdrop" class="fixed inset-0 bg-black/40 z-40 hidden" onclick="toggleSidebar()"></div>

<div class="flex h-screen bg-[#dce6f5]">

    <!-- Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-56 bg-[#000147] text-white flex flex-col py-8 px-5 flex-shrink-0 shadow-xl -translate-x-full lg:translate-x-0 lg:relative transition-transform duration-300">
        <div class="mb-10 flex items-center justify-between">
            <a href="@Url.Action("Dashboard","Student")" class="flex items-center justify-center w-full">
                <span style="font-family:'Dancing Script',cursive;font-size:2rem;font-weight:800;color:white;line-height:1;display:block;text-align:center;">BookHive</span>
            </a>
            <button onclick="toggleSidebar()" class="lg:hidden text-white/60 hover:text-white transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <nav class="space-y-1 flex-1">
            <a href="@Url.Action("Dashboard","Student")" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-blue-200 hover:bg-white/10 hover:text-white transition-all duration-200">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/></svg>
                Home
            </a>
            <a href="@Url.Action("BookViewing","Student")" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-blue-200 hover:bg-white/10 hover:text-white transition-all duration-200">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>
                Book Viewing
            </a>
            <a href="@Url.Action("ComputerVacancy","Student")" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold bg-white/20 text-white ring-1 ring-white/10">
                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd"/></svg>
                Computer Vacancy
            </a>
        </nav>
    </aside>

    <!-- Main -->
    <main class="flex-1 flex flex-col overflow-hidden">

        <!-- Header -->
        <header class="bg-white border-b border-gray-200 flex items-center justify-between px-6 py-3 shadow-sm flex-shrink-0">
            <div class="flex items-center gap-3">
                <button onclick="toggleSidebar()" class="lg:hidden text-gray-500 hover:text-gray-700 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div class="mt-1">
                    <h2 class="text-base font-semibold text-gray-800">Computer Vacancy</h2>
                    <p class="text-xs text-gray-400 hidden sm:block">Student Portal — STI San Jose Del Monte</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <!-- Messages -->
                <a href="/Message/Index" class="relative flex items-center text-gray-500 hover:text-gray-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </a>
                <!-- Notification Bell -->
                <div id="notification-wrapper" class="relative flex items-center">
                    <button onclick="toggleDropdown('notification-dropdown')" class="relative text-gray-500 hover:text-gray-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                    </button>
                    <div id="notification-dropdown" class="hidden absolute right-0 top-full mt-2 w-72 bg-white rounded-2xl shadow-xl border border-gray-100 z-50 overflow-hidden">
                        <div class="px-4 py-3 border-b border-gray-100"><h3 class="text-sm font-bold text-gray-900">Notifications</h3></div>
                        <div class="px-4 py-6 text-center text-xs text-gray-400">No new notifications</div>
                    </div>
                </div>
                <!-- Profile -->
                <div class="relative" id="profile-wrapper">
                    <button onclick="toggleProfileDrop()" class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 focus:outline-none transition">
                        <span class="text-sm font-medium text-gray-700 hidden sm:inline">@(!string.IsNullOrWhiteSpace(Model?.FirstName) ? Model.FirstName : Model?.UserName)</span>
                        <div class="w-7 h-7 rounded-full overflow-hidden flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background-color:#000147;">
                            @if (!string.IsNullOrEmpty(Model?.ProfilePicture))
                            {
                                <img src="@Model.ProfilePicture" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                @(userName.Length > 0 ? userName[0].ToString().ToUpper() : "S")
                            }
                        </div>
                    </button>
                    <div id="profile-drop" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border border-gray-200 z-50 overflow-hidden">
                        <div class="px-4 py-4 border-b border-gray-100 flex items-center gap-3">
                            <div class="w-12 h-12 rounded-full overflow-hidden flex items-center justify-center text-white text-lg font-bold flex-shrink-0" style="background-color:#000147;">
                                @if (!string.IsNullOrEmpty(Model?.ProfilePicture))
                                {
                                    <img src="@Model.ProfilePicture" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    @(userName.Length > 0 ? userName[0].ToString().ToUpper() : "S")
                                }
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-gray-900 truncate">@userName</p>
                                <p class="text-xs text-gray-400 truncate">@Model?.Email</p>
                                <span class="text-[10px] bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-semibold mt-1 inline-block">@(Model?.UserType ?? "Student")</span>
                            </div>
                        </div>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="px-2 py-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 hover:bg-red-50 rounded-lg transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="flex-1 overflow-y-auto px-4 sm:px-8 pb-8">
            <div class="bg-white rounded-2xl p-4 sm:p-6 shadow-sm">

                <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
                    <h2 class="text-lg font-bold text-gray-900">Lab Overview</h2>
                    <div class="flex items-center gap-4 text-sm">
                        <span class="flex items-center gap-1.5 text-emerald-600 font-semibold">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
                            @availableCount Available
                        </span>
                        <span class="flex items-center gap-1.5 text-red-500 font-semibold">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-400 inline-block"></span>
                            @occupiedCount Occupied
                        </span>
                    </div>
                </div>

                @if (computers.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var pc in computers)
                        {
                            var cardBg   = pc.IsAvailable ? "bg-[#b0c4d8]" : "bg-[#b0bec5]";
                            var dotColor = pc.IsAvailable ? "bg-emerald-400" : "bg-red-400";
                            var pulse    = pc.IsAvailable ? "pulse" : "";
                            var badge    = pc.IsAvailable ? "bg-emerald-500 text-white" : "bg-red-400 text-white";
                            var label    = pc.IsAvailable ? "Available" : "Not Available";
                            <div class="@cardBg rounded-2xl p-5 relative hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 cursor-default">
                                <span class="absolute top-4 right-4 w-3 h-3 rounded-full @dotColor @pulse block"></span>
                                <div class="mb-3 text-gray-400">
                                    <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M21 2H3a2 2 0 00-2 2v12a2 2 0 002 2h7l-2 3v1h8v-1l-2-3h7a2 2 0 002-2V4a2 2 0 00-2-2zm0 14H3V4h18v12z"/></svg>
                                </div>
                                <p class="text-2xl font-extrabold text-gray-900 mb-3 tracking-tight">@pc.ComputerNumber</p>
                                <span class="inline-block @badge text-xs font-semibold px-3 py-1 rounded-full">@label</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-16 text-gray-400">
                        <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="currentColor" viewBox="0 0 24 24"><path d="M21 2H3a2 2 0 00-2 2v12a2 2 0 002 2h7l-2 3v1h8v-1l-2-3h7a2 2 0 002-2V4a2 2 0 00-2-2zm0 14H3V4h18v12z"/></svg>
                        <p class="text-sm font-medium">No computers registered yet.</p>
                    </div>
                }

            </div>
        </div>
    </main>
</div>

<script>
    function toggleSidebar() {
        const s = document.getElementById('sidebar'), b = document.getElementById('sidebar-backdrop');
        const open = !s.classList.contains('-translate-x-full');
        s.classList.toggle('-translate-x-full', open); b.classList.toggle('hidden', open);
    }
    function toggleDropdown(id) {
        ['notification-dropdown','message-dropdown'].forEach(t => {
            const el = document.getElementById(t);
            if (el) el.classList[t === id ? 'toggle' : 'add']('hidden');
        });
    }
    function toggleProfileDrop() { document.getElementById('profile-drop').classList.toggle('hidden'); }
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#notification-wrapper')) document.getElementById('notification-dropdown')?.classList.add('hidden');
        if (!e.target.closest('#message-wrapper')) document.getElementById('message-dropdown')?.classList.add('hidden');
        if (!e.target.closest('#profile-wrapper')) document.getElementById('profile-drop')?.classList.add('hidden');
    });
</script>
</body>
</html>
