@model BookHiveLibrary.ViewModels.BookFormViewModel
@{
    Layout = "~/Views/Shared/_LibrarianLayout.cshtml";
    ViewData["Title"] = "Edit Book";
}

<div class="w-full bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <h2 class="text-lg font-semibold text-gray-700 mb-6">Edit Book</h2>

    <form method="post" asp-action="Edit" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <!-- Keep existing cover URL so the controller can preserve it if no new file is uploaded -->
        <input type="hidden" asp-for="CoverImageUrl" />
        <!-- "All" (not "ModelOnly") — property-specific errors like the duplicate-
             title check and the Call No./ISBN/Published Year/Title/Author/Description
             format rules were being silently swallowed here: ModelOnly only shows
             errors NOT tied to a specific field, and this page didn't have a
             asp-validation-for span for every field that can now fail. -->
        <div asp-validation-summary="All" class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-600 text-sm"></div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Cover Image -->
            <div class="flex flex-col items-center gap-4">
                <!-- Clickable preview — opens file picker -->
                <div id="coverPreview"
                     onclick="document.getElementById('coverImageFile').click()"
                     class="w-48 h-64 bg-gray-100 rounded-lg border-2 border-dashed border-gray-300 flex items-center justify-center overflow-hidden cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition relative">
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img id="coverImg" src="@Model.CoverImageUrl" class="w-full h-full object-cover" alt="Cover" />
                    }
                    else
                    {
                        <img id="coverImg" src="" class="w-full h-full object-cover hidden" alt="Cover" />
                        <div id="coverPlaceholder" class="text-center text-gray-400 pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
                            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
                            <p class="text-xs font-medium">Click to upload cover</p>
                            <p class="text-[10px] mt-0.5 text-gray-300">JPG, PNG, WEBP</p>
                        </div>
                    }
                </div>
                <!-- Hidden file input -->
                <input type="file" id="coverImageFile" name="coverImageFile"
                       accept="image/*" class="hidden" onchange="onCoverChosen(this)" />
                <p id="coverFileName" class="text-xs text-gray-400 -mt-2 hidden"></p>
                <div class="w-full">
                    <label class="block text-sm font-medium text-gray-600 mb-1">Total Quantity</label>
                    <input type="number" asp-for="TotalQuantity" min="1"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"
                           style="appearance:auto; -webkit-appearance:auto;" />
                </div>
                <div class="w-full">
                    <label class="block text-sm font-medium text-gray-600 mb-1">Available Quantity</label>
                    <input type="number" value="@Model.AvailableQuantity" readonly
                           class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-gray-50 text-gray-400 cursor-not-allowed" />
                    <input type="hidden" asp-for="AvailableQuantity" />
                    <p class="text-xs text-gray-400 mt-1">Auto-calculated. Cannot be edited manually.</p>
                </div>
            </div>

            <!-- Fields -->
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Book Title</label>
                    <input type="text" asp-for="Title" required
                           oninput="checkLettersRequired(this, 'titleWarning', 'Book Title')"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                    <span asp-validation-for="Title" class="text-red-500 text-xs"></span>
                    <p id="titleWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Author</label>
                    <input type="text" asp-for="Author" required
                           oninput="checkLettersRequired(this, 'authorWarning', 'Author')"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                    <span asp-validation-for="Author" class="text-red-500 text-xs"></span>
                    <p id="authorWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">Call No.</label>
                        <input type="text" asp-for="CallNumber" required inputmode="numeric" maxlength="20"
                               oninput="checkNumbersOnly(this, 'callNoWarning', 'Call No.', /[^0-9]/g)"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                        <span asp-validation-for="CallNumber" class="text-red-500 text-xs"></span>
                        <p id="callNoWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">ISBN</label>
                        <input type="text" asp-for="ISBN" placeholder="e.g. 978-3-16-148410-0" inputmode="numeric" maxlength="17"
                               oninput="checkNumbersOnly(this, 'isbnWarning', 'ISBN', /[^0-9\-]/g, 'numbers and hyphens (-)')"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                        <span asp-validation-for="ISBN" class="text-red-500 text-xs"></span>
                        <p id="isbnWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">Published Year</label>
                        <input type="text" asp-for="PublishedYear" placeholder="e.g. 2023" inputmode="numeric" maxlength="4"
                               oninput="checkNumbersOnly(this, 'yearWarning', 'Published Year', /[^0-9]/g)"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                        <span asp-validation-for="PublishedYear" class="text-red-500 text-xs"></span>
                        <p id="yearWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">Category</label>
                        <select asp-for="Category" required
                                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                            <option value="">Select category...</option>
                            <optgroup label="Junior High School">
                                <option>Mathematics</option><option>Science</option><option>English</option>
                                <option>Filipino</option><option>Araling Panlipunan</option><option>MAPEH</option>
                                <option>TLE</option><option>EsP</option><option>Mother Tongue</option><option>Research</option>
                            </optgroup>
                            <optgroup label="Senior High School">
                                <option>General Mathematics</option><option>Statistics & Probability</option>
                                <option>Earth and Life Science</option><option>Physical Science</option>
                                <option>Reading and Writing</option><option>21st Century Literature</option>
                                <option>Oral Communication</option><option>Media and Information Literacy</option>
                                <option>Personal Development</option><option>Understanding Culture & Society</option>
                                <option>Introduction to Philosophy</option><option>Komunikasyon at Pananaliksik</option>
                                <option>Practical Research</option><option>Entrepreneurship</option><option>Work Immersion</option>
                            </optgroup>
                            <optgroup label="Tertiary / College">
                                <option>Computer Science & IT</option><option>Information Technology</option>
                                <option>Programming & Software Dev.</option><option>Computer Engineering</option>
                                <option>Engineering</option><option>Business Administration</option>
                                <option>Accounting & Finance</option><option>Marketing</option>
                                <option>Tourism Management</option><option>Hospitality Management</option>
                                <option>Culinary Arts</option><option>Psychology</option>
                                <option>Communication</option><option>Education</option>
                                <option>Social Sciences</option><option>Natural Science</option>
                                <option>Law</option><option>Criminology</option>
                                <option>Reference</option><option>General</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-1">Aisle</label>
                            <select id="aisleSelect" onchange="syncLocation()"
                                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                                <option value="">Aisle...</option>
                                @foreach (var c in Enumerable.Range(0, 10).Select(i => ((char)('A' + i)).ToString()))
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-1">Shelf</label>
                            <select id="shelfSelect" onchange="syncLocation()"
                                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                                <option value="">Shelf...</option>
                                @foreach (var n in Enumerable.Range(1, 6))
                                {
                                    <option value="@n">@n</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <input type="hidden" asp-for="AisleLocation" id="aisleLocationHidden" />
                <!-- BookFor driven by Professor Only checkbox; hidden input carries the value -->
                <input type="hidden" asp-for="BookFor" id="bookForHidden" />
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Grade Level</label>
                    <select asp-for="GradeLevel"
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                        <option value="">Select level...</option>
                        <option value="Junior High School">Junior High School (Grade 7–10)</option>
                        <option value="Senior High School">Senior High School (Grade 11–12)</option>
                        <option value="Tertiary">Tertiary / College</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Book Synopsis</label>
                    <textarea asp-for="Description" rows="4"
                              oninput="checkLettersRequired(this, 'descriptionWarning', 'Book Synopsis', true)"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 resize-none"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-xs"></span>
                    <p id="descriptionWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                </div>
                <div class="flex items-center gap-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                    <input type="checkbox" id="professorOnly" class="w-4 h-4 accent-blue-700"
                           onchange="document.getElementById('bookForHidden').value = this.checked ? 'Professor' : 'Student'" />
                    <label for="professorOnly" class="text-sm font-medium text-blue-800 cursor-pointer">
                        Professor Only <span class="text-blue-600 font-normal">(students cannot reserve this book)</span>
                    </label>
                </div>
                <div class="flex items-center gap-3 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                    <input type="checkbox" asp-for="IsRoomUseOnly" id="roomUseOnly" class="w-4 h-4 accent-amber-600" />
                    <label for="roomUseOnly" class="text-sm font-medium text-amber-800 cursor-pointer">
                        Room Use Only <span class="text-amber-600 font-normal">(cannot be borrowed outside the library)</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="flex gap-3 mt-6 justify-end">
            <button type="submit" class="px-6 py-2 text-white rounded-lg text-sm font-medium" style="background-color:#000147;">Save Changes</button>
            <a href="@Url.Action("Index","Book")" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
// Live warnings for fields with a RegularExpression rule on the server side,
// so the librarian sees why their input will be rejected before they submit
// instead of only finding out from the summary at the top of the page.
function checkLettersRequired(input, warningId, fieldLabel, optional) {
    const el = document.getElementById(warningId);
    if (!el) return;
    const value = input.value;
    const isEmpty = value.trim().length === 0;
    const hasLetter = /[A-Za-z]/.test(value);
    if (!isEmpty && !hasLetter) {
        el.textContent = fieldLabel + ' must include letters or words — numbers alone are not allowed.';
        el.classList.remove('hidden');
    } else {
        el.classList.add('hidden');
    }
}

function checkNumbersOnly(input, warningId, fieldLabel, stripPattern, allowedDescription) {
    const el = document.getElementById(warningId);
    const before = input.value;
    input.value = before.replace(stripPattern, '');
    if (!el) return;
    if (before !== input.value) {
        el.textContent = fieldLabel + ' can only contain ' + (allowedDescription || 'numbers') + '.';
        el.classList.remove('hidden');
    } else {
        el.classList.add('hidden');
    }
}

// Pre-check Professor Only checkbox based on saved BookFor value
(function() {
    const hidden = document.getElementById('bookForHidden');
    const cb = document.getElementById('professorOnly');
    if (hidden && cb && hidden.value === 'Professor') cb.checked = true;
})();

function syncLocation() {
    const aisle = document.getElementById('aisleSelect').value;
    const shelf = document.getElementById('shelfSelect').value;
    document.getElementById('aisleLocationHidden').value = (aisle && shelf) ? aisle + '-' + shelf : (aisle || shelf || '');
}

function onCoverChosen(input) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];
    const reader = new FileReader();
    reader.onload = function(e) {
        const img = document.getElementById('coverImg');
        img.src = e.target.result;
        img.classList.remove('hidden');
        const ph = document.getElementById('coverPlaceholder');
        if (ph) ph.classList.add('hidden');
        const nameEl = document.getElementById('coverFileName');
        nameEl.textContent = file.name;
        nameEl.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
}

// Pre-select aisle/shelf from saved value e.g. "B-5"
(function() {
    const saved = '@Model.AisleLocation';
    if (!saved) return;
    const parts = saved.split('-');
    const aisle = parts[0]?.trim();
    const shelf = parts[1]?.trim();
    if (aisle) document.getElementById('aisleSelect').value = aisle;
    if (shelf) document.getElementById('shelfSelect').value = shelf;
})();

</script>
}
