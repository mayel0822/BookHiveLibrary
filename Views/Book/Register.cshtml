@model BookHiveLibrary.ViewModels.BookFormViewModel
@{
    Layout = "~/Views/Shared/_LibrarianLayout.cshtml";
    ViewData["Title"] = "Book Registration";
}

<!-- Stats Row -->
<div class="grid grid-cols-4 gap-4 mb-6">
    <div class="rounded-xl p-4 text-white" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Total Books</p>
        <p class="text-3xl font-bold text-center">@ViewBag.TotalBooks</p>
    </div>
    <div class="rounded-xl p-4 text-white" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Available</p>
        <p class="text-3xl font-bold text-center">@ViewBag.AvailableBooks</p>
    </div>
    <div class="rounded-xl p-4 text-white" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Borrowed</p>
        <p class="text-3xl font-bold text-center">@ViewBag.BorrowedBooks</p>
    </div>
    <div class="rounded-xl p-4 text-white" style="background-color:#000147;">
        <p class="text-xs text-blue-200 mb-1">Archive</p>
        <p class="text-3xl font-bold text-center">@ViewBag.ArchivedBooks</p>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-800">@(Model.Id == 0 ? "Register New Book" : "Edit Book")</h2>
        <button type="button" onclick="document.getElementById('importModal').classList.remove('hidden')"
                class="px-4 py-2 text-sm text-white rounded-lg font-medium flex items-center gap-2" style="background:#000147;">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
            Import Excel
        </button>
    </div>

    <!-- Import Excel Modal -->
    <div id="importModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl mx-4 overflow-hidden">
            <div class="px-6 py-4 flex items-center justify-between border-b border-gray-100">
                <h3 class="text-base font-semibold text-gray-800">Import from Excel</h3>
                <button type="button" onclick="closeImportModal()" class="text-gray-400 hover:text-gray-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="px-6 py-5">
                <form id="importForm" method="post" action="@Url.Action("ImportExcel","Book")" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div id="dropZone"
                         ondragover="event.preventDefault(); this.classList.add('border-blue-400','bg-blue-50')"
                         ondragleave="this.classList.remove('border-blue-400','bg-blue-50')"
                         ondrop="handleDrop(event)"
                         onclick="document.getElementById('excelFileInput').click()"
                         class="border-2 border-dashed border-gray-300 rounded-xl p-10 flex flex-col items-center justify-center gap-2 cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition">
                        <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                        <p class="text-sm text-gray-500">Drag &amp; drop your Excel file here or</p>
                        <span class="text-sm font-medium text-blue-600 hover:underline">Browse file</span>
                        <p id="selectedFileName" class="text-xs text-gray-400 mt-1">No file selected</p>
                        <input type="file" id="excelFileInput" name="file" accept=".xlsx" class="hidden"
                               onchange="document.getElementById('selectedFileName').textContent = this.files[0]?.name ?? 'No file selected'" />
                    </div>
                </form>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex gap-3 justify-end">
                <button type="button" onclick="closeImportModal()" class="px-5 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200">Cancel</button>
                <button type="button" onclick="submitImport()" class="px-5 py-2 text-white rounded-lg text-sm font-medium" style="background:#000147;">Import Books</button>
            </div>
        </div>
    </div>

    <form method="post" asp-action="Register" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-600 text-sm"></div>
        }

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <!-- Cover Image Preview -->
            <div class="flex flex-col items-center gap-4">
                <!-- Clickable preview area — opens file picker -->
                <div id="coverPreview"
                     onclick="document.getElementById('coverImageFile').click()"
                     class="w-40 h-56 bg-gray-100 rounded-lg border-2 border-dashed border-gray-300 flex items-center justify-center overflow-hidden cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition flex-shrink-0">
                    <div id="coverPlaceholder" class="text-center text-gray-400 pointer-events-none px-3">
                        <svg class="w-10 h-10 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
                        <p class="text-xs font-medium">Click to upload cover</p>
                        <p class="text-[10px] mt-0.5 text-gray-300">JPG, PNG, WEBP</p>
                    </div>
                    <img id="coverImg" src="" class="w-full h-full object-cover hidden" alt="Cover" />
                </div>
                <!-- Hidden file input -->
                <input type="file" id="coverImageFile" name="coverImageFile"
                       accept="image/*" class="hidden" onchange="onCoverChosen(this)" />
                <p id="coverFileName" class="text-xs text-gray-400 -mt-2 text-center hidden"></p>

                <!-- Total Quantity — stepper with − / + buttons -->
                <div class="w-full">
                    <label class="block text-sm font-medium text-gray-600 mb-1">Total Quantity</label>
                    <div class="flex items-center border border-gray-300 rounded-lg overflow-hidden w-full">
                        <button type="button" onclick="stepQty(-1)"
                                class="px-4 py-2 text-lg font-bold text-gray-600 hover:bg-gray-100 transition select-none flex-shrink-0">−</button>
                        <input type="number" asp-for="TotalQuantity" id="qtyInput" min="1"
                               class="flex-1 text-center text-sm font-medium text-gray-800 focus:outline-none border-0 py-2"
                               style="-webkit-appearance:none; -moz-appearance:textfield; appearance:textfield;" />
                        <button type="button" onclick="stepQty(1)"
                                class="px-4 py-2 text-lg font-bold text-gray-600 hover:bg-gray-100 transition select-none flex-shrink-0">+</button>
                    </div>
                </div>
                <input type="hidden" asp-for="AvailableQuantity" id="availableQtyInput" />
            </div>

            <!-- Book Fields -->
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Book Title</label>
                    <input type="text" asp-for="Title" required
                           oninput="checkLettersRequired(this, 'titleWarning', 'Book Title')"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                    <span asp-validation-for="Title" class="text-red-500 text-xs"></span>
                    <p id="titleWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Author</label>
                    <input type="text" asp-for="Author" required
                           oninput="checkLettersRequired(this, 'authorWarning', 'Author')"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                    <span asp-validation-for="Author" class="text-red-500 text-xs"></span>
                    <p id="authorWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">Call No.</label>
                        <input type="text" asp-for="CallNumber" required inputmode="numeric" maxlength="20"
                               oninput="checkNumbersOnly(this, 'callNoWarning', 'Call No.', /[^0-9]/g)"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                        <span asp-validation-for="CallNumber" class="text-red-500 text-xs"></span>
                        <p id="callNoWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">ISBN</label>
                        <input type="text" asp-for="ISBN" placeholder="e.g. 978-3-16-148410-0" inputmode="numeric" maxlength="17"
                               oninput="checkNumbersOnly(this, 'isbnWarning', 'ISBN', /[^0-9\-]/g, 'numbers and hyphens (-)')"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                        <span asp-validation-for="ISBN" class="text-red-500 text-xs"></span>
                        <p id="isbnWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">Published Year</label>
                        <input type="text" asp-for="PublishedYear" placeholder="e.g. 2023" inputmode="numeric" maxlength="4"
                               oninput="checkNumbersOnly(this, 'yearWarning', 'Published Year', /[^0-9]/g)"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" />
                        <span asp-validation-for="PublishedYear" class="text-red-500 text-xs"></span>
                        <p id="yearWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                    </div>
                </div>
                <!-- BookFor is driven by the Professor Only checkbox below; default = Student -->
                <input type="hidden" asp-for="BookFor" id="bookForHidden" value="Student" />
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Grade Level</label>
                    <select asp-for="GradeLevel"
                            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                        <option value="">Select level...</option>
                        <option value="Junior High School">Junior High School (Grade 7–10)</option>
                        <option value="Senior High School">Senior High School (Grade 11–12)</option>
                        <option value="Tertiary">Tertiary / College</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1">Category</label>
                        <select asp-for="Category" id="categorySelect" required onchange="onCategoryChange()"
                                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                            <option value="">Select category...</option>
                            <optgroup label="Junior High School">
                                <option>Mathematics</option><option>Science</option><option>English</option>
                                <option>Filipino</option><option>Araling Panlipunan</option><option>MAPEH</option>
                                <option>TLE</option><option>EsP</option><option>Mother Tongue</option><option>Research</option>
                            </optgroup>
                            <optgroup label="Senior High School">
                                <option>General Mathematics</option><option>Statistics & Probability</option>
                                <option>Earth and Life Science</option><option>Physical Science</option>
                                <option>Reading and Writing</option><option>21st Century Literature</option>
                                <option>Oral Communication</option><option>Media and Information Literacy</option>
                                <option>Personal Development</option><option>Understanding Culture & Society</option>
                                <option>Introduction to Philosophy</option><option>Komunikasyon at Pananaliksik</option>
                                <option>Practical Research</option><option>Entrepreneurship</option><option>Work Immersion</option>
                            </optgroup>
                            <optgroup label="Tertiary / College">
                                <option>Computer Science & IT</option><option>Information Technology</option>
                                <option>Programming & Software Dev.</option><option>Computer Engineering</option>
                                <option>Engineering</option><option>Business Administration</option>
                                <option>Accounting & Finance</option><option>Marketing</option>
                                <option>Tourism Management</option><option>Hospitality Management</option>
                                <option>Culinary Arts</option><option>Psychology</option>
                                <option>Communication</option><option>Education</option>
                                <option>Social Sciences</option><option>Natural Science</option>
                                <option>Law</option><option>Criminology</option>
                                <option>Reference</option><option>General</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-1">Aisle</label>
                            <select id="aisleSelect" onchange="onLocationChange()"
                                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                                <option value="">Aisle...</option>
                                @foreach (var c in Enumerable.Range(0, 10).Select(i => ((char)('A' + i)).ToString()))
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-600 mb-1">Shelf</label>
                            <select id="shelfSelect" onchange="onLocationChange()"
                                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300">
                                <option value="">Shelf...</option>
                                @foreach (var n in Enumerable.Range(1, 6))
                                {
                                    <option value="@n">@n</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <input type="hidden" asp-for="AisleLocation" id="aisleLocationHidden" />
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Book Synopsis</label>
                    <textarea asp-for="Description" rows="4"
                              oninput="checkLettersRequired(this, 'descriptionWarning', 'Book Synopsis', true)"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 resize-none"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-xs"></span>
                    <p id="descriptionWarning" class="text-amber-600 text-xs mt-1 hidden"></p>
                </div>
                <div class="flex items-center gap-3 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                    <input type="checkbox" id="professorOnly" class="w-4 h-4 accent-blue-700"
                           onchange="document.getElementById('bookForHidden').value = this.checked ? 'Professor' : 'Student'" />
                    <label for="professorOnly" class="text-sm font-medium text-blue-800 cursor-pointer">
                        Professor Only <span class="text-blue-600 font-normal">(students cannot reserve this book)</span>
                    </label>
                </div>
                <div class="flex items-center gap-3 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                    <input type="checkbox" asp-for="IsRoomUseOnly" id="roomUseOnly" class="w-4 h-4 accent-amber-600" />
                    <label for="roomUseOnly" class="text-sm font-medium text-amber-800 cursor-pointer">
                        Room Use Only <span class="text-amber-600 font-normal">(cannot be borrowed outside the library)</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="flex gap-3 mt-6 justify-end">
            <a href="@Url.Action("Index","Book")" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200">Cancel</a>
            <button type="submit" class="px-6 py-2 text-white rounded-lg text-sm font-medium" style="background-color:#000147;">
                @(Model.Id == 0 ? "Register Book" : "Save Changes")
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
// Live warnings for fields with a RegularExpression rule on the server side,
// so the librarian sees why their input will be rejected before they submit
// instead of only finding out from the summary at the top of the page.
function checkLettersRequired(input, warningId, fieldLabel, optional) {
    const el = document.getElementById(warningId);
    if (!el) return;
    const value = input.value;
    const isEmpty = value.trim().length === 0;
    const hasLetter = /[A-Za-z]/.test(value);
    if (!isEmpty && !hasLetter) {
        el.textContent = fieldLabel + ' must include letters or words — numbers alone are not allowed.';
        el.classList.remove('hidden');
    } else {
        el.classList.add('hidden');
    }
}

function checkNumbersOnly(input, warningId, fieldLabel, stripPattern, allowedDescription) {
    const el = document.getElementById(warningId);
    const before = input.value;
    input.value = before.replace(stripPattern, '');
    if (!el) return;
    if (before !== input.value) {
        el.textContent = fieldLabel + ' can only contain ' + (allowedDescription || 'numbers') + '.';
        el.classList.remove('hidden');
    } else {
        el.classList.add('hidden');
    }
}

// Hide native number-input spinner arrows
(function() {
    const style = document.createElement('style');
    style.textContent = '#qtyInput::-webkit-outer-spin-button,#qtyInput::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}';
    document.head.appendChild(style);
})();

function stepQty(delta) {
    const inp = document.getElementById('qtyInput');
    const val = parseInt(inp.value) || 1;
    inp.value = Math.max(1, val + delta);
    inp.dispatchEvent(new Event('input'));
}

// ── Fixed category ↔ aisle/shelf mapping ─────────────────────────────────
// Each category is stored in a specific physical location.
// Changing the category auto-fills aisle+shelf; changing aisle+shelf auto-fills category.
const LOCATION_MAP = {
    // Junior High School
    'Mathematics':              { aisle: 'A', shelf: '1' },
    'Science':                  { aisle: 'A', shelf: '2' },
    'English':                  { aisle: 'A', shelf: '3' },
    'Filipino':                 { aisle: 'A', shelf: '4' },
    'Araling Panlipunan':       { aisle: 'A', shelf: '5' },
    'MAPEH':                    { aisle: 'A', shelf: '6' },
    'TLE':                      { aisle: 'B', shelf: '1' },
    'EsP':                      { aisle: 'B', shelf: '2' },
    'Mother Tongue':            { aisle: 'B', shelf: '3' },
    'Research':                 { aisle: 'B', shelf: '4' },
    // Senior High School
    'General Mathematics':           { aisle: 'C', shelf: '1' },
    'Statistics & Probability':      { aisle: 'C', shelf: '2' },
    'Earth and Life Science':        { aisle: 'C', shelf: '3' },
    'Physical Science':              { aisle: 'C', shelf: '4' },
    'Reading and Writing':           { aisle: 'C', shelf: '5' },
    '21st Century Literature':       { aisle: 'C', shelf: '6' },
    'Oral Communication':            { aisle: 'D', shelf: '1' },
    'Media and Information Literacy':{ aisle: 'D', shelf: '2' },
    'Personal Development':          { aisle: 'D', shelf: '3' },
    'Understanding Culture & Society':{ aisle: 'D', shelf: '4' },
    'Introduction to Philosophy':    { aisle: 'D', shelf: '5' },
    'Komunikasyon at Pananaliksik':  { aisle: 'D', shelf: '6' },
    'Practical Research':            { aisle: 'E', shelf: '1' },
    'Entrepreneurship':              { aisle: 'E', shelf: '2' },
    'Work Immersion':                { aisle: 'E', shelf: '3' },
    // Tertiary / College
    'Computer Science & IT':         { aisle: 'F', shelf: '1' },
    'Information Technology':        { aisle: 'F', shelf: '2' },
    'Programming & Software Dev.':   { aisle: 'F', shelf: '3' },
    'Computer Engineering':          { aisle: 'F', shelf: '4' },
    'Engineering':                   { aisle: 'F', shelf: '5' },
    'Business Administration':       { aisle: 'F', shelf: '6' },
    'Accounting & Finance':          { aisle: 'G', shelf: '1' },
    'Marketing':                     { aisle: 'G', shelf: '2' },
    'Tourism Management':            { aisle: 'G', shelf: '3' },
    'Hospitality Management':        { aisle: 'G', shelf: '4' },
    'Culinary Arts':                 { aisle: 'G', shelf: '5' },
    'Psychology':                    { aisle: 'G', shelf: '6' },
    'Communication':                 { aisle: 'H', shelf: '1' },
    'Education':                     { aisle: 'H', shelf: '2' },
    'Social Sciences':               { aisle: 'H', shelf: '3' },
    'Natural Science':               { aisle: 'H', shelf: '4' },
    'Law':                           { aisle: 'H', shelf: '5' },
    'Criminology':                   { aisle: 'H', shelf: '6' },
    'Reference':                     { aisle: 'I', shelf: '1' },
    'General':                       { aisle: 'I', shelf: '2' },
};

// Reverse map: "A-1" → "Mathematics"
const REVERSE_MAP = {};
Object.entries(LOCATION_MAP).forEach(([cat, loc]) => {
    REVERSE_MAP[loc.aisle + '-' + loc.shelf] = cat;
});

function onCategoryChange() {
    const cat   = document.getElementById('categorySelect').value;
    const loc   = LOCATION_MAP[cat];
    if (loc) {
        document.getElementById('aisleSelect').value = loc.aisle;
        document.getElementById('shelfSelect').value = loc.shelf;
    }
    syncLocation();
}

function onLocationChange() {
    const aisle = document.getElementById('aisleSelect').value;
    const shelf = document.getElementById('shelfSelect').value;
    if (aisle && shelf) {
        const cat = REVERSE_MAP[aisle + '-' + shelf];
        if (cat) document.getElementById('categorySelect').value = cat;
    }
    syncLocation();
}

function syncLocation() {
    const aisle = document.getElementById('aisleSelect').value;
    const shelf = document.getElementById('shelfSelect').value;
    document.getElementById('aisleLocationHidden').value = (aisle && shelf) ? aisle + '-' + shelf : (aisle || shelf || '');
}

// Keep AvailableQuantity in sync with TotalQuantity on new registration
(function() {
    const totalInput = document.getElementById('qtyInput');
    const availInput = document.getElementById('availableQtyInput');
    if (!totalInput || !availInput) return;
    function sync() { availInput.value = totalInput.value; }
    sync();
    totalInput.addEventListener('input', sync);
})();

function onCoverChosen(input) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];
    const reader = new FileReader();
    reader.onload = function(e) {
        document.getElementById('coverImg').src = e.target.result;
        document.getElementById('coverImg').classList.remove('hidden');
        document.getElementById('coverPlaceholder').classList.add('hidden');
        const nameEl = document.getElementById('coverFileName');
        nameEl.textContent = file.name;
        nameEl.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
}
function closeImportModal() {
    document.getElementById('importModal').classList.add('hidden');
    document.getElementById('selectedFileName').textContent = 'No file selected';
    document.getElementById('excelFileInput').value = '';
}
function submitImport() {
    const input = document.getElementById('excelFileInput');
    if (!input.files.length) { alert('Please select an Excel file first.'); return; }
    document.getElementById('importForm').submit();
}
function handleDrop(e) {
    e.preventDefault();
    document.getElementById('dropZone').classList.remove('border-blue-400','bg-blue-50');
    const file = e.dataTransfer.files[0];
    if (!file) return;
    const dt = new DataTransfer();
    dt.items.add(file);
    const input = document.getElementById('excelFileInput');
    input.files = dt.files;
    document.getElementById('selectedFileName').textContent = file.name;
}

</script>
}


